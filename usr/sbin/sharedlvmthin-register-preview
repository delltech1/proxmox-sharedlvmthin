#!/usr/bin/python3
"""Discover a dedicated Thick VG and print a registration plan; no writes."""
import argparse
import importlib.util
import json
import os
import pathlib
import sys

LIB = pathlib.Path('/usr/libexec/pve-sharedlvmthin')


def load(name, filename):
    spec = importlib.util.spec_from_file_location(name, LIB / filename)
    if spec is None or spec.loader is None:
        raise RuntimeError('registration helper is unavailable')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def build_plan(observed, vg_name, eager_id, lazy_id, reserve, planner, collected, *, resume_existing=None):
    if not isinstance(observed, dict) or observed.get('result') != 'OBSERVED':
        raise ValueError('cluster discovery did not complete')
    if not isinstance(observed.get('candidates'), list) or any(not isinstance(c, dict) for c in observed['candidates']):
        raise ValueError('cluster candidate list invalid')
    candidates = [c for c in observed['candidates'] if c.get('name') == vg_name and
                  (resume_existing is not None or c.get('eligible_for_new_vg_registration') is True)]
    if len(candidates) != 1:
        raise ValueError('VG is not uniquely eligible; existing or unverified LVs need review')
    c = candidates[0]
    if resume_existing is not None and (not isinstance(c.get('existing_aliases'), list)
            or len(c['existing_aliases']) != 1 or not isinstance(c['existing_aliases'][0], dict)
            or c['existing_aliases'][0].get('id') != resume_existing):
        raise ValueError('exactly one matching existing alias is required')
    if c.get('empty_on_all_nodes') is not True or c.get('canonical_mapper_on_all_nodes') is not True:
        raise ValueError('VG emptiness or canonical mapper not proven')
    nodes = observed['nodes']
    aliases = {}
    if eager_id:
        aliases['eager'] = eager_id
    if lazy_id:
        aliases['lazy'] = lazy_id
    identity = {key: c[key] for key in ('vg_uuid', 'pv_uuid', 'wwid', 'size_bytes')}
    if not isinstance(collected, dict):
        raise ValueError('collected peer evidence missing')
    before, after = collected.get('members_before'), collected.get('members_after')
    if not isinstance(before, dict) or before != after or set(before) != set(nodes):
        raise ValueError('cluster membership evidence inconsistent')
    if not collected.get('config_before') or collected.get('config_before') != collected.get('config_after'):
        raise ValueError('storage configuration evidence inconsistent')
    pairs = {(source, target) for source in nodes for target in nodes if source != target}
    if collected.get('peer_pairs') != pairs:
        raise ValueError('peer SSH coverage incomplete')
    raw = collected.get('observations')
    if not isinstance(raw, dict) or set(raw) != set(nodes):
        raise ValueError('per-node observations missing')
    peers = {}
    for node in nodes:
        observation = raw[node]
        if not isinstance(observation, dict) or observation.get('result') != 'OBSERVED' or not isinstance(observation.get('candidates'), list):
            raise ValueError('node observation incomplete')
        matches = [row for row in observation['candidates'] if isinstance(row, dict) and row.get('name') == vg_name]
        if len(matches) != 1:
            raise ValueError('node VG observation not unique')
        row = matches[0]
        if type(row.get('pv_count')) is not int or row['pv_count'] != 1 or row.get('empty_vg') is not True or row.get('canonical_mapper_present') is not True:
            raise ValueError('node VG is not an empty single-PV canonical mapper')
        if any(row.get(key) != identity[key] for key in identity):
            raise ValueError('node VG identity mismatch')
        peers[node] = {key: row[key] for key in identity}
        peers[node].update(complete=True, peer_ssh_verified=True,
                           mapper_verified=row['canonical_mapper_present'], healthy_paths=row.get('healthy_paths'),
                           empty_vg=row.get('empty_vg'))
    vg = {**identity, 'name': vg_name, 'pv_count': 1, 'dedicated': True,
          'empty_on_all_nodes': c['empty_on_all_nodes'],
          'free_bytes': c['free_bytes']}
    evidence = {'quorate': True, 'inventory_complete': True, 'members': {n: True for n in nodes},
                'vg': vg, 'node_evidence': peers,
                'storage_definitions': observed['storage_definitions']}
    if resume_existing is not None:
        if len(aliases) != 1:
            raise ValueError('exactly one missing ID must be requested')
        parsed = collected.get('pve_parsed_config')
        if not isinstance(parsed, list) or any(not isinstance(row, dict) for row in parsed):
            raise ValueError('PVE parsed configuration is unavailable')
        definitions = observed['storage_definitions']
        parsed_ids = [row.get('storage') for row in parsed]
        if any(not isinstance(sid, str) for sid in parsed_ids) or len(set(parsed_ids)) != len(parsed_ids) \
                or set(parsed_ids) != {row.get('id') for row in definitions}:
            raise ValueError('PVE parser and storage API differ in definition coverage')
        parsed_by_id = {row['storage']: row for row in parsed}
        for definition in definitions:
            original = parsed_by_id[definition['id']]
            if original.get('type') != definition.get('type'):
                raise ValueError('PVE parser and storage API disagree on type')
            kind = original.get('type')
            if kind in ('sharedlvmthin', 'lvm', 'lvmthin'):
                parsed_vg = original.get('slt-vgname') if kind == 'sharedlvmthin' else original.get('vgname')
                if parsed_vg != definition.get('vg_name'):
                    raise ValueError('PVE parser and storage API disagree on VG')
        rows = [row for row in parsed if row.get('storage') == resume_existing]
        if len(rows) != 1:
            raise ValueError('PVE parsed alias is missing or ambiguous')
        config = normalize_pve_config(rows[0])
        evidence['config_snapshot_complete'] = True
        result = planner.resume_plan({'nodes': nodes, 'vg': vg_name,
                                      'missing_id': next(iter(aliases.values()))}, evidence, config)
        if result['missing_mode'] not in aliases:
            raise ValueError('requested mode is not the missing alias mode')
        return result
    return planner.plan({'nodes': nodes, 'vg': vg_name, 'aliases': aliases,
                         'reserve_percent': reserve}, evidence)


def normalize_pve_config(row):
    """Normalize only PVE parser's documented scalar/node/content shapes."""
    if not isinstance(row, dict):
        raise ValueError('PVE parsed alias is invalid')
    output = dict(row)
    for key in ('nodes', 'content'):
        value = output.get(key)
        if isinstance(value, dict):
            if not value or any(not isinstance(k, str) or v not in (1, '1', True) for k, v in value.items()):
                raise ValueError('PVE ' + key + ' is ambiguous')
            output[key] = ','.join(sorted(value))
        elif isinstance(value, list):
            if not value or any(not isinstance(v, str) for v in value) or len(value) != len(set(value)):
                raise ValueError('PVE ' + key + ' is ambiguous')
            output[key] = ','.join(sorted(value))
        elif not isinstance(value, str):
            raise ValueError('explicit PVE ' + key + ' is required')
    return output


def require_unchanged_selection(before, after, vg_name):
    """Reject changed choices after input; a name alone is not identity."""
    if not isinstance(before, dict) or not isinstance(after, dict):
        raise ValueError('cluster discovery unavailable')
    if before.get('result') != 'OBSERVED' or after.get('result') != 'OBSERVED':
        raise ValueError('cluster discovery incomplete')
    if before.get('nodes') != after.get('nodes') or before.get('storage_definitions') != after.get('storage_definitions'):
        raise ValueError('cluster membership or storage definitions changed; rerun discovery')
    def selected(report):
        candidates = report.get('candidates')
        if not isinstance(candidates, list):
            raise ValueError('cluster candidates unavailable')
        matches = [c for c in candidates if isinstance(c, dict) and c.get('name') == vg_name]
        if len(matches) != 1:
            raise ValueError('VG is not uniquely visible; rerun discovery')
        return matches[0]
    old, new = selected(before), selected(after)
    keys = ('vg_uuid', 'pv_uuid', 'wwid', 'size_bytes', 'paths_by_node',
            'transport_by_node', 'empty_on_all_nodes', 'canonical_mapper_on_all_nodes',
            'eligible_for_new_vg_registration', 'existing_aliases')
    if any(key not in old or key not in new or old[key] != new[key] for key in keys):
        raise ValueError('VG identity or eligibility changed; rerun discovery')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--vg', help='dedicated VG name (prompts if omitted)')
    parser.add_argument('--mode', choices=('eager', 'lazy', 'both'), default='both')
    parser.add_argument('--eager-id', default='bastrix-eager')
    parser.add_argument('--lazy-id', default='bastrix-lazy')
    parser.add_argument('--reserve-percent', type=int, default=0)
    parser.add_argument('--discover-only', action='store_true', help='print read-only inventory as JSON')
    parser.add_argument('--resume-existing', help='existing Thick alias to review after partial registration')
    parser.add_argument('--missing-id', help='new storage ID to propose for the missing mode')
    args = parser.parse_args()
    if bool(args.resume_existing) != bool(args.missing_id) or \
            (args.resume_existing and (not args.vg or args.discover_only)):
        parser.error('--resume-existing and --missing-id require --vg and cannot be used with --discover-only')
    if os.geteuid() != 0:
        parser.exit(1, 'Run as root on a participating Proxmox VE node.\n')
    try:
        inventory = load('registration_inventory', 'sharedlvmthin-registration-cluster-inventory.py')
        planner = load('registration_plan', 'sharedlvmthin-registration-plan.py')
        observed, initial_evidence = (inventory.collect_evidence(include_full_config=True)
                                      if args.resume_existing else inventory.collect_evidence())
        if args.discover_only:
            print(json.dumps(observed, sort_keys=True, indent=2))
            return 0
        if args.resume_existing:
            inventory.validate_evidence(observed, initial_evidence)
            refreshed, collected = inventory.collect_evidence(include_full_config=True)
            inventory.validate_evidence(refreshed, collected)
            if initial_evidence.get('config_before') != collected.get('config_before') or \
                    initial_evidence.get('members_before') != collected.get('members_before') or \
                    initial_evidence.get('pve_parsed_config') != collected.get('pve_parsed_config'):
                raise ValueError('PVE configuration or membership changed; rerun discovery')
            require_unchanged_selection(observed, refreshed, args.vg)
            parsed = collected.get('pve_parsed_config')
            matches = [row for row in parsed if isinstance(row, dict) and row.get('storage') == args.resume_existing] \
                if isinstance(parsed, list) else []
            if len(matches) != 1:
                raise ValueError('existing PVE alias is unavailable or ambiguous')
            mode = matches[0].get('slt-allocation-mode')
            eager = args.missing_id if mode == 'thick-generations-lazy' else None
            lazy = args.missing_id if mode == 'thick-generations' else None
            result = build_plan(refreshed, args.vg, eager, lazy, 0, planner, collected,
                                resume_existing=args.resume_existing)
            print('PREVIEW ONLY: no storage was registered or modified.')
            print(result['warning'])
            print(result['cli'])
            return 0
        eligible = [c for c in observed['candidates'] if c['eligible_for_new_vg_registration']]
        if not eligible:
            raise ValueError('no empty, unregistered shared Thick VG passed all checks')
        print('Initial observations on participating nodes (not fencing; will be refreshed):')
        for c in eligible:
            print('  {}: {} GiB free, {} healthy paths per node'.format(
                c['name'], round(c['free_bytes'] / (1024 ** 3), 2), c['paths_by_node']))
        selected = args.vg
        if selected is None:
            if len(eligible) == 1:
                selected = eligible[0]['name']
                print('Selected the only eligible VG: ' + selected)
            else:
                selected = input('Enter one of the displayed VG names: ').strip()
        # An operator may spend an arbitrary amount of time at the prompt.
        refreshed, collected = inventory.collect_evidence()
        inventory.validate_evidence(refreshed, collected)
        if (initial_evidence.get('members_before') != collected.get('members_before') or
                initial_evidence.get('config_before') != collected.get('config_before')):
            raise ValueError('cluster membership or storage configuration changed; rerun discovery')
        require_unchanged_selection(observed, refreshed, selected)
        fresh_candidate = next(c for c in refreshed['candidates'] if c.get('name') == selected)
        print('Refreshed free capacity: {} GiB (read-only point-in-time observation).'.format(
            round(fresh_candidate['free_bytes'] / (1024 ** 3), 2)))
        result = build_plan(refreshed, selected,
                            args.eager_id if args.mode in ('eager', 'both') else None,
                            args.lazy_id if args.mode in ('lazy', 'both') else None,
                            args.reserve_percent, planner, collected)
        print('\nPREVIEW ONLY. No storage was registered or modified.')
        print('Reserve: {}% of VG capacity. Snapshot/rollback may need additional free space.'.format(args.reserve_percent))
        if args.reserve_percent == 0:
            print('WARNING: zero protected reserve permits consuming all free VG extents; future snapshot, rollback or growth may be refused.')
        print('A single path is not redundant. Verify quorum, fencing and vendor policy independently.')
        print('Observation and command generation do not guarantee VG identity or emptiness at execution time.')
        print('Before each command, recheck the VG identity and state on every node, including whether it is empty and existing storage definitions.')
        print('Eager and Lazy registrations are not atomic; the first can succeed even if the second fails.')
        print('Review the identities, node list, reserve and commands below before running them as root:')
        for entry in result['definitions']:
            print('\n' + entry['cli'])
        print('\nIf registration partially succeeds or returns an unclear result, inspect it; do not retry blindly.')
        return 0
    except (ValueError, OSError, KeyError, ImportError, RuntimeError) as exc:
        print('REFUSED: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
