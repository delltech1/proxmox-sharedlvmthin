#!/bin/bash
# Copyright (C) 2026 BASTRIX Project Contributors
# SPDX-License-Identifier: GPL-3.0-only

# Safe live-migration bridge for per-VM dm-thin pools.  Cross-node movement
# occurs only after every managed disk has been pivoted by PVE's supported
# Storage Move path onto an independent Thick Generations linear LV.
set -Eeuo pipefail
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

usage() {
    echo "Usage: sharedlvmthin-migrate-bridge <preflight|run> <vmid> <target-node> <thin-storage> <thick-storage> [--keep-thick]" >&2
    echo "       sharedlvmthin-migrate-bridge inspect <vmid>" >&2
    echo "       sharedlvmthin-migrate-bridge plan <vmid>" >&2
    echo "       sharedlvmthin-migrate-bridge resume <vmid>" >&2
    exit 64
}

# Inspection is intentionally outside the per-VM mutation lock. It reads one
# root-owned mode-0600 state file and must remain observable while the writer
# holds the lock for a multi-hour copy.
if [ "${1:-}" = inspect ]; then
    [ "$#" -eq 2 ] || usage
    inspect_vmid=$2
    [[ $inspect_vmid =~ ^[1-9][0-9]{2,8}$ ]] || usage
    inspect_dir=/var/lib/pve-sharedlvmthin/migration-bridge
    latest=$(find "$inspect_dir" -maxdepth 1 -type f -name "$inspect_vmid-*.state" \
        -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk 'NR == 1 {print $2}')
    [ -n "$latest" ] || { echo "BRIDGE_STATE=ABSENT"; exit 2; }
    [ "$(stat -c %u "$latest")" -eq 0 ] || { echo "untrusted bridge state owner" >&2; exit 70; }
    mode=$(stat -c %a "$latest")
    [ "$mode" = 600 ] || { echo "untrusted bridge state mode: $mode" >&2; exit 70; }
    inspect_value() {
        local key=$1
        awk -F= -v key="$key" '
            $1 == key {print substr($0, index($0, "=") + 1); n++}
            END {if (n != 1) exit 1}
        ' "$latest"
    }
    inspect_started=$(inspect_value started_at) \
        || { echo "bridge state has no unique started_at" >&2; exit 70; }
    inspect_updated=$(inspect_value updated_at) \
        || { echo "bridge state has no unique updated_at" >&2; exit 70; }
    [[ $inspect_started =~ ^[0-9]+$ && $inspect_updated =~ ^[0-9]+$ \
        && $inspect_updated -ge $inspect_started ]] \
        || { echo "bridge state timestamps are invalid" >&2; exit 70; }
    inspect_now=$(date +%s)
    [ "$inspect_now" -ge "$inspect_updated" ] \
        || { echo "bridge state updated_at is in the future" >&2; exit 70; }
    awk -F= '
        $1 ~ /^(version|tx|vmid|source_node|target_node|thin_storage|thick_storage|return_thin|phase|disk_count|completed_disks|current_disk|progress_percent|total_bytes|started_at|updated_at|config_sha256|disk_manifest_sha256)$/ {
            print toupper($1) "=" substr($0, index($0, "=") + 1)
        }
    ' "$latest"
    inspect_age=$((inspect_now - inspect_updated))
    inspect_fresh=NO
    [ "$inspect_age" -le 90 ] && inspect_fresh=YES
    printf 'OBSERVED_AT=%s\nELAPSED_SECONDS=%s\nPROGRESS_AGE_SECONDS=%s\nPROGRESS_UPDATE_FRESH=%s\n' \
        "$inspect_now" "$((inspect_now - inspect_started))" "$inspect_age" "$inspect_fresh"
    printf 'STATE_FILE=%s\n' "$latest"
    exit 0
fi

if [ "${1:-}" != --locked ]; then
    [ "$#" -ge 2 ] || usage
    lock_vmid=$2
    [[ $lock_vmid =~ ^[1-9][0-9]{2,8}$ ]] || usage
    exec flock -n -o "/run/lock/sharedlvmthin-bridge-$lock_vmid.lock" \
        "$0" --locked "$@"
fi
shift

# Resume is deliberately evidence-scoped. The first supported recovery point
# is a completed return-to-Thin copy whose final health check or state publish
# was interrupted. Earlier/mixed phases remain fail-closed; they are not
# guessed into completion.
if [[ ${1:-} =~ ^(plan|resume)$ ]]; then
    [ "$#" -eq 2 ] || usage
    bridge_action=$1
    resume_vmid=$2
    [[ $resume_vmid =~ ^[1-9][0-9]{2,8}$ ]] || usage
    resume_dir=/var/lib/pve-sharedlvmthin/migration-bridge
    resume_file=$(find "$resume_dir" -maxdepth 1 -type f -name "$resume_vmid-*.state" \
        -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk 'NR == 1 {print $2}')
    [ -n "$resume_file" ] || { echo "no bridge state for VM $resume_vmid" >&2; exit 2; }
    [ "$(stat -c %u "$resume_file")" -eq 0 ] && [ "$(stat -c %a "$resume_file")" = 600 ] \
        || { echo "untrusted bridge state" >&2; exit 70; }
    state_value() {
        local key=$1
        awk -F= -v key="$key" '$1 == key {print substr($0, index($0, "=") + 1); n++} END {if (n != 1) exit 1}' "$resume_file"
    }
    version=$(state_value version); tx=$(state_value tx); vmid=$(state_value vmid)
    source_node=$(state_value source_node); target=$(state_value target_node)
    thin_store=$(state_value thin_storage); thick_store=$(state_value thick_storage)
    return_thin=$(state_value return_thin); phase=$(state_value phase)
    disk_count=$(state_value disk_count); completed_disks=$(state_value completed_disks)
    total_bytes=$(state_value total_bytes)
    [[ $version =~ ^(2|3)$ && $tx =~ ^[0-9a-f]{32}$ && $vmid = "$resume_vmid" ]] \
        || { echo "invalid bridge state identity" >&2; exit 70; }
    [[ $source_node = "$(hostname)" && $target =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ \
        && $thin_store =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ \
        && $thick_store =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] \
        || { echo "bridge state node/storage identity mismatch" >&2; exit 70; }
    [[ $return_thin =~ ^[01]$ && $disk_count =~ ^[1-9][0-9]*$ \
        && $completed_disks =~ ^[0-9]+$ ]] \
        || { echo "invalid bridge policy or disk counters" >&2; exit 70; }
    if [ "$version" = 3 ]; then
        manifest_digest=$(state_value disk_manifest_sha256)
        manifest_file="$resume_dir/$vmid-$tx.manifest"
        [[ $manifest_digest =~ ^[0-9a-f]{64}$ ]] \
            || { echo "invalid disk manifest digest" >&2; exit 70; }
        [ -f "$manifest_file" ] && [ "$(stat -c %u "$manifest_file")" -eq 0 ] \
            && [ "$(stat -c %a "$manifest_file")" = 600 ] \
            || { echo "trusted disk manifest is unavailable" >&2; exit 70; }
        [ "$(sha256sum "$manifest_file" | cut -d' ' -f1)" = "$manifest_digest" ] \
            || { echo "disk manifest digest mismatch" >&2; exit 70; }
        [ "$(wc -l <"$manifest_file")" -eq "$disk_count" ] \
            || { echo "disk manifest count mismatch" >&2; exit 70; }
    fi
    member_ip=$(perl -MPVE::Cluster -e '
        PVE::Cluster::cfs_update(); my ($node) = @ARGV;
        my $m = PVE::Cluster::get_members()->{$node} // die "unknown target\n";
        die "offline target\n" if !$m->{online}; print $m->{ip};
    ' "$target")
    ssh_stream_base=(/usr/bin/ssh -e none -o BatchMode=yes -o "HostKeyAlias=$target" \
        -o "UserKnownHostsFile=/etc/pve/nodes/$target/ssh_known_hosts" \
        -o GlobalKnownHostsFile=none "root@$member_ip")
    # Ordinary remote probes must never inherit the manifest loop's stdin.
    # Only the explicit QMP evidence pipeline uses ssh_stream_base.
    ssh_base=(/usr/bin/ssh -n -e none -o BatchMode=yes -o "HostKeyAlias=$target" \
        -o "UserKnownHostsFile=/etc/pve/nodes/$target/ssh_known_hosts" \
        -o GlobalKnownHostsFile=none "root@$member_ip")
    observed_owner=$(
        pvesh get /cluster/resources --type vm --output-format json \
        | python3 -c 'import json,sys
vmid=int(sys.argv[1]); rows=[r for r in json.load(sys.stdin) if r.get("vmid")==vmid]
if len(rows)!=1 or rows[0].get("status")!="running": raise SystemExit(70)
print(rows[0].get("node", ""))' "$vmid"
    )
    if [ "$observed_owner" = "$source_node" ]; then
        authority=source
        authoritative_cfg=$(qm config "$vmid")
    elif [ "$observed_owner" = "$target" ]; then
        authority=target
        authoritative_cfg=$("${ssh_base[@]}" -- qm config "$vmid")
    else
        echo "authoritative VM node is neither saved source nor target" >&2
        exit 70
    fi
    if [ "$version" = 3 ]; then
        cmp -s \
            <(cut -d'|' -f1 "$manifest_file" | sort) \
            <(printf '%s\n' "$authoritative_cfg" | awk '
                /^(ide|sata|scsi|virtio)[0-9]+:/ && $0 !~ /media=cdrom/ {
                    key=$1; sub(/:$/, "", key); print key
                }
            ' | sort) \
            || { echo "authoritative disk slots do not match saved manifest" >&2; exit 70; }
    fi
    # pmxcfs may be updated before QEMU completes (or rolls back) an online
    # block job.  Recovery therefore requires the live QMP block graph to
    # agree with every configured disk path; process argv and config alone are
    # not authoritative.  A mismatch is deliberately manual recovery only.
    runtime_expectations=
    while IFS='|' read -r slot original bytes; do
        current_vol=$(printf '%s\n' "$authoritative_cfg" | awk -v slot="$slot" '
            $1 == slot ":" {vol=$2; sub(/,.*/, "", vol); print vol; found=1}
            END {if (!found) exit 1}
        ')
        if [ "$authority" = source ]; then
            current_path=$(pvesm path "$current_vol")
        else
            current_path=$("${ssh_base[@]}" -- pvesm path "$current_vol")
        fi
        [[ $current_path = /dev/* ]] \
            || { echo "configured disk path is not a block device path" >&2; exit 70; }
        runtime_expectations+="$slot|$current_path"$'\n'
    done <"$manifest_file"
    if [ "$authority" = source ]; then
        if ! runtime_evidence=$(printf '%s' "$runtime_expectations" \
            | /usr/libexec/pve-sharedlvmthin/sharedlvmthin-qmp-path-check "$vmid"); then
            printf '%s\n' "$runtime_evidence" >&2
            echo "RUNTIME_CONFIG_DIVERGENCE: refusing automatic recovery" >&2
            exit 70
        fi
    else
        if ! runtime_evidence=$(printf '%s' "$runtime_expectations" \
            | "${ssh_stream_base[@]}" -- /usr/libexec/pve-sharedlvmthin/sharedlvmthin-qmp-path-check "$vmid"); then
            printf '%s\n' "$runtime_evidence" >&2
            echo "RUNTIME_CONFIG_DIVERGENCE: refusing automatic recovery" >&2
            exit 70
        fi
    fi
    grep -qx 'RUNTIME_PATHS=PASS' <<<"$runtime_evidence" \
        || { echo "runtime path proof is incomplete" >&2; exit 70; }
    read -r observed_disks observed_thin observed_thick < <(
        printf '%s\n' "$authoritative_cfg" | awk -v thin="$thin_store" -v thick="$thick_store" '
            /^(ide|sata|scsi|virtio)[0-9]+:/ && $0 !~ /media=cdrom/ {
                n++; if ($2 ~ ("^" thin ":")) t++; if ($2 ~ ("^" thick ":")) k++
            }
            END {print n+0, t+0, k+0}
        '
    )
    admission_output=$(
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
            inspect "$thin_store" "$tx" "$source_node"
    )
    if grep -qx 'BRIDGE_ADMISSION_ACTIVE=NO' <<<"$admission_output"; then
        admission=none
    elif grep -qx 'BRIDGE_ADMISSION_ACTIVE=YES' <<<"$admission_output" \
        && grep -qx "BRIDGE_ADMISSION_TX=$tx" <<<"$admission_output" \
        && grep -qx "BRIDGE_ADMISSION_NODE=$source_node" <<<"$admission_output"; then
        admission=exact
    else
        admission=foreign
    fi
    recovery_plan=$(
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-plan \
            "$phase" "$authority" "$return_thin" "$disk_count" "$observed_thin" \
            "$observed_thick" "$admission"
    )
    if [ "$bridge_action" = plan ]; then
        printf 'BRIDGE_PLAN=PASS\nTX=%s\nPHASE=%s\nAUTHORITY=%s\n' \
            "$tx" "$phase" "$authority"
        printf 'DISKS=%s\nTHIN_DISKS=%s\nTHICK_DISKS=%s\nADMISSION=%s\n' \
            "$observed_disks" "$observed_thin" "$observed_thick" "$admission"
        printf '%s\n' "$recovery_plan"
        exit 0
    fi
    resume_publish_state() {
        local new_phase=$1 new_completed=$2 new_current=$3 new_progress=$4
        local tmp="$resume_file.tmp.$$" now digest candidate
        local -a config_paths=()
        now=$(date +%s)
        for candidate in /etc/pve/nodes/*/qemu-server/"$vmid".conf; do
            [ -f "$candidate" ] && config_paths+=("$candidate")
        done
        [ "${#config_paths[@]}" -eq 1 ] \
            || { echo "cannot prove one authoritative VM configuration while publishing recovery state" >&2; return 70; }
        digest=$(sha256sum "${config_paths[0]}" | cut -d' ' -f1)
        awk -F= -v phase="$new_phase" -v completed="$new_completed" \
            -v current="$new_current" -v progress="$new_progress" \
            -v now="$now" -v digest="$digest" '
            $1 == "phase" {print "phase=" phase; next}
            $1 == "completed_disks" {print "completed_disks=" completed; next}
            $1 == "current_disk" {print "current_disk=" current; next}
            $1 == "progress_percent" {print "progress_percent=" progress; next}
            $1 == "updated_at" {print "updated_at=" now; next}
            $1 == "config_sha256" {print "config_sha256=" digest; next}
            {print}
        ' "$resume_file" >"$tmp"
        chmod 0600 "$tmp"; chown root:root "$tmp"; sync -f "$tmp"
        mv -f "$tmp" "$resume_file"; sync -f "$resume_dir"
    }
    resume_progress_move() {
        local slot=$1 destination=$2 completed=$3 execution_node=${4:-local}
        local line observed now last_persist=0 rc
        resume_publish_state MATERIALIZING "$completed" "$slot" 0
        set +e
        if [ "$execution_node" = local ]; then
            qm disk move "$vmid" "$slot" "$destination" --delete 1 2>&1
        else
            "${ssh_base[@]}" -- qm disk move "$vmid" "$slot" "$destination" --delete 1 2>&1
        fi \
        | while IFS= read -r line; do
            printf '%s\n' "$line"
            if [[ $line =~ \(([0-9]+([.][0-9]+)?)%\) ]]; then
                observed=${BASH_REMATCH[1]}; now=$(date +%s)
                if [ $((now - last_persist)) -ge 30 ]; then
                    resume_publish_state MATERIALIZING "$completed" "$slot" "$observed"
                    last_persist=$now
                fi
            fi
        done
        rc=${PIPESTATUS[0]}
        set -e
        [ "$rc" -eq 0 ] || {
            resume_publish_state MOVE_FAILED "$completed" "$slot" 0
        return "$rc"
        }
    }
    if grep -qx 'RECOVERY_PLAN=CONTINUE_MATERIALIZE' <<<"$recovery_plan"; then
        [ "$version" = 3 ] && [ "$authority" = source ] \
            || { echo "materialization resume requires v3 source evidence" >&2; exit 70; }
        sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
            acquire "$thin_store" "$tx" "$source_node" >/dev/null
        thin_vg=$(awk -v sid="$thin_store" '
            $1 == "sharedlvmthin:" && $2 == sid {inside=1; next}
            /^[^[:space:]]/ {inside=0}
            inside && $1 == "slt-vgname" {print $2; exit}
        ' /etc/pve/storage.cfg)
        reserve_gib=$(awk -v sid="$thick_store" '
            $1 == "sharedlvmthin:" && $2 == sid {inside=1; next}
            /^[^[:space:]]/ {inside=0}
            inside && $1 == "slt-vg-reserve-gib" {print $2; exit}
        ' /etc/pve/storage.cfg); reserve_gib=${reserve_gib:-0}
        [[ $thin_vg =~ ^[A-Za-z0-9+_.-]+$ && $reserve_gib =~ ^[0-9]+$ ]] \
            || { echo "cannot prove resume VG capacity policy" >&2; exit 70; }
        remaining_bytes=0
        while IFS='|' read -r slot original bytes; do
            [[ $slot =~ ^(ide|sata|scsi|virtio)[0-9]+$ \
                && $bytes =~ ^[1-9][0-9]*$ ]] \
                || { echo "invalid disk manifest record" >&2; exit 70; }
            current_vol=$(printf '%s\n' "$authoritative_cfg" | awk -v slot="$slot" '
                $1 == slot ":" {vol=$2; sub(/,.*/, "", vol); print vol; found=1}
                END {if (!found) exit 1}
            ')
            current_store=${current_vol%%:*}
            if [ "$current_store" = "$thin_store" ]; then
                current_path=$(pvesm path "$current_vol")
                [ "$(blockdev --getsize64 "$current_path")" = "$bytes" ] \
                    || { echo "runtime disk size differs from manifest for $slot" >&2; exit 70; }
                remaining_bytes=$((remaining_bytes + bytes))
            elif [ "$current_store" != "$thick_store" ]; then
                echo "runtime disk storage differs from recovery plan for $slot" >&2
                exit 70
            fi
        done <"$manifest_file"
        vg_free=$(vgs --readonly --noheadings --units b --nosuffix -o vg_free "$thin_vg" | tr -d '[:space:]')
        vg_free=${vg_free%.*}
        required_bytes=$((remaining_bytes + reserve_gib * 1024 * 1024 * 1024))
        [[ $vg_free =~ ^[0-9]+$ && $vg_free -ge $required_bytes ]] \
            || { echo "insufficient capacity to resume materialization" >&2; exit 28; }
        completed_now=$observed_thick
        while IFS='|' read -r slot original bytes; do
            current_vol=$(qm config "$vmid" | awk -v slot="$slot" '
                $1 == slot ":" {vol=$2; sub(/,.*/, "", vol); print vol; found=1}
                END {if (!found) exit 1}
            ')
            [ "${current_vol%%:*}" = "$thin_store" ] || continue
            resume_progress_move "$slot" "$thick_store" "$completed_now"
            qm config "$vmid" | grep -Eq "^${slot}: ${thick_store}:"
            completed_now=$((completed_now + 1))
            authoritative_cfg=$(qm config "$vmid")
            resume_publish_state MATERIALIZING "$completed_now" none 100
        done <"$manifest_file"
        [ "$completed_now" -eq "$disk_count" ] \
            || { echo "materialization resume did not complete every disk" >&2; exit 70; }
        sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
            release "$thin_store" "$tx" "$source_node" >/dev/null
        resume_publish_state MATERIALIZED_THICK "$completed_now" none 100
        printf 'BRIDGE_RESUME_STEP=PASS\nTX=%s\nCOMPLETED_ACTION=CONTINUE_MATERIALIZE\nNEXT_ACTION=MIGRATE_THICK\n' "$tx"
        exit 0
    fi
    if grep -qx 'RECOVERY_PLAN=MIGRATE_THICK' <<<"$recovery_plan"; then
        [ "$authority" = source ] && [ "$observed_thick" -eq "$disk_count" ] \
            && [ "$admission" = none ] \
            || { echo "thick migration resume evidence is incomplete" >&2; exit 70; }
        sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        resume_publish_state MATERIALIZED_THICK "$disk_count" none 100
        set +e
        qm migrate "$vmid" "$target" --online 1
        migrate_rc=$?
        set -e
        settled=0
        for _ in $(seq 1 30); do
            observed=$(pvesh get /cluster/resources --type vm --output-format json \
                | python3 -c 'import json,sys
vmid=int(sys.argv[1]); rows=[x for x in json.load(sys.stdin) if x.get("vmid")==vmid]
print((rows[0].get("node", "?")+":"+rows[0].get("status", "?")) if len(rows)==1 else "AMBIGUOUS")' "$vmid")
            [ "$observed" = "$target:running" ] && { settled=1; break; }
            sleep 1
        done
        if [ "$migrate_rc" -ne 0 ] || [ "$settled" -ne 1 ]; then
            resume_publish_state MIGRATION_UNSETTLED "$disk_count" none 100
            echo "migration outcome is not positively proven: rc=$migrate_rc owner=$observed" >&2
            exit 70
        fi
        resume_publish_state MIGRATED_THICK "$disk_count" none 100
        next=FINALIZE_THICK
        [ "$return_thin" -eq 1 ] && next=PREPARE_RETURN_THIN
        printf 'BRIDGE_RESUME_STEP=PASS\nTX=%s\nCOMPLETED_ACTION=MIGRATE_THICK\nNEXT_ACTION=%s\n' "$tx" "$next"
        exit 0
    fi
    if grep -Eqx 'RECOVERY_PLAN=(PREPARE_RETURN_THIN|CONTINUE_RETURN_THIN)' <<<"$recovery_plan"; then
        [ "$authority" = target ] && [ "$return_thin" -eq 1 ] \
            && [ "$admission" = none ] \
            || { echo "return-to-Thin resume evidence is incomplete" >&2; exit 70; }
        [[ $total_bytes =~ ^[1-9][0-9]*$ ]] \
            || { echo "invalid saved aggregate disk size" >&2; exit 70; }
        "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        if grep -qx 'RECOVERY_PLAN=PREPARE_RETURN_THIN' <<<"$recovery_plan"; then
            "${ssh_base[@]}" -- /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-import \
                prepare "$thin_store" "$vmid" "$total_bytes" "$tx"
            resume_publish_state RETURN_THIN_PREPARED "$disk_count" none 0
        fi
        completed_now=$((disk_count + observed_thin))
        while IFS='|' read -r slot original bytes; do
            current_vol=$("${ssh_base[@]}" -- qm config "$vmid" | awk -v slot="$slot" '
                $1 == slot ":" {vol=$2; sub(/,.*/, "", vol); print vol; found=1}
                END {if (!found) exit 1}
            ')
            [ "${current_vol%%:*}" = "$thick_store" ] || continue
            resume_progress_move "$slot" "$thin_store" "$completed_now" remote
            "${ssh_base[@]}" -- qm config "$vmid" | grep -Eq "^${slot}: ${thin_store}:"
            completed_now=$((completed_now + 1))
            resume_publish_state RETURN_THIN_PREPARED "$completed_now" none 100
        done <"$manifest_file"
        [ "$completed_now" -eq $((disk_count * 2)) ] \
            || { echo "return-to-Thin resume did not complete every disk" >&2; exit 70; }
        "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
        resume_publish_state RETURNED_THIN "$completed_now" none 100
        printf 'BRIDGE_RESUME=PASS\nTX=%s\nFINAL_PHASE=RETURNED_THIN\nSTATE_FILE=%s\n' \
            "$tx" "$resume_file"
        exit 0
    fi
    if grep -qx 'RECOVERY_PLAN=FINALIZE_THICK' <<<"$recovery_plan"; then
        [ "$authority" = target ] && [ "$return_thin" -eq 0 ] \
            && [ "$observed_thick" -eq "$disk_count" ] \
            || { echo "keep-Thick completion evidence is incomplete" >&2; exit 70; }
        resume_publish_state COMPLETE_THICK "$disk_count" none 100
        printf 'BRIDGE_RESUME=PASS\nTX=%s\nFINAL_PHASE=COMPLETE_THICK\nSTATE_FILE=%s\n' \
            "$tx" "$resume_file"
        exit 0
    fi
    grep -qx 'RECOVERY_PLAN=FINALIZE_THIN' <<<"$recovery_plan" \
        || { echo "target disk topology is not exactly finalizable Thin" >&2; exit 70; }
    [ "$authority" = target ] && [ "$return_thin" = 1 ] \
        && [ "$completed_disks" -ge $((disk_count * 2)) ] \
        || { echo "return-to-Thin completion evidence is incomplete" >&2; exit 70; }
    "${ssh_base[@]}" -- qm status "$vmid" | grep -qx 'status: running'
    "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
    "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
    remote_digest=$(printf '%s\n' "$authoritative_cfg" | sha256sum | cut -d' ' -f1)
    resume_tmp="$resume_file.tmp.$$"
    now=$(date +%s)
    awk -F= -v now="$now" -v digest="$remote_digest" '
        $1 == "phase" {print "phase=RETURNED_THIN"; next}
        $1 == "updated_at" {print "updated_at=" now; next}
        $1 == "config_sha256" {print "config_sha256=" digest; next}
        {print}
    ' "$resume_file" >"$resume_tmp"
    chmod 0600 "$resume_tmp"; chown root:root "$resume_tmp"; sync -f "$resume_tmp"
    mv -f "$resume_tmp" "$resume_file"; sync -f "$resume_dir"
    printf 'BRIDGE_RESUME=PASS\nTX=%s\nFINAL_PHASE=RETURNED_THIN\nSTATE_FILE=%s\n' \
        "$tx" "$resume_file"
    exit 0
fi

[ "$#" -ge 5 ] || usage
action=$1 vmid=$2 target=$3 thin_store=$4 thick_store=$5
shift 5
return_thin=1
[ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --keep-thick ] || usage; return_thin=0; }
[[ $action =~ ^(preflight|run)$ ]] || usage
[[ $vmid =~ ^[1-9][0-9]{2,8}$ ]] || usage
[[ $target =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || usage
[[ $thin_store =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || usage
[[ $thick_store =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || usage
[ "$thin_store" != "$thick_store" ] || { echo "thin and thick storage IDs must differ" >&2; exit 65; }

local_node=$(hostname)
[ "$target" != "$local_node" ] || { echo "target must differ from local node" >&2; exit 65; }
state_dir=/var/lib/pve-sharedlvmthin/migration-bridge
mkdir -p "$state_dir"

cfg_value() {
    local sid=$1 key=$2
    awk -v sid="$sid" -v key="$key" '
        $1 == "sharedlvmthin:" && $2 == sid { inside=1; next }
        /^[^[:space:]]/ { inside=0 }
        inside && $1 == key { print $2; found=1; exit }
        END { if (!found) exit 1 }
    ' /etc/pve/storage.cfg
}

cfg_optional() {
    cfg_value "$1" "$2" 2>/dev/null || true
}

thin_vg=$(cfg_value "$thin_store" slt-vgname) || { echo "Thin storage is not SharedLvmThin" >&2; exit 65; }
thick_vg=$(cfg_value "$thick_store" slt-vgname) || { echo "Thick storage is not SharedLvmThin" >&2; exit 65; }
[ "$thin_vg" = "$thick_vg" ] || { echo "bridge currently requires same-VG Thin/Thick aliases" >&2; exit 65; }
[ "$(cfg_optional "$thin_store" slt-allocation-mode)" != thick-generations ] || { echo "source alias is not Thin" >&2; exit 65; }
[ "$(cfg_optional "$thick_store" slt-allocation-mode)" = thick-generations ] || { echo "target alias is not Thick Generations" >&2; exit 65; }

status=$(qm status "$vmid" | awk '{print $2}')
[ "$status" = running ] || { echo "bridge run requires a running VM; use native offline migration for a stopped VM" >&2; exit 65; }

mapfile -t disks < <(
    qm config "$vmid" | awk -v sid="$thin_store" '
        /^(ide|sata|scsi|virtio)[0-9]+:/ {
            key=$1; sub(/:$/, "", key)
            vol=$2; sub(/,.*/, "", vol)
            split(vol, a, ":")
            if (a[1] == sid) print key "|" vol
        }
    '
)
[ "${#disks[@]}" -gt 0 ] || { echo "VM has no disk on source Thin storage" >&2; exit 65; }

# Version 1 deliberately refuses mixed layouts.  This prevents a successful
# bridge from being followed by a native migration failure caused by an
# unrelated local-only disk.
all_disk_count=$(qm config "$vmid" | awk '/^(ide|sata|scsi|virtio)[0-9]+:/ && $0 !~ /media=cdrom/ {n++} END {print n+0}')
[ "$all_disk_count" -eq "${#disks[@]}" ] || {
    echo "bridge v1 requires every non-CD disk to reside on '$thin_store'" >&2
    exit 65
}

sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
pvecm status | grep -Eq '^Quorate:[[:space:]]+Yes$'
perl -MPVE::Cluster -e '
    PVE::Cluster::cfs_update();
    my ($node) = @ARGV;
    my $m = PVE::Cluster::get_members()->{$node} // die "unknown target\n";
    die "offline target\n" if !$m->{online};
' "$target"

total_bytes=0
for entry in "${disks[@]}"; do
    vol=${entry#*|}
    path=$(pvesm path "$vol")
    bytes=$(blockdev --getsize64 "$path")
    [[ $bytes =~ ^[1-9][0-9]*$ ]] || { echo "cannot determine exact disk size for $vol" >&2; exit 70; }
    total_bytes=$((total_bytes + bytes))
done
vg_free=$(vgs --readonly --noheadings --units b --nosuffix -o vg_free "$thin_vg" | tr -d '[:space:]')
[[ $vg_free =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "cannot determine VG free capacity" >&2; exit 70; }
vg_free=${vg_free%.*}
reserve_gib=$(cfg_optional "$thick_store" slt-vg-reserve-gib); reserve_gib=${reserve_gib:-0}
reserve_bytes=$((reserve_gib * 1024 * 1024 * 1024))
required_bytes=$((total_bytes + reserve_bytes))
[ "$vg_free" -ge "$required_bytes" ] || {
    echo "insufficient physical VG capacity: free=$vg_free required=$required_bytes" >&2
    exit 28
}

printf 'PREFLIGHT=PASS\nVMID=%s\nSOURCE_NODE=%s\nTARGET_NODE=%s\nDISKS=%s\nREQUIRED_BYTES=%s\nVG_FREE_BYTES=%s\n' \
    "$vmid" "$local_node" "$target" "${#disks[@]}" "$required_bytes" "$vg_free"
[ "$action" = run ] || exit 0

tx=$(printf '%s' "$vmid:$local_node:$target:$(date +%s%N):$$" | sha256sum | cut -c1-32)
state_file="$state_dir/$vmid-$tx.state"
manifest_file="$state_dir/$vmid-$tx.manifest"
manifest_tmp="$manifest_file.tmp.$$"
umask 077
: >"$manifest_tmp"
for entry in "${disks[@]}"; do
    disk=${entry%%|*}
    vol=${entry#*|}
    path=$(pvesm path "$vol")
    bytes=$(blockdev --getsize64 "$path")
    [[ $disk =~ ^(ide|sata|scsi|virtio)[0-9]+$ \
        && $vol =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*:vm-[0-9]+-disk-[0-9]+$ \
        && $bytes =~ ^[1-9][0-9]*$ ]] \
        || { echo "cannot persist canonical disk manifest" >&2; exit 70; }
    printf '%s|%s|%s\n' "$disk" "$vol" "$bytes" >>"$manifest_tmp"
done
sync -f "$manifest_tmp"
mv -f "$manifest_tmp" "$manifest_file"
sync -f "$state_dir"
disk_manifest_sha256=$(sha256sum "$manifest_file" | cut -d' ' -f1)
phase=PREPARED
started_at=$(date +%s)
updated_at=$started_at
completed_disks=0
current_disk=none
progress_percent=0
write_state() {
    local tmp="$state_file.tmp.$$"
    local -a config_paths=()
    local candidate
    for candidate in /etc/pve/nodes/*/qemu-server/"$vmid".conf; do
        [ -f "$candidate" ] && config_paths+=("$candidate")
    done
    [ "${#config_paths[@]}" -eq 1 ] || {
        echo "cannot prove one authoritative VM configuration for $vmid" >&2
        return 70
    }
    umask 077
    updated_at=$(date +%s)
    {
        printf 'version=3\ntx=%s\nvmid=%s\nsource_node=%s\ntarget_node=%s\n' "$tx" "$vmid" "$local_node" "$target"
        printf 'thin_storage=%s\nthick_storage=%s\nreturn_thin=%s\nphase=%s\n' "$thin_store" "$thick_store" "$return_thin" "$phase"
        printf 'disk_count=%s\ncompleted_disks=%s\ncurrent_disk=%s\nprogress_percent=%s\n' \
            "${#disks[@]}" "$completed_disks" "$current_disk" "$progress_percent"
        printf 'total_bytes=%s\nstarted_at=%s\nupdated_at=%s\n' \
            "$total_bytes" "$started_at" "$updated_at"
        printf 'config_sha256=%s\n' "$(sha256sum "${config_paths[0]}" | cut -d" " -f1)"
        printf 'disk_manifest_sha256=%s\n' "$disk_manifest_sha256"
    } >"$tmp"
    sync -f "$tmp"
    mv -f "$tmp" "$state_file"
    sync -f "$state_dir"
}
write_state

# PVE emits monotonic block-mirror percentages. Persist a throttled heartbeat
# without imposing a wall-clock limit on large disks: silence is observable,
# but a slow healthy 8-TB copy is not killed merely for taking hours.
run_progress_move() {
    local disk=$1 destination=$2 execution_node=$3
    local rc line now last_persist=0 observed
    current_disk=$disk
    progress_percent=0
    write_state
    set +e
    if [ "$execution_node" = local ]; then
        qm disk move "$vmid" "$disk" "$destination" --delete 1 2>&1
    else
        "${ssh_base[@]}" -- qm disk move "$vmid" "$disk" "$destination" --delete 1 2>&1
    fi | while IFS= read -r line; do
        printf '%s\n' "$line"
        if [[ $line =~ \(([0-9]+([.][0-9]+)?)%\) ]]; then
            observed=${BASH_REMATCH[1]}
            now=$(date +%s)
            if [ "$observed" != "$progress_percent" ] && [ $((now - last_persist)) -ge 30 ]; then
                progress_percent=$observed
                updated_at=$now
                write_state
                last_persist=$now
            fi
        fi
    done
    rc=${PIPESTATUS[0]}
    set -e
    [ "$rc" -eq 0 ] || {
        phase=MOVE_FAILED
        write_state
        return "$rc"
    }
    completed_disks=$((completed_disks + 1))
    progress_percent=100
    current_disk=none
    write_state
}

phase=WAITING_ADMISSION
write_state
admission_timeout=$(cfg_optional "$thin_store" slt-bridge-admission-timeout)
admission_timeout=${admission_timeout:-86400}
[[ $admission_timeout =~ ^[0-9]+$ \
    && $admission_timeout -ge 60 && $admission_timeout -le 604800 ]] \
    || { echo "invalid migration-bridge admission timeout policy" >&2; exit 70; }
admission_deadline=$(( $(date +%s) + admission_timeout ))
admission_last_heartbeat=0
# Desynchronize a large worker set, then back off to a bounded 15-second probe
# interval. Fifty queued evacuations therefore do not become a vgs poll storm.
admission_poll_seconds=$((2 + 16#${tx:0:2} % 3))
while ! admission_output=$(
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
        acquire "$thin_store" "$tx" "$local_node" 2>&1
); do
    admission_now=$(date +%s)
    [ "$admission_now" -lt "$admission_deadline" ] || {
        echo "migration-bridge admission timed out: $admission_output" >&2
        exit 75
    }
    if [ $((admission_now - admission_last_heartbeat)) -ge 30 ]; then
        write_state
        admission_last_heartbeat=$admission_now
    fi
    sleep "$admission_poll_seconds"
    [ "$admission_poll_seconds" -ge 15 ] \
        || admission_poll_seconds=$((admission_poll_seconds + 1))
done
printf '%s\n' "$admission_output"
phase=MATERIALIZING
write_state

# Capacity is sampled again after admission. Another completed bridge may have
# consumed space while this transaction waited in the queue.
vg_free=$(vgs --readonly --noheadings --units b --nosuffix -o vg_free "$thin_vg" | tr -d '[:space:]')
vg_free=${vg_free%.*}
[ "$vg_free" -ge "$required_bytes" ] || {
    echo "physical VG capacity changed while waiting for admission; exact admission retained for recovery" >&2
    exit 28
}

for entry in "${disks[@]}"; do
    disk=${entry%%|*}
    run_progress_move "$disk" "$thick_store" local
    qm config "$vmid" | grep -Eq "^${disk}: ${thick_store}:"
done
phase=MATERIALIZED_THICK
write_state
sharedlvmthin recovery-check "$thick_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
/usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
    release "$thin_store" "$tx" "$local_node"

qm migrate "$vmid" "$target" --online 1
settled=0
for _ in $(seq 1 30); do
    observed=$(
        pvesh get /cluster/resources --type vm --output-format json \
        | python3 -c 'import json,sys
vmid=int(sys.argv[1]); rows=[x for x in json.load(sys.stdin) if x.get("vmid")==vmid]
print((rows[0].get("node", "?")+":"+rows[0].get("status", "?")) if len(rows)==1 else "AMBIGUOUS")' "$vmid"
    )
    if [ "$observed" = "$target:running" ]; then
        settled=1
        break
    fi
    sleep 1
done
[ "$settled" -eq 1 ] || {
    phase=MIGRATION_UNSETTLED
    write_state
    echo "PVE migration task returned but target running state is unproven: $observed" >&2
    exit 70
}
phase=MIGRATED_THICK
write_state

if [ "$return_thin" -eq 1 ]; then
    member_ip=$(perl -MPVE::Cluster -e '
        PVE::Cluster::cfs_update();
        my ($node) = @ARGV;
        my $m = PVE::Cluster::get_members()->{$node} // die "unknown target\n";
        die "offline target\n" if !$m->{online};
        print $m->{ip};
    ' "$target")
    ssh_base=(/usr/bin/ssh -n -e none -o BatchMode=yes -o "HostKeyAlias=$target" \
        -o "UserKnownHostsFile=/etc/pve/nodes/$target/ssh_known_hosts" \
        -o GlobalKnownHostsFile=none "root@$member_ip")
    # A fast full-copy can outrun asynchronous thin-pool autogrow. Prepare the
    # exact per-VM pool at the sum of all virtual disk sizes before QEMU writes
    # its first block. Capacity/reserve admission and inactive publication are
    # performed by the plugin under the canonical VG lock.
    "${ssh_base[@]}" -- /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-import \
        prepare "$thin_store" "$vmid" "$total_bytes" "$tx"
    phase=RETURN_THIN_PREPARED
    write_state
    for entry in "${disks[@]}"; do
        disk=${entry%%|*}
        run_progress_move "$disk" "$thin_store" remote
        "${ssh_base[@]}" -- qm config "$vmid" | grep -Eq "^${disk}: ${thin_store}:"
    done
    "${ssh_base[@]}" -- sharedlvmthin recovery-check "$thin_store" | grep -qx 'SAFE_FOR_MUTATION=YES'
    phase=RETURNED_THIN
else
    phase=COMPLETE_THICK
fi
write_state
printf 'BRIDGE=PASS\nTX=%s\nFINAL_PHASE=%s\nSTATE_FILE=%s\n' "$tx" "$phase" "$state_file"
