def check(name, status, message):
    doc["checks"].append({
        "name": name,
        "status": status,
        "message": message,
    })

    if status == "FAIL":
        doc["result"] = "FAIL"
    elif status == "WARN" and doc["result"] == "PASS":
        doc["result"] = "WARN"


