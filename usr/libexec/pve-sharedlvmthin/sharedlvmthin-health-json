def pvesm_states():
    rc, out, _ = run(["pvesm", "status"])
    states = {}

    if rc != 0:
        return states

    for line in out.splitlines():
        fields = line.split()

        if len(fields) >= 3 and fields[0] != "Name":
            states[fields[0]] = {
