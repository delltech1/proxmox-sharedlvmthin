def iscsi_sessions():
    rc, out, _ = run([
        "iscsiadm",
        "-m",
        "session",
    ])

    sessions = []

    if rc != 0:
        return sessions

    for line in out.splitlines():
        m = re.search(
            r"(\d+\.\d+\.\d+\.\d+):(\d+).*?\s+(iqn\.\S+)",
            line,
        )

        if m:
            sessions.append({
                "portal": m.group(1),
                "port": int(m.group(2)),
                "target": m.group(3),
            })

    return sessions


def parse_iscsi_node_records(output):
    records = []
    current = {}
    wanted = {
        "node.name": "target",
        "node.startup": "startup",
        "node.conn[0].address": "portal",
        "node.conn[0].port": "port",
        "iface.iscsi_ifacename": "iface",
    }

    for raw in output.splitlines():
        if "=" not in raw:
            continue
        key, raw_value = (part.strip() for part in raw.split("=", 1))
        field = wanted.get(key)
        if field is None:
            continue
        if key == "node.name" and current:
            records.append(current)
            current = {}
        value = raw_value
        if field == "port":
            try:
                value = int(raw_value)
            except ValueError:
                value = None
        current[field] = value

    if current:
        records.append(current)
    return records


def iscsi_node_records():
    rc, out, error = run(["iscsiadm", "-m", "node", "-o", "show"])
    if rc != 0:
        return [], error or f"iscsiadm node inventory failed with status {rc}"
    return parse_iscsi_node_records(out), None


def iscsi_path_identity(device):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", str(device or "")):
        return None, "unsafe or missing block-device name"
    device_path = os.path.realpath(f"/sys/class/block/{device}/device")
    match = re.search(r"/session([0-9]+)(?:/|$)", device_path)
    if match is None:
        return None, "block path is not bound to an observable iSCSI session"
    session_number = match.group(1)
    session_root = f"/sys/class/iscsi_session/session{session_number}"
    target = read_file(f"{session_root}/targetname")
    iface = read_file(f"{session_root}/ifacename")
    connections = sorted(glob.glob(
        f"/sys/class/iscsi_connection/connection{session_number}:*"
    ))
    if not target or not iface or len(connections) != 1:
        return None, "iSCSI session identity is missing or ambiguous"
    portal = read_file(f"{connections[0]}/persistent_address")
    raw_port = read_file(f"{connections[0]}/persistent_port")
    try:
        port = int(raw_port)
    except (TypeError, ValueError):
        port = None
    if not portal or port is None:
        return None, "iSCSI connection portal identity is missing or malformed"
    return {
        "session": int(session_number),
        "target": target,
        "portal": portal,
        "port": port,
        "iface": iface,
    }, None


def evaluate_iscsi_boot_persistence(transport, node_records, service_state):
    if transport.get("type") != "iscsi":
        return None
    if service_state != "enabled":
        return "FAIL", (
            "open-iscsi.service is not enabled for automatic boot login "
            f"(observed {service_state or 'unknown'})"
        )
    paths = transport.get("paths")
    if not isinstance(paths, list) or not paths:
        return "FAIL", "managed iSCSI transport has no enumerable paths"
    failures = []
    proven = []
    for path in paths:
        device = str(path.get("device") or "<unknown>")
        identity = path.get("iscsi_identity")
        if not isinstance(identity, dict):
            failures.append(f"{device}: exact session identity unavailable")
            continue
        matches = [
            record for record in node_records
            if record.get("target") == identity.get("target")
            and record.get("portal") == identity.get("portal")
            and record.get("port") == identity.get("port")
            and record.get("iface") == identity.get("iface")
        ]
        if len(matches) != 1:
            failures.append(
                f"{device}: expected one exact persistent node record, found {len(matches)}"
            )
            continue
        if matches[0].get("startup") != "automatic":
            failures.append(
                f"{device}: persistent node startup is "
                f"{matches[0].get('startup') or 'unknown'}, not automatic"
            )
            continue
        proven.append(device)
    if failures:
        return "FAIL", "; ".join(failures)
    return "PASS", (
        f"{len(proven)} managed iSCSI path(s) have exact automatic persistent records"
    )


def build_transport(vg, inventory=None):
    all_pvs = inventory["pvs"] if inventory is not None else pvs_json()
    pvs = [
        x for x in all_pvs
        if x.get("vg_name") == vg
    ]

    if not pvs:
        return {
            "detected": False,
            "state": "UNKNOWN",
        }

    #
    # v1 supports the common case of one backing PV per
    # SharedLvmThin VG. Multiple PVs are reported explicitly
    # instead of guessing.
    #
    if len(pvs) != 1:
        return {
            "detected": False,
            "state": "UNKNOWN",
            "reason": "multiple_pvs",
            "pv_count": len(pvs),
        }

    pv = pvs[0]
    pv_name = pv.get("pv_name")
    wwid = normalize_wwid_from_pv(pv_name or "")

    result = {
        "detected": True,
        "pv": pv_name,
        "pv_uuid": pv.get("pv_uuid"),
        "multipath": False,
        "wwid": wwid,
        "type": "unknown",
        "state": "UNKNOWN",
        "paths_total": 0,
        "paths_healthy": 0,
        "paths": [],
    }

    if not wwid:
        result["state"] = "SINGLE_PATH_OR_UNKNOWN"
        return result

    multipath_maps = (
        inventory["multipath_maps"]
        if inventory is not None else multipath_json()
    )
    maps = {
        str(x.get("uuid", "")).lower(): x
        for x in multipath_maps
    }

    mp = maps.get(wwid)

    if not mp:
        result["state"] = "MULTIPATH_MAP_MISSING"
        return result

    result["multipath"] = True
    result["vendor"] = mp.get("vend")
    result["product"] = mp.get("prod")
    result["dm_device"] = mp.get("sysfs")
    result["path_faults"] = mp.get("path_faults", 0)

    block = (
        inventory["block"]
        if inventory is not None else block_transport_map()
    )
    paths = flatten_multipath_paths(mp)

    transports = set()

    for path in paths:
        dev = path.get("dev")
        b = block.get(dev, {})
        transport = b.get("transport") or "unknown"

        transports.add(transport)

        healthy = (
            path.get("dm_st") == "active"
            and path.get("dev_st") == "running"
            and path.get("chk_st") == "ready"
        )

        item = {
            "device": dev,
            "hctl": b.get("hctl"),
            "transport": transport,
            "healthy": healthy,
            "dm_state": path.get("dm_st"),
            "device_state": path.get("dev_st"),
            "check_state": path.get("chk_st"),
            "host_adapter": path.get("host_adapter"),
            "target_wwnn": path.get("target_wwnn"),
            "target_wwpn": path.get("target_wwpn"),
            "lun": path.get("lun_hex"),
        }

        if transport == "iscsi":
            identity, identity_error = iscsi_path_identity(dev)
            item["iscsi_identity"] = identity
            if identity_error is not None:
                item["iscsi_identity_error"] = identity_error

        result["paths"].append(item)

    result["paths_total"] = len(result["paths"])
    result["paths_healthy"] = sum(
        1 for x in result["paths"] if x["healthy"]
    )

    transports.discard("unknown")

    if len(transports) == 1:
        result["type"] = next(iter(transports))
    elif len(transports) > 1:
        result["type"] = "mixed"

    #
    # For iSCSI enrich path information with currently
    # established target sessions.
    #
    if result["type"] == "iscsi":
        if inventory is not None:
            if "iscsi_sessions" not in inventory:
                inventory["iscsi_sessions"] = iscsi_sessions()
            sessions = inventory["iscsi_sessions"]
        else:
            sessions = iscsi_sessions()
        result["sessions"] = sessions
        if inventory is not None:
            if "iscsi_node_records" not in inventory:
                records, records_error = iscsi_node_records()
                inventory["iscsi_node_records"] = records
                inventory["iscsi_node_records_error"] = records_error
            records = inventory["iscsi_node_records"]
            records_error = inventory.get("iscsi_node_records_error")
            if "open_iscsi_enabled" not in inventory:
                rc, enabled, error = run([
                    "systemctl", "is-enabled", "open-iscsi.service"
                ])
                inventory["open_iscsi_enabled"] = enabled if rc == 0 else (
                    enabled or error or "unknown"
                )
            service_state = inventory["open_iscsi_enabled"]
        else:
            records, records_error = iscsi_node_records()
            rc, enabled, error = run([
                "systemctl", "is-enabled", "open-iscsi.service"
            ])
            service_state = enabled if rc == 0 else (enabled or error or "unknown")
        result["boot_persistence"] = {
            "node_records_error": records_error,
            "open_iscsi_service": service_state,
        }
        if records_error is None:
            status_reason = evaluate_iscsi_boot_persistence(
                result, records, service_state
            )
            if status_reason is not None:
                status, reason = status_reason
                result["boot_persistence"].update({
                    "status": status,
                    "reason": reason,
                })
        else:
            result["boot_persistence"].update({
                "status": "FAIL",
                "reason": "persistent iSCSI node inventory unavailable: " + records_error,
            })

    if result["paths_total"] == 0:
        result["state"] = "CRITICAL"
    elif result["paths_healthy"] == result["paths_total"]:
        result["state"] = "HEALTHY"
    elif result["paths_healthy"] > 0:
        result["state"] = "DEGRADED"
    else:
        result["state"] = "CRITICAL"

    return result


