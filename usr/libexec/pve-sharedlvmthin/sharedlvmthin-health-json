def evaluate_vg_mutation_intent(vg, output):
    lines = [line.strip() for line in (output or "").splitlines() if line.strip()]
    if len(lines) != 1:
        return "FAIL", "VG mutation-intent inventory is ambiguous", None
    fields = [field.strip() for field in lines[0].split("|", 1)]
    if len(fields) != 2 or fields[0] != vg:
        return "FAIL", "VG mutation-intent inventory is malformed or belongs to another VG", None
    managed = [tag.strip() for tag in fields[1].split(",")
               if tag.strip().startswith("slt_tg_vgi_")]
    if not managed:
        return "PASS", "no persistent VG mutation intent", None
    allowed = {"v", "tx", "state", "op", "object", "before", "sha256"}
    values = {}
    for tag in managed:
        match = re.fullmatch(r"slt_tg_vgi_([A-Za-z0-9_]+)=([A-Za-z0-9_.:+-]+)", tag)
        if not match or match.group(1) not in allowed or match.group(1) in values:
            return "FAIL", "VG mutation-intent tags are malformed or duplicated", None
        values[match.group(1)] = match.group(2)
    if set(values) != allowed:
        return "FAIL", "VG mutation intent is incomplete or contains unknown fields", None
    order = ("v", "tx", "state", "op", "object", "before")
    canonical = "|".join(f"{key}={values[key]}" for key in order)
    digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:32]
    operations = {"ALLOC", "EXTEND", "REMOVE", "REMOVE_SNAPSHOT", "DM_CUTOVER", "DM_PIVOT"}
    if (values["v"] != "1" or values["state"] != "OPEN"
            or values["op"] not in operations
            or not re.fullmatch(r"[0-9a-f]{32}", values["tx"])
            or not re.fullmatch(r"[0-9a-f]{16,64}", values["before"])
            or values["sha256"] != digest):
        return "FAIL", "VG mutation-intent identity or digest is invalid", None
    reason = f"OPEN {values['op']} mutation intent blocks all new mutations"
    if values["op"] == "EXTEND":
        reason += "; use the explicit thick-recover-resize workflow when its runtime proof is available"
    elif values["op"] == "REMOVE":
        reason += "; use the explicit reference-gated thick-recover-volume-delete workflow"
    elif values["op"] in {"DM_CUTOVER", "DM_PIVOT"}:
        reason += ("; use thick-recover-prepare only for a still-MATERIALIZED anchor "
                   "whose transition was never published, otherwise use thick-resume")
    return "FAIL", reason, values["op"]


def vg_mutation_intent(vg, expected_wwid=None):
    command = ["vgs", "--readonly"]
    if expected_wwid:
        command.extend(["--devices", f"/dev/mapper/{expected_wwid}"])
    command.extend(["--noheadings", "--separator", "|", "-o", "vg_name,vg_tags", vg])
    rc, out, err = run(command)
    if rc != 0:
        return "FAIL", err or out or "VG mutation-intent inventory is unavailable", None
    return evaluate_vg_mutation_intent(vg, out)


def lvm_volume_inventory(vg):
    rc, out, err = run([
        "lvs",
        "--noheadings",
        "--separator", "|",
        "--units", "b",
        "--nosuffix",
        "-o",
        "lv_name,lv_size,lv_attr,lv_tags,seg_monitor,"
        "data_percent,metadata_percent,lv_health_status,lv_check_needed,"
        "lv_metadata_size,zero,discards,lv_autoactivation,lv_when_full",
        vg,
    ])

    return {
        "rc": rc,
        "output": out,
        "error": err,
    }


def pools(vg, sid, inventory=None):
    if inventory is None:
        inventory = lvm_volume_inventory(vg)

    rc = inventory.get("rc")
    out = inventory.get("output") or ""
    err = inventory.get("error") or ""

    result = []
    thick_anchors = []
    lv_sizes = {}

    if rc != 0:
        return None, err or out or f"lvs exited with status {rc}", None

    expected_tag = "pve-slt-sid-" + sid

    for line in out.splitlines():
        fields = [x.strip() for x in line.split("|")]

        if len(fields) < 14:
            continue

        name = fields[0]
        try:
            lv_sizes[name] = exact_byte_count(fields[1])
        except (TypeError, ValueError):
            lv_sizes[name] = None

        tags = [x for x in fields[3].split(",") if x]
        tag_values = {}
        for tag in tags:
            if not tag.startswith("slt_tg_") or "=" not in tag:
                continue
            key, tag_value = tag.split("=", 1)
            tag_values[key[7:]] = tag_value

        if name.startswith("sltg-a-") and tag_values.get("sid") == sid:
            thick_anchors.append({
                "name": name,
                "volume": tag_values.get("vol"),
                "phase": tag_values.get("phase"),
                "operation": tag_values.get("op"),
                "transaction": tag_values.get("tx"),
                "head": tag_values.get("head"),
                "generation": tag_values.get("generation"),
            })

        if not re.fullmatch(r"sltp-\d+", name):
            continue

        def fnum(v):
            try:
                number = percentage_decimal(v)
                return float(number) if number is not None else None
            except (TypeError, ValueError):
                return None

        size_bytes = exact_byte_count(fields[1])
        data_percent_decimal = percentage_decimal(fields[5])
        data_percent = (
            float(data_percent_decimal)
            if data_percent_decimal is not None else None
        )
        payload_used_bytes = (
            percentage_bytes(size_bytes, fields[5])
        )
        reserved_slack_bytes = (
            max(0, size_bytes - payload_used_bytes)
            if payload_used_bytes is not None else None
        )
        result.append({
            "name": name,
            "size_bytes": size_bytes,
            "attr": fields[2],
            "tags": tags,
            "owner_schema": tags.count("pve-slt-owner-v1") == 1,
            "owner_nodes": [
                tag[len("pve-slt-owner-node-"):]
                for tag in tags if tag.startswith("pve-slt-owner-node-")
            ],
            "owner_epochs": [
                tag[len("pve-slt-owner-epoch-"):]
                for tag in tags if tag.startswith("pve-slt-owner-epoch-")
            ],
            "owned": expected_tag in fields[3].split(","),
            "monitor": fields[4] or None,
            "data_percent": data_percent,
            "payload_used_bytes": payload_used_bytes,
            "reserved_slack_bytes": reserved_slack_bytes,
            "metadata_percent": fnum(fields[6]),
            "health_status": fields[7] or None,
            "check_needed": fields[8] or None,
            "metadata_size_bytes": exact_byte_count(fields[9]) if fields[9] else None,
            "zero": fields[10] or None,
            "discards": fields[11] or None,
            "autoactivation": fields[12] or None,
            "when_full": fields[13] or None,
        })

    for anchor in thick_anchors:
        anchor["head_size_bytes"] = lv_sizes.get(anchor.get("head"))
    return result, None, thick_anchors


def pve_volume_reference_files(volid):
    """Return config files that contain an exact PVE volume reference."""
    if not volid or not re.fullmatch(r"[A-Za-z0-9_.+-]+:[A-Za-z0-9_.+-]+", volid):
        return []
    pattern = re.compile(
        r"(?<![A-Za-z0-9_.+-])" + re.escape(volid) + r"(?=[,\s]|$)"
    )
    cluster_paths = (
        glob.glob("/etc/pve/nodes/*/qemu-server/*.conf")
        + glob.glob("/etc/pve/nodes/*/lxc/*.conf")
    )
    config_paths = cluster_paths or (
        glob.glob("/etc/pve/qemu-server/*.conf")
        + glob.glob("/etc/pve/lxc/*.conf")
    )
    matches = []
    for cfg_path in sorted(set(config_paths)):
        content = read_file(cfg_path)
        if content is not None and pattern.search(content):
            matches.append(cfg_path)
    return matches


def pve_volume_reference_index(include_current_sizes=False):
    """Read every cluster config once and index exact PVE volume references."""
    references, current_sizes, read_errors = collect_pve_inventory(
        read_text=read_file,
        globber=glob.glob,
    )
    return (references, current_sizes, read_errors) \
        if include_current_sizes else references


def thick_worker_process_inventory():
    """Capture worker argv and the process tree once for one collector run."""
    workers = []
    for path in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            pid = int(path.split("/")[2])
            with open(path, "rb") as process_cmdline:
                command = process_cmdline.read()
            argv = [
                item.decode("utf-8", "strict")
                for item in command.split(b"\0") if item
            ]
        except (IndexError, OSError, UnicodeError, ValueError):
            continue
        worker_args = None
        if argv and os.path.basename(argv[0]) == "sharedlvmthin-thick-materialize":
            worker_args = argv[1:]
        elif (
            len(argv) >= 2
            and os.path.basename(argv[0]) == "perl"
            and os.path.basename(argv[1]) == "sharedlvmthin-thick-materialize"
        ):
            worker_args = argv[2:]
        if worker_args is not None:
            workers.append((pid, worker_args))

    processes = {}
    for stat_path in glob.glob("/proc/[0-9]*/stat"):
        try:
            pid = int(stat_path.split("/")[2])
            with open(stat_path, "rb") as process_stat:
                stat = process_stat.read()
            tail = stat[stat.rfind(b")") + 2:].split()
            if len(tail) >= 2:
                processes[pid] = (tail[0], int(tail[1]))
        except (IndexError, OSError, ValueError):
            continue
    return {"workers": workers, "processes": processes}


def thick_worker_unit_states(transactions, batch_size=256):
    """Read exact transaction service/timer states in bounded systemd batches."""
    valid = sorted(set(
        transaction for transaction in transactions or []
        if isinstance(transaction, str)
        and re.fullmatch(r"[0-9a-f]{32}", transaction)
    ))
    if (
        not isinstance(batch_size, int) or isinstance(batch_size, bool)
        or not 1 <= batch_size <= 256
    ):
        raise ValueError("invalid Thick worker unit-state batch size")
    result = {}
    for offset in range(0, len(valid), batch_size):
        chunk = valid[offset:offset + batch_size]
        units = [
            f"pve-sharedlvmthin-tg-{transaction}.{suffix}"
            for transaction in chunk for suffix in ("service", "timer")
        ]
        rc, out, _ = run([
            "systemctl", "show", *units,
            "--property=Id", "--property=ActiveState", "--no-pager",
        ])
        if rc != 0:
            continue
        for block in re.split(r"\n\s*\n", out.strip()):
            fields = {}
            for line in block.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    fields[key] = value
            match = re.fullmatch(
                r"pve-sharedlvmthin-tg-([0-9a-f]{32})\.(service|timer)",
                fields.get("Id", ""),
            )
            state = fields.get("ActiveState", "").strip().lower()
            if match and state:
                result.setdefault(match.group(1), {})[match.group(2)] = state
    return result


def thick_worker_state(
    transaction, sid=None, volume=None, process_inventory=None, unit_states=None
):
    """Return the observed state of one transaction-scoped worker."""
    if not transaction or not re.fullmatch(r"[0-9a-f]{32}", transaction):
        return "UNKNOWN"
    if unit_states is not None:
        observed = dict(unit_states.get(transaction, {}))
    else:
        unit = f"pve-sharedlvmthin-tg-{transaction}"
        observed = {}
        for suffix in ("service", "timer"):
            rc, out, _ = run([
                "systemctl", "show", f"{unit}.{suffix}",
                "--property=ActiveState", "--value",
            ])
            if rc == 0 and out:
                observed[suffix] = out.strip().lower()
    exact_process = None
    exact_pids = set()
    if (
        sid and volume
        and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", sid)
        and re.fullmatch(r"(?:vm|base)-[0-9]+-disk-[0-9]+", volume)
    ):
        inventory = (
            process_inventory
            if process_inventory is not None
            else thick_worker_process_inventory()
        )
        processes = inventory.get("processes", {})
        for pid, worker_args in inventory.get("workers", []):
            exact_resume = worker_args == ["--resume", sid, volume]
            exact_scheduled = (
                len(worker_args or []) == 5
                and worker_args[0] == sid
                and worker_args[1] == volume
                and re.fullmatch(r"[A-Za-z0-9_.+-]+", worker_args[2])
                and worker_args[3] == "SNAPSHOT"
                and worker_args[4] == transaction
            )
            if exact_resume or exact_scheduled:
                exact_process = "RUNNING"
                exact_pids.add(pid)

        # A worker normally sleeps while its timeout/dmsetup child executes.
        # Attribute D-state only through an exact live parent chain rooted at
        # the transaction worker; unrelated host D-state must not be blamed on
        # this anchor.
        live_exact_pids = exact_pids.intersection(processes)
        for pid, (state, parent) in processes.items():
            if state != b"D":
                continue
            current = pid
            seen = set()
            while current in processes and current not in seen:
                if current in live_exact_pids:
                    return "BLOCKED_DSTATE"
                seen.add(current)
                current = processes[current][1]
    running_states = {"active", "activating", "reloading"}
    if observed.get("service") in running_states:
        return "RUNNING"
    # A timer proves queued work only while the matching service has not
    # already failed. Preserve the failed service as the stronger observation
    # instead of letting a lingering timer mask recovery-required state.
    if (
        observed.get("timer") in running_states
        and observed.get("service") != "failed"
    ):
        return "RUNNING"
    if exact_process == "RUNNING":
        return "RUNNING"
    if "failed" in observed.values():
        return "FAILED"
    if observed:
        return "ABSENT"
    return "UNKNOWN"


def evaluate_thick_anchor_references(
    sid, anchors, worker_state=None, reference_index=None,
    current_size_index=None, reference_evidence_errors=None,
):
    """Classify anchors without mutating or guessing cleanup eligibility."""
    results = []
    for anchor in anchors or []:
        volume = anchor.get("volume")
        volid = f"{sid}:{volume}" if volume else None
        references = (
            list(reference_index.get(volid, []))
            if volid and reference_index is not None
            else pve_volume_reference_files(volid) if volid else []
        )
        item = {
            **anchor,
            "volid": volid,
            "reference_count": len(references),
        }
        phase = anchor.get("phase")
        transaction = anchor.get("transaction")
        if phase != "MATERIALIZED":
            observed_worker = (
                worker_state(transaction, sid, volume)
                if worker_state is not None else "UNKNOWN"
            )
            item["worker_state"] = observed_worker
            if (
                phase not in {
                    "PREPARED", "SOURCE_READY", "COMMITTED", "HYDRATING",
                    "HYDRATION_COMPLETE", "LINEAR_PIVOTED",
                }
                or not transaction
                or not re.fullmatch(r"[0-9a-f]{32}", transaction)
            ):
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    "anchor has an invalid or ambiguous materialization state; "
                    "new mutations must remain blocked"
                )
            elif observed_worker == "RUNNING":
                item["status"] = "WARN"
                item["materialization_state"] = "IN_PROGRESS"
                item["reason"] = (
                    f"materialization phase {phase} has its exact transaction worker; "
                    "dependency-changing mutations remain blocked until completion"
                )
            elif observed_worker == "FAILED":
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    f"materialization phase {phase} has a failed exact transaction "
                    "worker; preserve its journal and signed storage evidence, then "
                    "use the explicit thick-resume workflow; no automatic repair "
                    "attempted"
                )
            elif observed_worker == "BLOCKED_DSTATE":
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    f"materialization phase {phase} has its exact worker blocked "
                    "in uninterruptible kernel sleep; a userspace timeout cannot "
                    "fence or cancel that I/O. Preserve the journal and signed "
                    "storage evidence, restore authoritative path health, and do "
                    "not start another worker"
                )
            else:
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    f"materialization phase {phase} has no active exact transaction "
                    "worker. Worker absence does not prove that a synchronous PVE "
                    "foreground caller or one of its descendants has exited. Preserve "
                    "the process tree and signed storage evidence; do not start a "
                    "second worker until caller/descendant absence and lack of kernel "
                    "hydration progress are both positively established. Only then use "
                    "the explicit thick-resume workflow; no automatic repair attempted"
                )
        elif reference_evidence_errors:
            item["status"] = "FAIL"
            item["materialization_state"] = "RECOVERY_REQUIRED"
            item["reason"] = (
                "PVE configuration reference evidence is incomplete; unreadable "
                "configuration files prevent proof of unique ownership"
            )
            item["reference_evidence_errors"] = list(reference_evidence_errors)
        elif not volume:
            item["status"] = "WARN"
            item["materialization_state"] = "MATERIALIZED"
            item["reason"] = "anchor volume identity is unavailable; no cleanup attempted"
        elif not references:
            item["status"] = "WARN"
            item["materialization_state"] = "MATERIALIZED"
            item["reason"] = (
                "unreferenced Thick Generations volume; it may be an incomplete "
                "destination after an interrupted import, clone, or move; prove its "
                "purpose and identity before any explicit cleanup"
            )
        elif len(references) > 1:
            item["status"] = "FAIL"
            item["materialization_state"] = "RECOVERY_REQUIRED"
            item["reason"] = (
                "volume is referenced by multiple PVE configs; ownership is ambiguous"
            )
        elif current_size_index is not None:
            current = list(current_size_index.get(volid, []))
            declared = current[0][1] if len(current) == 1 else None
            role = current[0][2] if len(current) == 1 else None
            authoritative = anchor.get("head_size_bytes")
            if len(current) != 1:
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    f"volume has {len(current)} current PVE references; exactly one "
                    "is required before further mutation"
                )
            elif role == "detached":
                item["status"] = "PASS"
                item["materialization_state"] = "MATERIALIZED"
                item["reason"] = (
                    "volume has one detached PVE unused reference; attached-size "
                    "reconciliation is not applicable"
                )
            elif role != "attached" \
                    or not isinstance(authoritative, int) or authoritative < 1 \
                    or not isinstance(declared, int) or declared < 1:
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    "current PVE or authoritative HEAD size is unavailable; "
                    "further mutation is blocked"
                )
            elif declared != authoritative:
                item["status"] = "FAIL"
                item["materialization_state"] = "RECOVERY_REQUIRED"
                item["reason"] = (
                    f"current PVE size {declared} differs from authoritative HEAD "
                    f"size {authoritative}; reconcile the stopped VM/CT "
                    "configuration before further mutation"
                )
            else:
                item["status"] = "PASS"
                item["materialization_state"] = "MATERIALIZED"
                item["reason"] = (
                    "volume has one current PVE reference with exact HEAD size"
                )
        else:
            item["status"] = "PASS"
            item["materialization_state"] = "MATERIALIZED"
            item["reason"] = "volume has exactly one PVE configuration reference"
        results.append(item)
    return results


def evaluate_thick_materialization_admission(anchors, limit):
    if not isinstance(limit, int) or isinstance(limit, bool) or not 1 <= limit <= 64:
        return "FAIL", {
            "active": None,
            "limit": limit,
            "available": False,
            "available_slots": None,
            "state": "UNKNOWN",
            "reason": "Thick materialization concurrency limit is invalid",
        }
    active = sum(
        1 for anchor in anchors or []
        if anchor.get("phase") != "MATERIALIZED"
    )
    available = active < limit
    available_slots = max(0, limit - active)
    return "PASS", {
        "active": active,
        "limit": limit,
        "available": available,
        "available_slots": available_slots,
        "state": "AVAILABLE" if available else "SATURATED",
        "reason": (
            f"{active}/{limit} Thick materialization slots active; "
            + ("new PREPARE may be admitted" if available
               else "new PREPARE is intentionally blocked at the configured ceiling")
        ),
    }


def evaluate_pool_flags(attr, health_status, check_needed=None):
    if not attr:
        return "UNKNOWN", "thin-pool attributes are unavailable"
    if (
        (len(attr) > 4 and attr[4] == "c")
        or str(check_needed or "").strip().lower()
        in {"1", "yes", "check_needed"}
    ):
        return "CRITICAL", "thin pool needs metadata check"
    if len(attr) > 8 and attr[8] == "M":
        return "CRITICAL", "thin-pool metadata is read-only"
    if not re.fullmatch(r"twi-[-a][o-]t[z-]--", attr):
        return "CRITICAL", f"unexpected thin-pool attributes '{attr}'"
    health = (health_status or "").strip()
    if health and health.lower() != "ok":
        return "CRITICAL", f"thin-pool health status is '{health}'"
    return "HEALTHY", "thin-pool attributes and metadata state are writable"


def evaluate_autoactivation(state):
    normalized = str(state or "").strip().lower()
    if normalized == "0":
        return "PASS", "generic LVM autoactivation is disabled"
    if normalized:
        return (
            "WARN",
            "generic LVM autoactivation is enabled on shared storage; "
            "review legacy PVE/LVM flags; Doctor made no change",
        )
    return "WARN", "LVM autoactivation state is unavailable; Doctor made no change"


def evaluate_thin_full_policy(when_full, no_space_timeout):
    """Describe, but never alter, the kernel/LVM thin-pool full policy."""
    policy = str(when_full or "").strip().lower()
    try:
        timeout = int(str(no_space_timeout).strip())
    except (TypeError, ValueError):
        timeout = None

    if policy == "queue":
        if timeout == 0:
            return (
                "CRITICAL",
                "when-full policy queues writes and dm_thin_pool no_space_timeout=0; "
                "a full pool can wait without a bounded kernel timeout; review the "
                "site capacity policy; no setting was changed",
            )
        if timeout is None:
            return (
                "WARN",
                "when-full policy queues writes but dm_thin_pool no_space_timeout "
                "is unavailable; bounded behavior is unconfirmed; no setting was changed",
            )
        return (
            "WARN",
            f"when-full policy queues writes for a kernel window of up to "
            f"{timeout} seconds while space may be extended; pool exhaustion can stall "
            "guest I/O; no setting was changed",
        )
    if policy == "error":
        return (
            "PASS",
            "when-full policy returns I/O errors instead of queueing; this avoids an "
            "unbounded wait but does not make pool exhaustion data-safe",
        )
    return (
        "WARN",
        f"when-full policy is '{policy or 'unknown'}'; exhaustion behavior is "
        "unconfirmed; no setting was changed",
    )


def evaluate_dmeventd(dmeventd_active, storages):
    """Require dmeventd only when an owned thin pool is active locally."""
    active_pools = []
    for storage in storages or []:
        sid = storage.get("id") or "unknown"
        for pool in storage.get("pools") or []:
            attr = str(pool.get("attr") or "")
            if pool.get("owned") and len(attr) > 4 and attr[4] == "a":
                active_pools.append(f"{sid}:{pool.get('name') or 'unknown'}")

    if dmeventd_active:
        return "PASS", "dm-event.service active"
    if active_pools:
        return "FAIL", (
            "dm-event.service inactive while owned thin pools are active: "
            + ", ".join(sorted(active_pools))
        )
    return "WARN", (
        "dm-event.service inactive; no local owned thin pool currently "
        "requires monitoring"
    )


