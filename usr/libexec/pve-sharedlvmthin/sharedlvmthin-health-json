def flatten_multipath_paths(mp):
    result = []

    for group in mp.get("path_groups", []):
        for path in group.get("paths", []):
            result.append(path)

    return result


def evaluate_expected_paths(transport, expected_min_paths):
    if expected_min_paths is None:
        return None

    healthy = int(transport.get("paths_healthy") or 0)
    if healthy >= expected_min_paths:
        return (
            "PASS",
            f"{healthy} healthy paths meet configured minimum "
            f"{expected_min_paths}",
        )

    return (
        "WARN",
        f"{healthy} healthy paths are below configured minimum "
        f"{expected_min_paths}; diagnostic only, SAN policy unchanged",
    )


def evaluate_allocation_policy(storage):
    mode = storage.get("initial_pool_mode") or "fixed"
    fixed = storage.get("initial_pool_size_gib")
    percent = storage.get("initial_pool_percent")
    maximum = storage.get("initial_pool_max_gib")

    if mode not in {"fixed", "proportional", "elastic", "full"}:
        return "FAIL", f"invalid allocation headroom mode '{mode}'"
    if fixed is not None and (not isinstance(fixed, int) or fixed < 1):
        return "FAIL", "invalid fixed allocation headroom"
    if mode == "proportional" and (
        not isinstance(percent, int) or percent < 1 or percent > 100
    ):
        return "FAIL", "proportional allocation percent must be 1..100"
    if maximum is not None and (not isinstance(maximum, int) or maximum < 1):
        return "FAIL", "allocation maximum must be a positive GiB value"

    if mode == "fixed":
        return (
            "WARN",
            f"fixed {fixed or 16} GiB headroom; burst capacity guarantee NO; "
            "fast bulk write/clone/restore/import/storage copy may outrun asynchronous "
            "autogrow; PVE raw full-copy may scan the complete virtual disk even "
            "when sparseinit avoids zero writes; plugin made no change",
        )
    if mode == "proportional":
        suffix = f", capped at {maximum} GiB" if maximum is not None else ""
        return (
            "PASS",
            f"proportional headroom {percent}% with fixed minimum {fixed or 16} GiB"
            f"{suffix}; bounded admission policy; PVE raw full-copy may still scan "
            "the complete virtual disk",
        )
    if mode == "elastic":
        headroom = storage.get("burst_headroom_gib")
        if not isinstance(headroom, int) or headroom < 1:
            return "FAIL", "elastic burst headroom must be a positive GiB value"
        return "PASS", (
            f"elastic actual-use plus {headroom} GiB absolute burst headroom; "
            "virtual disk size does not cause proportional physical reservation"
        )
    suffix = (
        f"; allocations requiring more than configured maximum {maximum} GiB fail closed"
        if maximum is not None else ""
    )
    return "PASS", (
        f"full-at-admission headroom policy{suffix}; PVE raw full-copy may still "
        "scan the complete virtual disk"
    )


def normalize_wwid_from_pv(pv_name):
    prefix = "/dev/mapper/"

    if not pv_name.startswith(prefix):
        return None

    name = pv_name[len(prefix):]

    if re.fullmatch(r"[0-9a-fA-F]{16,}", name):
        return name.lower()

    return None


def block_transport_map():
    rc, out, _ = run([
        "lsblk",
        "-J",
        "-S",
        "-o",
        "NAME,HCTL,TRAN,VENDOR,MODEL,SERIAL,WWN",
    ])

    result = {}

    if rc != 0:
        return result

    try:
        data = json.loads(out)
    except Exception:
        return result

    for dev in data.get("blockdevices", []):
        name = dev.get("name")

        if name:
            result[name] = {
                "transport": dev.get("tran"),
                "vendor": dev.get("vendor"),
                "model": dev.get("model"),
                "serial": dev.get("serial"),
                "wwn": dev.get("wwn"),
                "hctl": dev.get("hctl"),
            }

    return result


def iscsi_sessions():
    rc, out, _ = run([
        "iscsiadm",
        "-m",
        "session",
    ])

    sessions = []

    if rc != 0:
        return sessions

    for line in out.splitlines():
        m = re.search(
            r"(\d+\.\d+\.\d+\.\d+):(\d+).*?\s+(iqn\.\S+)",
            line,
        )

        if m:
            sessions.append({
                "portal": m.group(1),
                "port": int(m.group(2)),
                "target": m.group(3),
            })

    return sessions


def build_transport(vg):
    pvs = [
        x for x in pvs_json()
        if x.get("vg_name") == vg
    ]

    if not pvs:
        return {
            "detected": False,
            "state": "UNKNOWN",
        }

    #
    # v1 supports the common case of one backing PV per
    # SharedLvmThin VG. Multiple PVs are reported explicitly
    # instead of guessing.
    #
    if len(pvs) != 1:
        return {
            "detected": False,
            "state": "UNKNOWN",
            "reason": "multiple_pvs",
            "pv_count": len(pvs),
        }

    pv = pvs[0]
    pv_name = pv.get("pv_name")
    wwid = normalize_wwid_from_pv(pv_name or "")

    result = {
        "detected": True,
        "pv": pv_name,
        "pv_uuid": pv.get("pv_uuid"),
        "multipath": False,
        "wwid": wwid,
        "type": "unknown",
        "state": "UNKNOWN",
        "paths_total": 0,
        "paths_healthy": 0,
        "paths": [],
    }

    if not wwid:
        result["state"] = "SINGLE_PATH_OR_UNKNOWN"
        return result

    maps = {
        str(x.get("uuid", "")).lower(): x
        for x in multipath_json()
    }

    mp = maps.get(wwid)

    if not mp:
        result["state"] = "MULTIPATH_MAP_MISSING"
        return result

    result["multipath"] = True
    result["vendor"] = mp.get("vend")
    result["product"] = mp.get("prod")
    result["dm_device"] = mp.get("sysfs")
    result["path_faults"] = mp.get("path_faults", 0)

    block = block_transport_map()
    paths = flatten_multipath_paths(mp)

    transports = set()

    for path in paths:
        dev = path.get("dev")
        b = block.get(dev, {})
        transport = b.get("transport") or "unknown"

        transports.add(transport)

        healthy = (
            path.get("dm_st") == "active"
            and path.get("dev_st") == "running"
            and path.get("chk_st") == "ready"
        )

        item = {
            "device": dev,
            "hctl": b.get("hctl"),
            "transport": transport,
            "healthy": healthy,
            "dm_state": path.get("dm_st"),
            "device_state": path.get("dev_st"),
            "check_state": path.get("chk_st"),
            "host_adapter": path.get("host_adapter"),
            "target_wwnn": path.get("target_wwnn"),
            "target_wwpn": path.get("target_wwpn"),
            "lun": path.get("lun_hex"),
        }

        result["paths"].append(item)

    result["paths_total"] = len(result["paths"])
    result["paths_healthy"] = sum(
        1 for x in result["paths"] if x["healthy"]
    )

    transports.discard("unknown")

    if len(transports) == 1:
        result["type"] = next(iter(transports))
    elif len(transports) > 1:
        result["type"] = "mixed"

    #
    # For iSCSI enrich path information with currently
    # established target sessions.
    #
    if result["type"] == "iscsi":
        sessions = iscsi_sessions()
        result["sessions"] = sessions

    if result["paths_total"] == 0:
        result["state"] = "CRITICAL"
    elif result["paths_healthy"] == result["paths_total"]:
        result["state"] = "HEALTHY"
    elif result["paths_healthy"] > 0:
        result["state"] = "DEGRADED"
    else:
        result["state"] = "CRITICAL"

    return result


api, apiage = pve_api()
papi = plugin_api()
states = pvesm_states()

doc = {
    "schema": 1,
    "timestamp": datetime.now(timezone.utc).astimezone().isoformat(),
    "result": "PASS",
    "host": host_info(),
    "cluster": cluster_info(),
    "platform": {
        "pve_manager": pve_manager_version(),
        "kernel": platform.release(),
        "storage_api": api,
        "storage_api_age": apiage,
        "plugin_api": papi,
        "plugin_version": package_version("pve-sharedlvmthin"),
        "storage_package": package_version("libpve-storage-perl"),
    },
    "lvm": lvm_info(),
    "storages": [],
    "checks": [],
    "thin_pool_runtime": {
        "no_space_timeout_seconds": thin_pool_no_space_timeout(),
    },
}

def check(name, status, message):
    doc["checks"].append({
        "name": name,
        "status": status,
        "message": message,
    })

    if status == "FAIL":
        doc["result"] = "FAIL"
    elif status == "WARN" and doc["result"] == "PASS":
        doc["result"] = "WARN"


api_status, api_message = evaluate_api_compatibility(api, apiage, papi)
check("storage_api", api_status, api_message)


if doc["lvm"]["dmeventd_active"]:
    check("dmeventd", "PASS", "dm-event.service active")
else:
    check("dmeventd", "FAIL", "dm-event.service inactive")


cluster_status, cluster_message = cluster_check_status(doc["cluster"])
check("cluster_quorum", cluster_status, cluster_message)


for storage in parse_storage_cfg():
    sid = storage["id"]
    vg = storage["vg"]

    item = {
        **storage,
        "pve": states.get(sid, {}),
        "vg_info": None,
        "pools": [],
        "pool_inventory_error": None,
        "metadata_spares": [],
        "transport": None,
    }

    allocation_status, allocation_message = evaluate_allocation_policy(storage)
    check(
        f"allocation_policy:{sid}", allocation_status,
        f"{sid}: {allocation_message}",
    )

    if vg:
        item["vg_info"] = vg_info(vg)

        if item["vg_info"].get("visible"):
            pool_inventory, pool_error = pools(vg, sid)
            item["pool_inventory_error"] = pool_error
            if pool_error is not None:
                check(
                    f"pool_inventory:{sid}", "FAIL",
                    f"{sid}: read-only LVM pool inventory unavailable: "
                    f"{pool_error}; no repair attempted",
                )
            else:
                item["pools"] = pool_inventory
            item["metadata_spares"] = metadata_spares(vg)
            item["transport"] = build_transport(vg)

            for pool in item["pools"]:
                pool_status, pool_reason = evaluate_pool_flags(
                    pool.get("attr"), pool.get("health_status"),
                    pool.get("check_needed")
                )
                pool["health"] = {
                    "status": pool_status,
                    "reason": pool_reason,
                }
                if pool.get("owned") and pool_status != "HEALTHY":
                    check(
                        f"pool_health:{sid}:{pool.get('name')}",
                        "FAIL",
                        f"{sid}: {pool.get('name')} {pool_status}: "
                        f"{pool_reason}; mutations disabled, no repair attempted",
                    )
                if pool.get("owned"):
                    full_status, full_reason = evaluate_thin_full_policy(
                        pool.get("when_full"),
                        doc["thin_pool_runtime"]["no_space_timeout_seconds"],
                    )
                    pool["when_full_health"] = {
                        "status": full_status,
                        "reason": full_reason,
                    }
                    check(
                        f"when_full:{sid}:{pool.get('name')}",
                        "FAIL" if full_status == "CRITICAL" else full_status,
                        f"{sid}: {pool.get('name')}: {full_reason}",
                    )
                    auto_status, auto_reason = evaluate_autoactivation(
                        pool.get("autoactivation")
                    )
                    check(
                        f"autoactivation:{sid}:{pool.get('name')}",
                        auto_status,
                        f"{sid}: {pool.get('name')}: {auto_reason}",
                    )
                    spare_status, spare_reason = evaluate_pmspare(
                        pool.get("metadata_size_bytes"),
                        item["metadata_spares"],
                    )
                    check(
                        f"pmspare:{sid}:{pool.get('name')}",
                        spare_status,
                        f"{sid}: {pool.get('name')}: {spare_reason}; diagnostic only",
                    )
                    zero = str(pool.get("zero") or "").lower()
                    check(
                        f"zero:{sid}:{pool.get('name')}",
                        "PASS" if zero in {"y", "yes", "1", "zero"} else "WARN",
                        f"{sid}: {pool.get('name')} zeroing policy is "
                        f"'{pool.get('zero') or 'unknown'}'; plugin made no change",
                    )

            t = item["transport"]

            vg_pvs = [pv for pv in pvs_json() if pv.get("vg_name") == vg]
            binding_status, binding_reason = evaluate_pv_binding(
                vg_pvs,
                storage.get("expected_pv_uuid"),
                storage.get("expected_wwid"),
            )
            check(
                f"pv_binding:{sid}", binding_status,
                f"{sid}: {binding_reason}",
            )
            metadata_status, metadata_reason = evaluate_pv_metadata(vg_pvs)
            check(
                f"pv_metadata:{sid}", metadata_status,
                f"{sid}: {metadata_reason}",
            )

            path_expectation = evaluate_expected_paths(
                t, storage.get("expected_min_paths")
            )
            if path_expectation:
                path_status, path_message = path_expectation
                check(
                    f"expected_paths:{sid}",
                    path_status,
                    f"{sid}: {path_message}",
                )
                if path_status == "WARN" and t.get("state") == "HEALTHY":
                    t["state"] = "DEGRADED"

            if t.get("state") == "HEALTHY":
                check(
                    f"paths:{sid}",
                    "PASS",
                    f"{sid}: {t.get('paths_healthy')}/"
                    f"{t.get('paths_total')} storage paths healthy",
                )
            elif t.get("state") == "DEGRADED":
                if path_expectation and path_expectation[0] == "WARN":
                    degraded_message = (
                        f"{sid}: {t.get('paths_healthy')}/"
                        f"{t.get('paths_total')} paths healthy, below configured "
                        f"minimum {storage.get('expected_min_paths')}"
                    )
                else:
                    degraded_message = (
                        f"{sid}: only {t.get('paths_healthy')}/"
                        f"{t.get('paths_total')} storage paths healthy"
                    )
                check(
                    f"paths:{sid}",
                    "WARN",
                    degraded_message,
                )
            elif t.get("state") == "CRITICAL":
                check(
                    f"paths:{sid}",
                    "FAIL",
                    f"{sid}: no healthy storage paths",
                )

            check(
                f"storage:{sid}",
                "PASS",
                f"{sid}: VG {vg} visible",
            )
        else:
            check(
                f"storage:{sid}",
                "FAIL",
                f"{sid}: VG {vg} not visible",
            )
    else:
        check(
            f"storage:{sid}",
            "FAIL",
            f"{sid}: slt-vgname missing",
        )

    if states.get(sid, {}).get("status") != "active":
        check(
            f"pvesm:{sid}",
            "FAIL",
            f"{sid}: PVE storage not active",
        )

    doc["storages"].append(item)


print(json.dumps(doc, indent=2, sort_keys=False))
