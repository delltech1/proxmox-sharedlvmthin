#!/usr/bin/python3
"""Bounded, read-only PVE RAM/disk snapshot closure observer.

This tool never sends ``savevm-end`` and never deletes, deactivates or repairs
anything.  It correlates one exact local PVE task with raw pmxcfs config, one
bounded QMP ``query-savevm`` observation and (for RAM snapshots) the referenced
vmstate object's current existence.  Its positive result is evidence of the
observed closure only, not general storage-mutation authority.
"""

import argparse
import hashlib
import json
import os
import re
import socket
import stat
import subprocess
import sys
import time
from pathlib import Path


SAFE_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
UPID_RE = re.compile(r"^UPID:([A-Za-z0-9][A-Za-z0-9.-]*):[0-9A-Fa-f:]+:[^:\r\n]+:[^:\r\n]*:[^:\r\n]*:$")
VMID_RE = re.compile(r"^[1-9][0-9]{2,8}$")
SNAP_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
MAX_CONFIG_BYTES = 1024 * 1024
PVE_MODULES = (
    "/usr/share/perl5/PVE/QemuConfig.pm",
    "/usr/share/perl5/PVE/AbstractConfig.pm",
    "/usr/share/perl5/PVE/QMPClient.pm",
)


def emit(result, reason, evidence, code):
    print(f"SNAPSHOT_OBSERVATION={result}")
    print(f"REASON={reason}")
    for key in sorted(evidence):
        value = evidence[key]
        if isinstance(value, bool):
            value = "YES" if value else "NO"
        print(f"{key}={value}")
    print("MUTATION_PERFORMED=NO")
    print("SAVEVM_END_SENT=NO")
    print("STORAGE_MUTATION_AUTHORIZED=NO")
    raise SystemExit(code)


def bounded_run(argv, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError("global observation deadline expired")
    environment = {"PATH": SAFE_PATH, "LC_ALL": "C", "LANG": "C"}
    return subprocess.run(
        argv,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=min(remaining, 5),
        env=environment,
    )


def task_status(node, upid, deadline):
    result = bounded_run(
        ["pvesh", "get", f"/nodes/{node}/tasks/{upid}/status", "--output-format", "json"],
        deadline,
    )
    if result.returncode != 0:
        raise RuntimeError("exact PVE task status is unavailable")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("PVE task status is malformed") from exc
    if not isinstance(value, dict):
        raise RuntimeError("PVE task status has unknown shape")
    return value


def host_evidence(deadline):
    evidence = {
        "NODE": socket.gethostname(),
        "BOOT_ID": Path("/proc/sys/kernel/random/boot_id").read_text(
            encoding="ascii"
        ).strip(),
    }
    package_result = bounded_run(
        [
            "dpkg-query", "-W", "-f=${Package}=${Version}\\n",
            "pve-manager", "libpve-storage-perl", "qemu-server", "pve-qemu-kvm",
            "libpve-common-perl",
        ],
        deadline,
    )
    if package_result.returncode != 0:
        raise RuntimeError("exact PVE package tuple is unavailable")
    evidence["PACKAGE_TUPLE_SHA256"] = hashlib.sha256(
        package_result.stdout.encode()
    ).hexdigest()
    for module in PVE_MODULES:
        raw = Path(module).read_bytes()
        key = Path(module).stem.upper().replace(".", "_") + "_SHA256"
        evidence[key] = hashlib.sha256(raw).hexdigest()
    return evidence


def qemu_process_identity(vmid):
    pid_text = Path(f"/run/qemu-server/{vmid}.pid").read_text(encoding="ascii").strip()
    if not re.fullmatch(r"[1-9][0-9]*", pid_text):
        raise RuntimeError("QEMU PID record is malformed")
    pid = int(pid_text)
    stat_fields = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").split()
    if len(stat_fields) < 22:
        raise RuntimeError("QEMU process starttime is unavailable")
    executable = os.path.realpath(f"/proc/{pid}/exe")
    observed = os.stat(executable)
    return {
        "QEMU_PID": pid,
        "QEMU_STARTTIME": stat_fields[21],
        "QEMU_EXE": executable,
        "QEMU_EXE_IDENTITY": f"{observed.st_dev}:{observed.st_ino}:{observed.st_size}",
    }


def native_snapshot_parse(vmid, snapname, deadline):
    result = bounded_run(["qm", "config", vmid, "--snapshot", snapname], deadline)
    if result.returncode != 0:
        raise RuntimeError("native PVE snapshot config parser refused the exact section")
    return hashlib.sha256(result.stdout.encode()).hexdigest()


def read_snapshot_config(vmid, snapname):
    path = Path(f"/etc/pve/qemu-server/{vmid}.conf")
    raw = path.read_bytes()
    if len(raw) > MAX_CONFIG_BYTES:
        raise RuntimeError("VM config exceeds bounded observer limit")
    text = raw.decode("utf-8", "strict")
    sections = []
    current = None
    for number, line in enumerate(text.splitlines(), 1):
        match = re.fullmatch(r"\[([^]\r\n]+)\]", line)
        if match:
            current = match.group(1)
            if current == snapname:
                sections.append([])
            continue
        if current == snapname and sections:
            sections[-1].append((number, line))
    if len(sections) != 1:
        return raw, None, [], [], len(sections)
    vmstates = []
    empty_mtu = []
    virtio_nics = []
    mtu_lines = []
    malformed_mtu = False
    duplicate_nics = False
    seen_nics = set()
    for number, line in sections[0]:
        match = re.fullmatch(r"vmstate:\s*(\S.*?)\s*", line)
        if match:
            vmstates.append((number, match.group(1)))
        net_match = re.fullmatch(r"(net[0-9]+):\s*(.*?)\s*", line)
        if net_match:
            nic = net_match.group(1)
            if nic in seen_nics:
                duplicate_nics = True
            seen_nics.add(nic)
            model = net_match.group(2).split("=", 1)[0].strip()
            if model == "virtio":
                virtio_nics.append(nic)
        mtu_match = re.fullmatch(r"running-nets-host-mtu:\s*(.*?)\s*", line)
        if mtu_match:
            value = mtu_match.group(1)
            mtu_lines.append((number, value))
            if value == "":
                empty_mtu.append(number)
    recorded_mtu = []
    if len(mtu_lines) == 1 and mtu_lines[0][1] != "":
        seen_mtu = set()
        for item in mtu_lines[0][1].split(","):
            item_match = re.fullmatch(r"(net[0-9]+)=([0-9]+)", item)
            if not item_match or item_match.group(1) in seen_mtu:
                malformed_mtu = True
                break
            seen_mtu.add(item_match.group(1))
            recorded_mtu.append(item_match.group(1))
    elif len(mtu_lines) > 1:
        malformed_mtu = True
    return (
        raw, sections[0], vmstates, empty_mtu, 1,
        sorted(virtio_nics), sorted(recorded_mtu),
        malformed_mtu or duplicate_nics, len(mtu_lines),
    )


def qmp_command(stream, command, identifier, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError("global observation deadline expired")
    stream.write((json.dumps({"execute": command, "id": identifier}) + "\r\n").encode())
    while True:
        if time.monotonic() >= deadline:
            raise TimeoutError("global observation deadline expired")
        line = stream.readline()
        if not line:
            raise RuntimeError("QMP closed before returning evidence")
        message = json.loads(line)
        if message.get("id") != identifier:
            continue
        if "error" in message:
            raise RuntimeError(f"QMP {command} returned an error")
        if "return" not in message:
            raise RuntimeError(f"QMP {command} returned an unknown shape")
        return message["return"]


def qmp_savevm(vmid, deadline):
    path = f"/run/qemu-server/{vmid}.qmp"
    observed = os.stat(path)
    if observed.st_uid != 0 or not stat.S_ISSOCK(observed.st_mode):
        raise RuntimeError("local QMP endpoint is not a trusted root-owned socket")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("global observation deadline expired")
        sock.settimeout(min(remaining, 5))
        sock.connect(path)
        stream = sock.makefile("rwb", buffering=0)
        greeting = json.loads(stream.readline())
        if "QMP" not in greeting:
            raise RuntimeError("invalid QMP greeting")
        qmp_command(stream, "qmp_capabilities", "slt-capabilities", deadline)
        runstate = qmp_command(stream, "query-status", "slt-query-status", deadline)
        jobs_before = qmp_command(
            stream, "query-block-jobs", "slt-query-block-jobs-before", deadline
        )
        savevm = qmp_command(stream, "query-savevm", "slt-query-savevm", deadline)
        jobs_after = qmp_command(
            stream, "query-block-jobs", "slt-query-block-jobs-after", deadline
        )
        return {
            "savevm": savevm,
            "runstate": runstate,
            "jobs_before": jobs_before,
            "jobs_after": jobs_after,
        }
    finally:
        sock.close()


def vmstate_identity(volid, vmid, deadline):
    if ":" not in volid:
        raise RuntimeError("vmstate volume ID has no storage identity")
    storage = volid.split(":", 1)[0]
    node = socket.gethostname()
    inventory = bounded_run(
        ["pvesh", "get", f"/nodes/{node}/storage/{storage}/content",
         "--vmid", vmid, "--output-format", "json"],
        deadline,
    )
    if inventory.returncode != 0:
        raise RuntimeError("vmstate storage inventory is unavailable")
    try:
        rows = json.loads(inventory.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("vmstate storage inventory is malformed") from exc
    matches = [row for row in rows if isinstance(row, dict) and row.get("volid") == volid]
    if len(matches) != 1:
        raise RuntimeError("vmstate object is absent or ambiguous in storage inventory")
    result = bounded_run(["pvesm", "path", volid], deadline)
    if result.returncode != 0:
        raise RuntimeError("referenced vmstate path cannot be resolved")
    path = result.stdout.strip()
    if not path.startswith("/") or "\n" in path:
        raise RuntimeError("referenced vmstate path is malformed")
    evidence = {"VMSTATE_PATH": path, "VMSTATE_INVENTORY_MATCHES": 1}
    try:
        observed = os.stat(path)
    except OSError:
        evidence["VMSTATE_OBJECT_TYPE"] = "INACTIVE_INVENTORIED"
        return evidence
    if stat.S_ISBLK(observed.st_mode):
        devno = f"{os.major(observed.st_rdev)}:{os.minor(observed.st_rdev)}"
        evidence["VMSTATE_OBJECT_TYPE"] = "BLOCK"
        evidence["VMSTATE_DEVNO"] = devno
        try:
            evidence["VMSTATE_DM_UUID"] = Path(f"/sys/dev/block/{devno}/dm/uuid").read_text(
                encoding="ascii"
            ).strip()
        except (OSError, UnicodeError):
            evidence["VMSTATE_DM_UUID"] = "UNAVAILABLE"
    elif stat.S_ISREG(observed.st_mode):
        evidence["VMSTATE_OBJECT_TYPE"] = "REGULAR"
        evidence["VMSTATE_SIZE"] = observed.st_size
    else:
        raise RuntimeError("referenced vmstate object has unsupported type")
    return evidence


def classify_qmp(value):
    if not isinstance(value, dict):
        return "UNKNOWN"
    status = value.get("status")
    if status in {"active", "completed", "failed"}:
        return status.upper()
    if not value or not value.get("bytes"):
        return "IDLE_OBSERVED"
    return "UNKNOWN"


def stable_sample(vmid, snapname, deadline, allow_stopped=False):
    status_result = bounded_run(["qm", "status", vmid], deadline)
    if status_result.returncode != 0:
        raise RuntimeError("VM runtime status is unavailable")
    vm_running = status_result.stdout.strip() == "status: running"
    if not vm_running and not allow_stopped:
        raise RuntimeError("running VM/QMP identity disappeared before closure proof")
    process_before = qemu_process_identity(vmid) if vm_running else {
        "QEMU_PID": "NONE", "QEMU_STARTTIME": "NONE", "QEMU_EXE": "NONE",
        "QEMU_EXE_IDENTITY": "NONE",
    }
    (raw, section, vmstates, empty_mtu, section_count, expected_mtu,
     recorded_mtu, malformed_mtu, mtu_line_count) = read_snapshot_config(vmid, snapname)
    native_digest = native_snapshot_parse(vmid, snapname, deadline)
    qmp = qmp_savevm(vmid, deadline) if vm_running else {
        "savevm": None, "runstate": {"status": "stopped"},
        "jobs_before": [], "jobs_after": [],
    }
    process_after = qemu_process_identity(vmid) if vm_running else process_before
    if process_before != process_after:
        raise RuntimeError("QEMU process identity changed during observation")
    if not isinstance(qmp["jobs_before"], list) or not isinstance(qmp["jobs_after"], list):
        raise RuntimeError("QMP block-job evidence has unknown shape")
    return {
        "process": process_after,
        "config_sha256": hashlib.sha256(raw).hexdigest(),
        "native_config_sha256": native_digest,
        "section": section,
        "vmstates": vmstates,
        "empty_mtu": empty_mtu,
        "expected_mtu": expected_mtu,
        "recorded_mtu": recorded_mtu,
        "malformed_mtu": malformed_mtu,
        "mtu_line_count": mtu_line_count,
        "section_count": section_count,
        "qmp_status": classify_qmp(qmp["savevm"]) if vm_running else "NOT_RUNNING",
        "qemu_runstate": qmp["runstate"].get("status", "UNKNOWN")
            if isinstance(qmp["runstate"], dict) else "UNKNOWN",
        "block_jobs_before": len(qmp["jobs_before"]),
        "block_jobs_after": len(qmp["jobs_after"]),
    }


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("vmid")
    parser.add_argument("snapshot")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--ram", action="store_true")
    mode.add_argument("--disk-only", action="store_true")
    parser.add_argument("--upid", required=True)
    parser.add_argument("--deadline-sec", type=int, default=15)
    args = parser.parse_args(argv)
    if not VMID_RE.fullmatch(args.vmid) or not SNAP_RE.fullmatch(args.snapshot):
        parser.error("unsafe VMID or snapshot name")
    match = UPID_RE.fullmatch(args.upid)
    if not match:
        parser.error("invalid exact PVE UPID")
    if args.deadline_sec < 3 or args.deadline_sec > 60:
        parser.error("deadline must be between 3 and 60 seconds")
    node = match.group(1)
    hostname = socket.gethostname()
    if node.lower() != hostname.lower():
        emit("UNKNOWN", "UPID node is not the local QMP authority", {"UPID_NODE": node}, 2)
    started = time.monotonic()
    deadline = started + args.deadline_sec
    evidence = {
        "VMID": args.vmid,
        "SNAPSHOT": args.snapshot,
        "UPID": args.upid,
        "OBSERVATION_STARTED_MONOTONIC_NS": time.monotonic_ns(),
    }
    try:
        evidence.update(host_evidence(deadline))
        task = task_status(node, args.upid, deadline)
        evidence["TASK_STATUS"] = task.get("status", "UNKNOWN")
        evidence["TASK_EXITSTATUS"] = task.get("exitstatus", "UNAVAILABLE")
        evidence["TASK_TYPE"] = task.get("type", "UNKNOWN")
        evidence["TASK_ID"] = task.get("id", "UNKNOWN")
        first = stable_sample(args.vmid, args.snapshot, deadline, args.disk_only)
        time.sleep(min(0.2, max(0, deadline - time.monotonic())))
        second = stable_sample(args.vmid, args.snapshot, deadline, args.disk_only)
        comparable = (
            "process", "config_sha256", "native_config_sha256", "section_count",
            "vmstates", "empty_mtu", "expected_mtu", "recorded_mtu",
            "malformed_mtu", "mtu_line_count", "qmp_status", "qemu_runstate",
            "block_jobs_before", "block_jobs_after",
        )
        if any(first[key] != second[key] for key in comparable):
            raise RuntimeError("two bounded snapshot observations are not stable")
        evidence.update(first["process"])
        evidence["CONFIG_SHA256"] = first["config_sha256"]
        evidence["NATIVE_CONFIG_SHA256"] = first["native_config_sha256"]
        evidence["SNAPSHOT_SECTION_COUNT"] = first["section_count"]
        evidence["VMSTATE_REFERENCE_COUNT"] = len(first["vmstates"])
        evidence["EMPTY_MTU_COUNT"] = len(first["empty_mtu"])
        evidence["EXPECTED_VIRTIO_NICS"] = ",".join(first["expected_mtu"])
        evidence["RECORDED_MTU_NICS"] = ",".join(first["recorded_mtu"])
        evidence["MTU_METADATA_MALFORMED"] = first["malformed_mtu"]
        evidence["MTU_METADATA_LINE_COUNT"] = first["mtu_line_count"]
        evidence["QMP_SAVEVM_STATUS"] = first["qmp_status"]
        evidence["QEMU_RUNSTATE"] = first["qemu_runstate"]
        evidence["BLOCK_JOBS_BEFORE"] = first["block_jobs_before"]
        evidence["BLOCK_JOBS_AFTER"] = first["block_jobs_after"]
        evidence["STABLE_SAMPLES"] = 2
        if len(first["vmstates"]) == 1:
            evidence["VMSTATE_VOLID"] = first["vmstates"][0][1]
            evidence.update(vmstate_identity(first["vmstates"][0][1], args.vmid, deadline))
        evidence["OBSERVATION_FINISHED_MONOTONIC_NS"] = time.monotonic_ns()
    except (OSError, UnicodeError, ValueError, RuntimeError, TimeoutError,
            subprocess.SubprocessError, json.JSONDecodeError, socket.timeout) as exc:
        emit("UNKNOWN", str(exc), evidence, 2)

    if str(evidence["TASK_ID"]) != args.vmid or evidence["TASK_TYPE"] != "qmsnapshot":
        emit("UNKNOWN", "exact UPID is not the requested VM snapshot task", evidence, 2)
    if evidence["TASK_STATUS"] != "stopped":
        emit("IN_PROGRESS", "exact PVE task is not terminal", evidence, 3)
    if evidence["TASK_EXITSTATUS"] != "OK":
        emit("RECOVERY_REQUIRED", "exact PVE task did not terminate OK", evidence, 1)
    acceptable_qmp = {"IDLE_OBSERVED"}
    if args.disk_only:
        acceptable_qmp.add("NOT_RUNNING")
    if evidence["QMP_SAVEVM_STATUS"] not in acceptable_qmp:
        emit(
            "RECOVERY_REQUIRED",
            "QMP save state is not idle; completed is not finalization proof",
            evidence,
            1,
        )
    if evidence["BLOCK_JOBS_BEFORE"] or evidence["BLOCK_JOBS_AFTER"]:
        emit("RECOVERY_REQUIRED", "active QEMU block job makes closure ambiguous", evidence, 1)
    if evidence["SNAPSHOT_SECTION_COUNT"] != 1:
        emit("RECOVERY_REQUIRED", "exact snapshot section is absent or ambiguous", evidence, 1)
    if args.ram and evidence["VMSTATE_REFERENCE_COUNT"] != 1:
        emit("RECOVERY_REQUIRED", "RAM snapshot lacks one exact vmstate reference", evidence, 1)
    if args.disk_only and evidence["VMSTATE_REFERENCE_COUNT"]:
        emit("RECOVERY_REQUIRED", "disk-only snapshot unexpectedly references vmstate", evidence, 1)
    if args.ram:
        if evidence["MTU_METADATA_LINE_COUNT"] != 1 or evidence["MTU_METADATA_MALFORMED"]:
            emit("RECOVERY_REQUIRED", "RAM snapshot MTU metadata is absent, duplicate or malformed", evidence, 1)
        if evidence["EMPTY_MTU_COUNT"] or not evidence["EXPECTED_VIRTIO_NICS"]:
            emit("RECOVERY_REQUIRED", "RAM snapshot has no positive VirtIO MTU proof", evidence, 1)
        if evidence["EXPECTED_VIRTIO_NICS"] != evidence["RECORDED_MTU_NICS"]:
            emit("RECOVERY_REQUIRED", "RAM snapshot MTU set is partial or unexpected", evidence, 1)
    elif evidence["MTU_METADATA_LINE_COUNT"]:
        emit("RECOVERY_REQUIRED", "disk-only snapshot unexpectedly contains RAM MTU metadata", evidence, 1)
    emit(
        "OBSERVED_CLOSED",
        "task, config, QMP idle observation and requested snapshot mode agree",
        evidence,
        0,
    )


if __name__ == "__main__":
    main(sys.argv[1:])
