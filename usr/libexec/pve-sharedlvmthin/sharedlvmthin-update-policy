    verify_prepared.add_argument("--target-package", required=True)
    verify_prepared.add_argument("--target-version", required=True)
    verify_prepared.add_argument("--target-architecture", required=True)
    verify_prepared.add_argument("--artifact-sha256", required=True)
    verify_prepared.add_argument("--candidate-manifest", required=True)
    verify_prepared.set_defaults(func=command_verify_prepared_freeze_package)
    status = subs.add_parser("status")
    status.add_argument("--expected-post-gate", default=None,
                        help=argparse.SUPPRESS)
    status.set_defaults(func=command_status)
    authorize = subs.add_parser("authorize-proposal")
    authorize.set_defaults(func=command_authorize)
    postcheck = subs.add_parser("postcheck")
    postcheck.set_defaults(func=command_postcheck)
    qualify_runtime = subs.add_parser("qualify-runtime")
    qualify_runtime.add_argument("--package", required=True)
    qualify_runtime.add_argument("--version", required=True)
    qualify_runtime.add_argument("--artifact-sha256", required=True)
    qualify_runtime.add_argument("--plan-digest", required=True)
    qualify_runtime.add_argument("--transaction-id", required=True)
    qualify_runtime.set_defaults(func=command_qualify_runtime)
    finalize_runtime = subs.add_parser("finalize-runtime")
    finalize_runtime.add_argument("--transaction-id", required=True)
    finalize_runtime.set_defaults(func=command_finalize_runtime)
    requalify_boot = subs.add_parser("requalify-boot")
    requalify_boot.set_defaults(func=command_requalify_boot)
    recover = subs.add_parser("recover-zero-effect")
    recover.set_defaults(func=command_recover)
    args = parser.parse_args()
    try:
        # postcheck already owns the exclusive policy lock while its Doctor
        # child asks for a digest-bound, read-only status.  A second flock via
        # another open-file description would deadlock against our own parent.
        # Only that exact internal observation skips the redundant child lock.
        internal_postcheck_status = (args.command == "status"
                                     and bool(getattr(args, "expected_post_gate", None)))
        lock_context = contextlib.nullcontext() if internal_postcheck_status \
            else policy_lock(exclusive=args.command != "status")
        with lock_context:
            result = args.func(args)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as exc:
        print(f"UPDATE_POLICY_ERROR={exc}", file=sys.stderr)
        return 1
    return result or 0


if __name__ == "__main__":
    sys.exit(main())
