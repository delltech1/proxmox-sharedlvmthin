    requalify_boot = subs.add_parser("requalify-boot")
    requalify_boot.set_defaults(func=command_requalify_boot)
    recover = subs.add_parser("recover-zero-effect")
    recover.set_defaults(func=command_recover)
    args = parser.parse_args()
    try:
        # postcheck already owns the exclusive policy lock while its Doctor
        # child asks for a digest-bound, read-only status.  A second flock via
        # another open-file description would deadlock against our own parent.
        # Only that exact internal observation skips the redundant child lock.
        internal_postcheck_status = (args.command == "status"
                                     and bool(getattr(args, "expected_post_gate", None)))
        lock_context = contextlib.nullcontext() if internal_postcheck_status \
            else policy_lock(exclusive=args.command != "status")
        with lock_context:
            result = args.func(args)
    except UnlistedRuntimeTuple as exc:
        print(f"UPDATE_POLICY_ERROR={exc}", file=sys.stderr)
        print("RUNTIME_TUPLE=UNLISTED", file=sys.stderr)
        return 78
    except (OSError, RuntimeError, ValueError, tarfile.TarError, subprocess.SubprocessError) as exc:
        print(f"UPDATE_POLICY_ERROR={exc}", file=sys.stderr)
        return 1
    return result or 0


