    print(f"FREEZE_INTEGRITY={integrity}")
    if missing_holds:
        print("MISSING_REQUIRED_HOLDS=" + ",".join(missing_holds))
    try:
        manifest, library = manifest_and_lib()
        flavor = pathlib.Path("/usr/share/pve-sharedlvmthin/package-flavor").read_text().strip()
        plugin_package = "pve-sharedlvmthin-thick" if flavor == "thick-only" else "pve-sharedlvmthin"
        api_result = run(["perl", "-I/usr/share/perl5", "-MPVE::Storage", "-e",
                          "print PVE::Storage::APIVER()"])
        if api_result.returncode or not api_result.stdout.isdigit():
            raise RuntimeError("PVE Storage API is unavailable")
        versions = {name: package_version(name) for name in manifest.get("watched_packages", [])}
        observed = library.observed_tuple(
            manifest, versions, profile=flavor, api=int(api_result.stdout),
            running_kernel=os.uname().release, plugin_version=package_version(plugin_package),
        )
        print(f"RUNTIME_TUPLE={(observed or {}).get('id', 'UNLISTED')}")
        print(f"RUNTIME_COMPATIBILITY={(observed or {}).get('status', 'UNKNOWN')}")
    except Exception as exc:
        observed = None
        print("RUNTIME_TUPLE=UNKNOWN")
        print(f"RUNTIME_OBSERVER_ERROR={exc}")
    expected_post_gate = getattr(args, "expected_post_gate", None)
    post_is_expected = bool(post and expected_post_gate
                            and post.get("plan_digest") == expected_post_gate)
    return 1 if integrity.startswith("FAIL") or (post and not post_is_expected) or transition or migration \
        or observed is None else 0


def command_authorize(_args):
    require_root()
    # main() already owns the exclusive policy lock for every mutating
    # subcommand.  Do not recursively acquire flock here: Linux flock is tied
    # to the open-file description and a second open by this process would
    # correctly conflict with the authoritative outer lock.
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") not in {"WARN", "MANUAL_OVERRIDE"}:
        raise SystemExit("select warn before authorizing an unqualified plan")
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("another update transaction is pending; authorization refused")
    proposal = read_json(PROPOSAL)
    if not proposal or not proposal.get("plan_digest"):
        raise SystemExit("no refused APT proposal is available")
    manifest, library = manifest_and_lib()
    context = authorization_context(manifest, library, policy)
    atomic_json(AUTH, {
        "schema": 2,
        "authorization_id": secrets.token_hex(16),
        "plan_digest": proposal["plan_digest"],
        "payloads": proposal.get("payloads", []),
        "context": context,
    })
    print(f"AUTHORIZED_PLAN_SHA256={proposal['plan_digest']}")
    print(f"AUTHORIZED_CONTEXT_SHA256={context['context_sha256']}")
    print("Authorization is one-shot and valid only for this exact APT plan, payload set and runtime context.")


def package_version(package):
    result = run(["dpkg-query", "-W", "-f=${Version}|${db:Status-Status}", package])
    fields = result.stdout.split("|")
    return fields[0] if result.returncode == 0 and fields[1:] == ["installed"] else None


def assert_listed_runtime_tuple(manifest, library, expected_package=None,
                                expected_version=None):
    """Prove the exact installed payload belongs to one manifest tuple.

    The command-level API/hook probes intentionally answer a different
    question: they prove that required interfaces exist.  They must never be
    allowed to promote an otherwise unlisted package/PVE/kernel combination
    to a released runtime.  Operation-level RETEST_REQUIRED boundaries remain
    valid for an experimental candidate, but an absent or globally blocked
    tuple is not a releasable runtime identity.
    """
    flavor = pathlib.Path(
        "/usr/share/pve-sharedlvmthin/package-flavor").read_text().strip()
    if flavor not in {"dual", "thick-only"}:
        raise RuntimeError("installed package profile is invalid")
    plugin_package = "pve-sharedlvmthin-thick" if flavor == "thick-only" \
        else "pve-sharedlvmthin"
    plugin_version = package_version(plugin_package)
    if expected_package is not None and plugin_package != expected_package:
        raise RuntimeError("runtime tuple package profile differs from the candidate")
    if expected_version is not None and plugin_version != expected_version:
        raise RuntimeError("runtime tuple package version differs from the candidate")
    api_result = run(["perl", "-I/usr/share/perl5", "-MPVE::Storage", "-e",
                      "print PVE::Storage::APIVER()"])
    if api_result.returncode or not api_result.stdout.isdigit():
        raise RuntimeError("PVE Storage API is unavailable for tuple admission")
    versions = {name: package_version(name)
                for name in manifest.get("watched_packages", [])}
    identity = {
        "profile": flavor,
        "api": int(api_result.stdout),
        "running_kernel": os.uname().release,
        "plugin_package": plugin_package,
        "plugin_version": plugin_version,
        "versions": versions,
    }
    observed = library.observed_tuple(
        manifest, versions, profile=flavor, api=int(api_result.stdout),
        running_kernel=os.uname().release, plugin_version=plugin_version,
    )
    if not isinstance(observed, dict):
        raise UnlistedRuntimeTuple(identity, library.digest(manifest))
    status = observed.get("status")
    if status not in {"EXACT_LAB_TESTED", "RETEST_REQUIRED"}:
        raise RuntimeError(
            f"runtime tuple '{observed.get('id', 'UNKNOWN')}' is not admissible: {status}")
    return {
        "tuple": observed,
        "manifest_sha256": library.digest(manifest),
        "tuple_sha256": library.digest(observed),
        "identity_sha256": library.digest(identity),
    }


def assert_bound_runtime_tuple(release, manifest, library):
    observed = assert_listed_runtime_tuple(
        manifest, library, release.get("plugin_package"),
        release.get("plugin_version"))
    expected = {
        "runtime_tuple_id": observed["tuple"].get("id"),
        "runtime_tuple_status": observed["tuple"].get("status"),
        "runtime_manifest_sha256": observed["manifest_sha256"],
        "runtime_tuple_sha256": observed["tuple_sha256"],
        "runtime_identity_sha256": observed["identity_sha256"],
    }
    for field, value in expected.items():
        if release.get(field) != value:
            raise RuntimeError(f"runtime tuple binding changed: {field}")
    return observed


def build_bound_runtime_release(*, qualified, runtime_build_id, plan_digest,
                                boot_id, kernel_release, plugin_package,
                                plugin_version, verdict, artifact_sha256,
                                runtime_tuple, extra=None):
    """Build one boot-bound receipt with the complete tuple identity."""
    release = {
        "schema": 1,
        "qualified": qualified,
        "runtime_build_id": runtime_build_id,
        "plan_digest": plan_digest,
        "boot_id": boot_id,
        "kernel_release": kernel_release,
        "plugin_package": plugin_package,
        "plugin_version": plugin_version,
        "runtime_tuple_id": runtime_tuple["tuple"].get("id"),
        "runtime_tuple_status": runtime_tuple["tuple"].get("status"),
        "runtime_manifest_sha256": runtime_tuple["manifest_sha256"],
        "runtime_tuple_sha256": runtime_tuple["tuple_sha256"],
        "runtime_identity_sha256": runtime_tuple["identity_sha256"],
        "verdict": verdict,
        "artifact_sha256": artifact_sha256,
    }
    if extra:
        release.update(extra)
    return release


def assert_exact_installed_release(release):
    """Bind a durable runtime receipt to the exact installed package payload."""
    if not isinstance(release, dict):
        raise RuntimeError("installed release proof is missing")
    package = release.get("plugin_package")
    version = release.get("plugin_version")
    if package not in {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"} \
            or not isinstance(version, str) or package_version(package) != version:
        raise RuntimeError("installed release package identity changed")
    opposite = "pve-sharedlvmthin-thick" if package == "pve-sharedlvmthin" \
        else "pve-sharedlvmthin"
    if package_version(opposite) is not None:
        raise RuntimeError("installed release found both package profiles")
    if release.get("runtime_build_id") != exact_runtime_build_id() \
            or release.get("artifact_sha256") != exact_hex_identity(
                PACKAGE_ARTIFACT_FILE, "installed package artifact identity"):
        raise RuntimeError("installed release payload identity changed")
    audit = run(["dpkg", "--audit"])
    if audit.returncode or audit.stdout.strip() or audit.stderr.strip():
        raise RuntimeError("dpkg audit is not clean")
    verify = run(["dpkg", "--verify", package])
    if verify.returncode or verify.stdout.strip() or verify.stderr.strip():
        raise RuntimeError("plugin package verification failed")
    return package, version


def expected_kernel(actions):
    releases = set()
    for row in actions:
        name = row.get("package", "").split(":", 1)[0]
        if row.get("action", "").startswith("/"):
            match = __import__("re").fullmatch(r"(?:proxmox|pve)-kernel-(.+)-signed", name)
            if match:
                releases.add(match.group(1))
    if len(releases) > 1:
        raise RuntimeError("post-gate plan contains multiple concrete kernel releases")
    return next(iter(releases), None)


def exact_package_settlement(expected):
    """Prove exact version, native architecture and clean installed state."""
    result = run(["dpkg-query", "-W", "-f=${Package}|${binary:Package}|${Version}|"
                  "${Architecture}|${db:Status-Status}\n"])
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "dpkg settlement inventory failed")
    observed = {}
    for line in result.stdout.splitlines():
        fields = line.split("|")
        if len(fields) != 5:
            raise RuntimeError("malformed dpkg settlement inventory")
        name, binary, package_version, architecture, status = fields
        if name not in expected:
            continue
        observed.setdefault(name, []).append({
            "binary": binary, "version": package_version,
            "architecture": architecture, "status": status,
        })

    mismatches = []
    for name, wanted in sorted(expected.items()):
        records = observed.get(name, [])
        installed = [record for record in records if record["status"] == "installed"]
        if wanted is None:
            if installed:
                mismatches.append(f"{name}: expected ABSENT, got installed runtime")
            continue
        if len(records) != 1:
            mismatches.append(
                f"{name}: expected one exact dpkg record, got {len(records)}"
            )
            continue
        record = records[0]
        if record["version"] != wanted["version"] \
                or record["architecture"] != wanted["architecture"] \
                or record["status"] != "installed":
            mismatches.append(
                f"{name}: expected {wanted['version']}|{wanted['architecture']}|installed, "
                f"got {record['version']}|{record['architecture']}|{record['status']}"
            )
    return mismatches


def command_postcheck(_args):
    require_root()
    receipt = read_json(POST_GATE)
    if not receipt:
        raise RuntimeError("no post-update gate is pending")
    actions = receipt.get("actions")
    if not isinstance(actions, list) or not actions:
        raise RuntimeError("post-update receipt has no exact action set")
    expected = {}
    for row in actions:
        name = row.get("package", "").split(":", 1)[0]
        if not name:
            raise RuntimeError("post-update receipt contains an invalid package")
        wanted = None if row.get("action") == "**REMOVE**" or row.get("new_version") == "-" \
            else {"version": row.get("new_version"), "architecture": row.get("new_arch")}
        if name in expected and expected[name] != wanted:
            raise RuntimeError(f"ambiguous expected version for {name}")
        expected[name] = wanted
    mismatches = exact_package_settlement(expected)
    if mismatches:
        raise RuntimeError("package settlement mismatch: " + "; ".join(mismatches))
    audit = run(["dpkg", "--audit"])
    if audit.returncode or audit.stdout.strip() or audit.stderr.strip():
        raise RuntimeError("dpkg audit is not clean")
    plugin_package = "pve-sharedlvmthin-thick" if pathlib.Path(
        "/usr/share/pve-sharedlvmthin/package-flavor").read_text().strip() == "thick-only" \
        else "pve-sharedlvmthin"
    verify = run(["dpkg", "--verify", plugin_package])
    if verify.returncode or verify.stdout.strip() or verify.stderr.strip():
        raise RuntimeError("plugin package verification failed")
    concrete_kernel = expected_kernel(actions)
    if concrete_kernel:
        current_boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        if current_boot == receipt.get("boot_id"):
            raise RuntimeError("kernel changed but the node has not completed a new boot")
        if os.uname().release != concrete_kernel:
            raise RuntimeError(f"running kernel {os.uname().release} != expected {concrete_kernel}")
    for service in ("pve-cluster", "corosync", "pvedaemon", "pveproxy", "pvestatd"):
        active = run(["systemctl", "is-active", "--quiet", service])
        if active.returncode:
            raise RuntimeError(f"required service is not active: {service}")
    quorum = run(["pvecm", "status"])
    if quorum.returncode or "Quorate:          Yes" not in quorum.stdout:
        raise RuntimeError("cluster quorum is not positively confirmed")
    doctor = run(["/usr/sbin/sharedlvmthin", "doctor", "--quick"], env={
        "SLT_EXPECTED_POST_GATE": receipt.get("plan_digest", ""),
    })
    if doctor.returncode not in {0, 1}:
        raise RuntimeError("SharedLvmThin Doctor failed after update")
    boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    runtime_build_id = exact_runtime_build_id()
    artifact_sha256 = exact_hex_identity(
        PACKAGE_ARTIFACT_FILE, "installed package artifact identity")
    qualification = "QUALIFIED" if receipt.get("verdict") in {
        "ALLOW_QUALIFIED", "ALLOW_QUALIFIED_EDGE"
    } else "UNQUALIFIED"
    plugin_version = package_version(plugin_package)
    manifest, library = manifest_and_lib()
    runtime_tuple = assert_listed_runtime_tuple(
        manifest, library, plugin_package, plugin_version)
    runtime_release = build_bound_runtime_release(
        qualified=qualification,
        runtime_build_id=runtime_build_id,
        plan_digest=receipt.get("plan_digest"),
        boot_id=boot_id,
        kernel_release=os.uname().release,
        plugin_package=plugin_package,
        plugin_version=plugin_version,
        verdict=receipt.get("verdict"),
        artifact_sha256=artifact_sha256,
        runtime_tuple=runtime_tuple,
    )
    if not isinstance(runtime_release["plan_digest"], str) \
            or not re.fullmatch(r"[0-9a-f]{64}", runtime_release["plan_digest"]):
        raise RuntimeError("post-update plan identity is malformed")
    if not runtime_release["plugin_version"]:
        raise RuntimeError("installed plugin version is unavailable")
    # Publish the boot-bound runtime decision before releasing the package
    # latch.  A crash before unlink remains safely blocked; a crash after
    # publication leaves an exact receipt that every mutating process checks.
    atomic_json(RUNTIME_RELEASE, runtime_release)
    completed = dict(receipt)
    completed.update({"state": "POST_GATE_COMPLETE", "running_kernel": os.uname().release,
                      "runtime_release": runtime_release})
    atomic_json(LAST_POST_GATE, completed)
    # Re-observe the exact tuple and both durable receipts immediately before
    # opening admission.  A manifest, package identity or receipt change after
    # the operational probes must leave POST_GATE in place for recovery.
    assert_bound_runtime_tuple(runtime_release, manifest, library)
    if read_json(POST_GATE) != receipt \
            or read_json(RUNTIME_RELEASE) != runtime_release:
        raise RuntimeError("post-update runtime tuple CAS changed before release")
    unlink_durable(POST_GATE)
    unlink_durable(PROPOSAL)
    result = "PASS_UNQUALIFIED" if receipt.get("verdict") in {
        "WARN_UNQUALIFIED", "MANUAL_OVERRIDE"
    } else "PASS"
    print(f"POST_UPDATE_GATE={result}")
    print(f"PLAN_SHA256={receipt.get('plan_digest')}")


def command_qualify_runtime(args):
    """Publish a boot-bound candidate while package admission remains closed."""
    require_root()
    if POST_GATE.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("runtime qualification refused while an unrelated update transaction is pending")
    if args.package not in {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"}:
        raise RuntimeError("runtime qualification package identity is invalid")
    if not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,128}", args.version):
        raise RuntimeError("runtime qualification package version is invalid")
    if not re.fullmatch(r"[0-9a-f]{64}", args.artifact_sha256) \
            or not re.fullmatch(r"[0-9a-f]{64}", args.plan_digest):
        raise RuntimeError("runtime qualification digest is invalid")
    if not re.fullmatch(r"[0-9a-f]{32}", args.transaction_id):
        raise RuntimeError("runtime qualification transaction identity is invalid")
    manifest, library = manifest_and_lib()
    transition = read_json(PACKAGE_TRANSITION)
    blocked = read_json(RUNTIME_QUALIFICATION)
    settled_transition = None
    settled_freeze = None
    if transition is None and isinstance(blocked, dict) \
            and blocked.get("schema") == 1 \
            and (blocked.get("state") == "PACKAGE_SETTLED_RUNTIME_CLOSED" or
                 (blocked.get("state") == "QUALIFYING" and
                  isinstance(blocked.get("prepared_transition"), dict))):
        settled_transition = read_json(LAST_PACKAGE_TRANSITION)
        if not isinstance(settled_transition, dict) or settled_transition.get("state") != "COMPLETE":
            raise RuntimeError("closed-runtime recovery requires exact completed package settlement")
        transition = assert_blocked_transition(settled_transition, blocked, library)
        if blocked.get("state") == "QUALIFYING" \
                and blocked.get("package_settlement_sha256") != library.digest(settled_transition):
            raise RuntimeError("closed-runtime qualification settlement identity changed")
        settled_freeze = read_json(FREEZE)
        if not isinstance(settled_freeze, dict) \
                or library.digest(settled_freeze) != settled_transition.get("successor_ledger_sha256") \
                or freeze_integrity(settled_freeze, manifest, library).get("result") != "PASS":
            raise RuntimeError("closed-runtime qualification requires its exact intact FREEZE successor")
    if not isinstance(transition, dict) or transition.get("schema") != 2 \
            or transition.get("state") != "PREPARED":
        raise RuntimeError("runtime qualification requires one exact prepared package transition")
    expected_transition = {
        "txid": args.transaction_id,
        "hostname": os.uname().nodename,
        "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "target_package": args.package,
        "target_version": args.version,
        "candidate_sha256": args.plan_digest,
        "candidate_artifact_sha256": args.artifact_sha256,
        "candidate_manifest_sha256": library.digest(manifest),
    }
    if any(transition.get(key) != value for key, value in expected_transition.items()):
        raise RuntimeError("prepared package transition does not match runtime candidate")
    opposite = "pve-sharedlvmthin-thick" if args.package == "pve-sharedlvmthin" \
        else "pve-sharedlvmthin"
    if package_version(args.package) != args.version or package_version(opposite) is not None:
        raise RuntimeError("runtime qualification package settlement mismatch")
    runtime_tuple = assert_listed_runtime_tuple(
        manifest, library, args.package, args.version)
    artifact = exact_hex_identity(PACKAGE_ARTIFACT_FILE, "installed package artifact identity")
    if artifact != args.artifact_sha256:
        raise RuntimeError("installed package artifact differs from authorized candidate")
    runtime_build_id = exact_runtime_build_id()
    audit = run(["dpkg", "--audit"])
    if audit.returncode or audit.stdout.strip() or audit.stderr.strip():
        raise RuntimeError("dpkg audit is not clean")
    verify = run(["dpkg", "--verify", args.package])
    if verify.returncode or verify.stdout.strip() or verify.stderr.strip():
        raise RuntimeError("plugin package verification failed")
    pending = {
        "schema": 1,
        "state": "QUALIFYING",
        "txid": args.transaction_id,
        "transition_sha256": library.digest(transition),
        "runtime_build_id": runtime_build_id,
        "artifact_sha256": artifact,
        "plan_digest": args.plan_digest,
        "boot_id": expected_transition["boot_id"],
        "kernel_release": os.uname().release,
        "plugin_package": args.package,
        "plugin_version": args.version,
        "runtime_tuple_id": runtime_tuple["tuple"].get("id"),
        "runtime_tuple_status": runtime_tuple["tuple"].get("status"),
        "runtime_manifest_sha256": runtime_tuple["manifest_sha256"],
        "runtime_tuple_sha256": runtime_tuple["tuple_sha256"],
        "runtime_identity_sha256": runtime_tuple["identity_sha256"],
    }
    existing = read_json(RUNTIME_QUALIFICATION)
    if settled_transition is not None:
        pending["prepared_transition"] = transition
        pending["package_settlement_sha256"] = library.digest(settled_transition)
        if existing != blocked or read_json(PACKAGE_TRANSITION) is not None \
                or read_json(LAST_PACKAGE_TRANSITION) != settled_transition \
                or read_json(FREEZE) != settled_freeze:
            raise RuntimeError("closed-runtime recovery CAS changed before qualification")
        # This is not a new package authorization. Qualification consumes only
        # the exact immutable already-completed package transition and still
        # has to pass tuple, artifact, dpkg, boot and all read-only probes.
        atomic_json(RUNTIME_QUALIFICATION, pending)
    elif existing and existing != pending:
        raise RuntimeError("a different runtime qualification is pending")
    elif not existing:
        create_json(RUNTIME_QUALIFICATION, pending)
    check = run(["/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
                 "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
                 "--runtime-qualification"],
                timeout=1820)
    if check.returncode or "RUNTIME_QUALIFICATION_READY=YES" not in check.stdout:
        raise RuntimeError("direct read-only runtime qualification did not pass")
    if ((settled_transition is None and read_json(PACKAGE_TRANSITION) != transition)
            or (settled_transition is not None and
                (read_json(PACKAGE_TRANSITION) is not None or
                 read_json(LAST_PACKAGE_TRANSITION) != settled_transition or
                 read_json(FREEZE) != settled_freeze))) \
            or read_json(RUNTIME_QUALIFICATION) != pending:
        raise RuntimeError("runtime qualification CAS changed during read-only probes")
    if package_version(args.package) != args.version \
            or exact_runtime_build_id() != runtime_build_id \
            or exact_hex_identity(PACKAGE_ARTIFACT_FILE,
                                  "installed package artifact identity") != artifact \
            or pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip() != pending["boot_id"] \
            or os.uname().release != pending["kernel_release"]:
        raise RuntimeError("runtime identity changed during qualification")
    boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    release = build_bound_runtime_release(
        qualified="QUALIFIED",
        runtime_build_id=runtime_build_id,
        plan_digest=args.plan_digest,
        boot_id=boot_id,
        kernel_release=os.uname().release,
        plugin_package=args.package,
        plugin_version=args.version,
        verdict="PACKAGE_PROFILE_GATE",
        artifact_sha256=artifact,
        runtime_tuple=runtime_tuple,
        extra={
            "qualification_txid": args.transaction_id,
            "transition_sha256": library.digest(transition),
        },
    )
    atomic_json(RUNTIME_RELEASE, release)
    print("RUNTIME_QUALIFICATION=PASS")
    print(f"RUNTIME_BUILD_ID={runtime_build_id}")
    print(f"BOOT_ID={boot_id}")
    print(f"KERNEL_RELEASE={os.uname().release}")


def command_finalize_runtime(args):
    """Release mutation admission only after settlement and PVE health proof."""
    require_root()
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("runtime finalization requires fully settled package state")
    if not re.fullmatch(r"[0-9a-f]{32}", args.transaction_id):
        raise RuntimeError("runtime finalization transaction identity is invalid")
    pending = read_json(RUNTIME_QUALIFICATION)
    release = read_json(RUNTIME_RELEASE)
    if pending is None:
        completed = read_json(LAST_RUNTIME_FINALIZATION)
        manifest, library = manifest_and_lib()
        if not isinstance(completed, dict) or completed.get("schema") != 1 \
                or completed.get("state") != "COMPLETE" \
                or completed.get("txid") != args.transaction_id \
                or completed.get("release_sha256") != library.digest(release) \
                or completed.get("boot_id") != pathlib.Path(
                    "/proc/sys/kernel/random/boot_id").read_text().strip() \
                or completed.get("kernel_release") != os.uname().release:
            raise RuntimeError("runtime finalization has no exact pending qualification")
        assert_exact_installed_release(release)
        assert_bound_runtime_tuple(release, manifest, library)
        print("RUNTIME_FINALIZATION_ALREADY_COMPLETE=YES")
        print(f"RUNTIME_QUALIFICATION_TXID={args.transaction_id}")
        return
    if not isinstance(pending, dict) or pending.get("schema") != 1 \
            or pending.get("state") != "QUALIFYING" \
            or pending.get("txid") != args.transaction_id:
        raise RuntimeError("runtime finalization has no exact pending qualification")
    if not isinstance(release, dict) or release.get("schema") != 1 \
            or release.get("qualified") != "QUALIFIED" \
            or release.get("qualification_txid") != args.transaction_id:
        raise RuntimeError("runtime finalization has no matching release candidate")
    for key in ("runtime_build_id", "artifact_sha256", "plan_digest", "boot_id",
                "kernel_release", "plugin_package", "plugin_version",
                "runtime_tuple_id", "runtime_tuple_status",
                "runtime_manifest_sha256", "runtime_tuple_sha256",
                "runtime_identity_sha256"):
        if release.get(key) != pending.get(key):
            raise RuntimeError(f"runtime finalization identity changed: {key}")
    assert_exact_installed_release(release)
    manifest, library = manifest_and_lib()
    assert_bound_runtime_tuple(release, manifest, library)
    settled_transition = read_json(LAST_PACKAGE_TRANSITION)
    if not isinstance(settled_transition, dict) \
            or settled_transition.get("state") != "COMPLETE" \
            or settled_transition.get("txid") != args.transaction_id:
        raise RuntimeError("runtime finalization requires exact completed package settlement")
    prepared_transition = completed_prepared_transition(settled_transition)
    prepared_digest = library.digest(prepared_transition)
    if pending.get("transition_sha256") != prepared_digest \
            or release.get("transition_sha256") != prepared_digest \
            or (pending.get("package_settlement_sha256") is not None and
                pending.get("package_settlement_sha256") != library.digest(
                    settled_transition)):
        raise RuntimeError("runtime finalization package settlement identity changed")
    policy = read_json(POLICY)
    if not isinstance(policy, dict) or policy.get("schema") != 2 \
            or policy.get("mode") not in {"FREEZE", "WARN", "QUALIFIED_AUTO"}:
        raise RuntimeError("runtime finalization requires an explicit supported update policy")
    freeze = read_json(FREEZE)
    if policy.get("mode") == "FREEZE" \
            and freeze_integrity(freeze, manifest, library).get("result") != "PASS":
        raise RuntimeError("runtime finalization requires an intact settled FREEZE baseline")
    if settled_transition.get("kind") == "DIRECT_PROFILE_GATE":
        requested_policy = settled_transition.get("requested_policy", "NONE")
        if settled_transition.get("runtime_release_sha256") != library.digest(release):
            raise RuntimeError("runtime finalization direct release digest changed")
        if requested_policy != "NONE" and policy.get("mode") != requested_policy:
            raise RuntimeError("runtime finalization direct policy differs from settlement")
        if library.digest(policy) != settled_transition.get("settled_policy_sha256"):
            raise RuntimeError("runtime finalization direct policy digest changed")
        if requested_policy == "FREEZE" \
                and library.digest(freeze) != settled_transition.get(
                    "settled_freeze_sha256"):
            raise RuntimeError("runtime finalization direct FREEZE digest changed")
    elif policy.get("mode") == "FREEZE" \
            and library.digest(freeze) != settled_transition.get(
                "successor_ledger_sha256"):
        raise RuntimeError("runtime finalization FREEZE successor digest changed")
    policy_digest = library.digest(policy)
    freeze_digest = library.digest(freeze) if policy.get("mode") == "FREEZE" else None
    check = run(["/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
                 "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
                 "--runtime-operational"],
                timeout=1820)
    if check.returncode or "UPGRADE_SAFE=YES" not in check.stdout:
        raise RuntimeError("post-release PVE operational qualification did not pass")
    if read_json(RUNTIME_QUALIFICATION) != pending \
            or read_json(RUNTIME_RELEASE) != release \
            or read_json(LAST_PACKAGE_TRANSITION) != settled_transition \
            or library.digest(read_json(POLICY)) != policy_digest \
            or (policy.get("mode") == "FREEZE"
                and library.digest(read_json(FREEZE)) != freeze_digest) \
            or pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip() \
                != release.get("boot_id") \
            or os.uname().release != release.get("kernel_release"):
        raise RuntimeError("runtime finalization CAS changed during operational probes")
    assert_exact_installed_release(release)
    assert_bound_runtime_tuple(release, manifest, library)
    completed = {
        "schema": 1, "state": "COMPLETE", "txid": args.transaction_id,
        "release_sha256": library.digest(release), "boot_id": release.get("boot_id"),
        "kernel_release": release.get("kernel_release"),
    }
    atomic_json(LAST_RUNTIME_FINALIZATION, completed)
    assert_exact_installed_release(release)
    assert_bound_runtime_tuple(release, manifest, library)
    if read_json(RUNTIME_QUALIFICATION) != pending \
            or read_json(RUNTIME_RELEASE) != release \
            or read_json(LAST_PACKAGE_TRANSITION) != settled_transition \
            or library.digest(read_json(POLICY)) != policy_digest \
            or (policy.get("mode") == "FREEZE"
                and library.digest(read_json(FREEZE)) != freeze_digest):
        raise RuntimeError("runtime finalization CAS changed before completion")
    unlink_durable(RUNTIME_QUALIFICATION)
    print("RUNTIME_FINALIZATION=PASS")
    print(f"RUNTIME_QUALIFICATION_TXID={args.transaction_id}")


def command_requalify_boot(_args):
    """Rebind an unchanged qualified payload after a proven real reboot."""
    require_root()
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("boot requalification refused while an update transaction is pending")
    previous = read_json(RUNTIME_RELEASE)
    if not isinstance(previous, dict) or previous.get("schema") != 1 \
            or previous.get("qualified") != "QUALIFIED":
        raise RuntimeError("boot requalification requires a previous qualified runtime receipt")
    manifest, library = manifest_and_lib()
    assert_exact_installed_release(previous)
    assert_bound_runtime_tuple(previous, manifest, library)
    current_boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    pending = read_json(RUNTIME_QUALIFICATION)
    if pending:
        if not isinstance(pending, dict) or pending.get("schema") != 1 \
                or pending.get("state") != "BOOT_QUALIFYING" \
                or pending.get("boot_id") != current_boot \
                or pending.get("kernel_release") != os.uname().release \
                or pending.get("previous_boot_id") is None:
            raise RuntimeError("boot requalification found an ambiguous pending transaction")
        assert_exact_installed_release(previous)
        predecessor = previous.get("boot_id") == pending.get("previous_boot_id")
        successor = previous.get("boot_id") == current_boot \
            and previous.get("qualification_txid") == pending.get("txid") \
            and previous.get("previous_boot_id") == pending.get("previous_boot_id")
        if predecessor:
            check = run([
                "/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
                "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
                "--runtime-qualification",
            ], timeout=1820)
            if check.returncode or "RUNTIME_QUALIFICATION_READY=YES" not in check.stdout:
                raise RuntimeError("direct post-reboot runtime qualification did not pass")
            if read_json(RUNTIME_QUALIFICATION) != pending \
                    or read_json(RUNTIME_RELEASE) != previous:
                raise RuntimeError("boot qualification CAS changed during read-only probes")
            promoted = dict(previous)
            promoted.update({
                "boot_id": current_boot,
                "kernel_release": os.uname().release,
                "verdict": "POST_REBOOT_GATE",
                "previous_boot_id": pending.get("previous_boot_id"),
                "qualification_txid": pending.get("txid"),
            })
            atomic_json(RUNTIME_RELEASE, promoted)
            previous = promoted
        elif not successor:
            raise RuntimeError("boot requalification found an ambiguous pending transaction")
        assert_exact_installed_release(previous)
        operational = run([
            "/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
            "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
            "--runtime-operational",
        ], timeout=1820)
        if operational.returncode or "UPGRADE_SAFE=YES" not in operational.stdout:
            raise RuntimeError("post-reboot PVE operational qualification did not pass")
        if read_json(RUNTIME_QUALIFICATION) != pending \
                or read_json(RUNTIME_RELEASE) != previous \
                or pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip() != current_boot \
                or os.uname().release != pending.get("kernel_release"):
            raise RuntimeError("boot qualification CAS changed during operational probes")
        assert_exact_installed_release(previous)
        assert_bound_runtime_tuple(previous, manifest, library)
        unlink_durable(RUNTIME_QUALIFICATION)
        print("RUNTIME_BOOT_REQUALIFICATION=PASS")
        print(f"PREVIOUS_BOOT_ID={previous.get('previous_boot_id')}")
        print(f"BOOT_ID={current_boot}")
        print(f"KERNEL_RELEASE={os.uname().release}")
        return
    if previous.get("boot_id") == current_boot:
        raise RuntimeError("boot requalification requires a changed boot identity")
    package, version = assert_exact_installed_release(previous)
    runtime_build_id = previous["runtime_build_id"]
    artifact = previous["artifact_sha256"]
    txid = secrets.token_hex(16)
    pending = {
        "schema": 1, "state": "BOOT_QUALIFYING", "txid": txid,
        "runtime_build_id": runtime_build_id, "artifact_sha256": artifact,
        "plan_digest": previous.get("plan_digest"), "boot_id": current_boot,
        "kernel_release": os.uname().release, "plugin_package": package,
        "plugin_version": version, "previous_boot_id": previous.get("boot_id"),
    }
    create_json(RUNTIME_QUALIFICATION, pending)
    check = run(["/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
                 "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
                 "--runtime-qualification"],
                timeout=1820)
    if check.returncode or "RUNTIME_QUALIFICATION_READY=YES" not in check.stdout:
        raise RuntimeError("direct post-reboot runtime qualification did not pass")
    if read_json(RUNTIME_QUALIFICATION) != pending:
        raise RuntimeError("boot qualification CAS changed during read-only probes")
    successor = dict(previous)
    successor.update({
        "boot_id": current_boot,
        "kernel_release": os.uname().release,
        "verdict": "POST_REBOOT_GATE",
        "previous_boot_id": previous.get("boot_id"),
        "qualification_txid": txid,
    })
    atomic_json(RUNTIME_RELEASE, successor)
    assert_exact_installed_release(successor)
    operational = run([
        "/usr/bin/timeout", "--foreground", "--kill-after=10", "1800",
        "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check",
        "--runtime-operational",
    ], timeout=1820)
    if operational.returncode or "UPGRADE_SAFE=YES" not in operational.stdout:
        raise RuntimeError("post-reboot PVE operational qualification did not pass")
    if read_json(RUNTIME_QUALIFICATION) != pending \
            or read_json(RUNTIME_RELEASE) != successor \
            or pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip() != current_boot \
            or os.uname().release != pending.get("kernel_release"):
        raise RuntimeError("boot qualification CAS changed during operational probes")
    assert_exact_installed_release(successor)
    assert_bound_runtime_tuple(successor, manifest, library)
    unlink_durable(RUNTIME_QUALIFICATION)
    print("RUNTIME_BOOT_REQUALIFICATION=PASS")
    print(f"PREVIOUS_BOOT_ID={previous.get('boot_id')}")
    print(f"BOOT_ID={current_boot}")
    print(f"KERNEL_RELEASE={os.uname().release}")


def command_recover(_args):
    """Refuse to infer zero effect from package versions after dispatch."""
    require_root()
    receipt = read_json(POST_GATE)
    if not receipt:
        raise RuntimeError("no post-update gate is pending")
    actions = receipt.get("actions")
    if not isinstance(actions, list) or not actions:
        raise RuntimeError("post-update receipt has no exact action set")
    # The receipt is created immediately before APT may dispatch dpkg.  After
    # that boundary, unchanged package versions and a clean dpkg audit cannot
    # prove that maintainer scripts, triggers, configure-only actions, or a
    # same-version reinstall had no external effect.  Keep the durable gate
    # open for explicit inspection/settlement; availability must not be bought
    # by inventing a zero-effect result from version equality.
    raise RuntimeError(
        "zero-effect recovery cannot be proven after dpkg dispatch became possible; "
        "post-update gate remains open and requires explicit recovery inspection"
    )


