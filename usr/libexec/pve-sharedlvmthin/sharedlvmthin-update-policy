            or release.get("qualification_txid") != args.txid:
        raise RuntimeError("FREEZE settlement requires a matching runtime latch/candidate; use explicit closed settlement for UNLISTED")

    def recheck_runtime_latch():
        if read_json(RUNTIME_QUALIFICATION) != pending or read_json(RUNTIME_RELEASE) != release:
            raise RuntimeError("FREEZE settlement runtime latch/candidate CAS changed")

    record = settle_freeze_package(args.package, args.version, args.sha256,
                                   args.txid, manifest, library, args.replacement_txid,
                                   before_release=recheck_runtime_latch)
    unlink_durable(AUTH)
    print("UPDATE_POLICY=FREEZE")
    print("FREEZE_BASELINE_ROTATED=YES")
    print("HELD=" + ",".join(record["hold_targets"]))


def assert_blocked_transition(receipt, pending, library):
    """Match the immutable PREPARED core through exact settlement prefixes."""
    prepared = pending.get("prepared_transition") if isinstance(pending, dict) else None
    if not isinstance(prepared, dict) or prepared.get("schema") != 2 \
            or prepared.get("state") != "PREPARED" \
            or pending.get("transition_sha256") != library.digest(prepared):
        raise RuntimeError("closed-runtime prepared transition identity is invalid")
    extensions = {"replacement_proof", "successor_ledger", "rotation_ledger_sha256",
                  "successor_generation", "successor_ledger_sha256"}
    if not isinstance(receipt, dict) or receipt.get("state") not in {
            "PREPARED", "SETTLEMENT_PREPARED", "COMPLETE"} \
            or set(receipt) - set(prepared) - extensions \
            or any(receipt.get(key) != value for key, value in prepared.items() if key != "state"):
        raise RuntimeError("closed-runtime package transition changed")
    return prepared


def completed_prepared_transition(receipt):
    """Recover only the immutable PREPARED prefix of an exact settlement."""
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") != "COMPLETE":
        raise RuntimeError("completed package settlement identity is missing")
    prepared = dict(receipt)
    if receipt.get("kind") == "DIRECT_PROFILE_GATE":
        extensions = {"runtime_release_sha256", "settled_policy_sha256",
                      "settled_freeze_sha256"}
    else:
        extensions = {"replacement_proof", "successor_ledger",
                      "rotation_ledger_sha256", "successor_generation",
                      "successor_ledger_sha256"}
    for key in extensions:
        prepared.pop(key, None)
    prepared["state"] = "PREPARED"
    return prepared


def recovery_file_digest(path, *, limit):
    """Pin a root-owned, single-link recovery input without following links."""
    path = pathlib.Path(path)
    if os.name != "posix" or not path.is_absolute() or ".." in path.parts:
        raise RuntimeError("recovery code input requires an absolute POSIX path")
    for parent in path.parents:
        entry = parent.lstat()
        sticky_tmp = str(parent) in {"/tmp", "/var/tmp"} and bool(entry.st_mode & stat.S_ISVTX)
        if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != 0 \
                or (entry.st_mode & 0o022 and not sticky_tmp):
            raise RuntimeError("unsafe recovery code ancestor")
    before = path.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1 \
            or before.st_mode & 0o022 or not 0 < before.st_size <= limit:
        raise RuntimeError("unsafe recovery code file")
    signature = lambda item: (item.st_dev, item.st_ino, item.st_mode, item.st_uid,
                              item.st_nlink, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    try:
        if signature(os.fstat(fd)) != signature(before):
            raise RuntimeError("recovery code inode changed")
        digest = hashlib.sha256()
        size = 0
        while True:
            chunk = os.read(fd, min(1024 * 1024, limit + 1 - size))
            if not chunk:
                break
            size += len(chunk)
            if size > limit:
                raise RuntimeError("recovery code size limit")
            digest.update(chunk)
        if size != before.st_size or signature(os.fstat(fd)) != signature(before) \
                or signature(path.lstat()) != signature(before):
            raise RuntimeError("recovery code changed during read")
        return digest.hexdigest()
    finally:
        os.close(fd)


def recovery_carrier_members(path):
    """Read a bounded, flat control archive; do not install or extract paths."""
    import resource
    limit = 8 * 1024 * 1024

    def restrict_output():
        resource.setrlimit(resource.RLIMIT_FSIZE, (limit, limit))

    wanted = {"control", "sharedlvmthin-candidate-update-policy", "sharedlvmthin_update_policy.py"}
    with tempfile.TemporaryFile() as archive_file, tempfile.TemporaryFile() as errors:
        result = subprocess.run(["/usr/bin/dpkg-deb", "--ctrl-tarfile", str(path)],
                                stdin=subprocess.DEVNULL, stdout=archive_file, stderr=errors,
                                timeout=30, check=False, preexec_fn=restrict_output,
                                env={"PATH": SAFE_PATH, "LC_ALL": "C", "LANG": "C"})
        errors.seek(0)
        if result.returncode or errors.read(1):
            raise RuntimeError("recovery code control archive inspection failed")
        archive_file.seek(0, os.SEEK_END)
        if not 0 < archive_file.tell() <= limit:
            raise RuntimeError("recovery control archive byte limit")
        archive_file.seek(0)
        found, seen = {}, set()
        with tarfile.open(fileobj=archive_file, mode="r:") as archive:
            for index, member in enumerate(archive, 1):
                if index > 128:
                    raise RuntimeError("recovery control archive member limit")
                if member.isdir() and member.name in {".", "./"}:
                    continue
                name = member.name.removeprefix("./")
                if not re.fullmatch(r"[A-Za-z0-9_.+-]+", name) or name in {".", ".."} \
                        or name in seen or not member.isfile() or not 0 <= member.size <= 4 * 1024 * 1024:
                    raise RuntimeError("unsafe or duplicate recovery control member")
                seen.add(name)
                if name in wanted:
                    with archive.extractfile(member) as stream:
                        raw = stream.read(member.size + 1)
                    if len(raw) != member.size:
                        raise RuntimeError("short recovery control member")
                    found[name] = raw
        if set(found) != wanted:
            raise RuntimeError("recovery code control archive is incomplete")
        return found


def recovery_executor_identity(args):
    """Carrier approves recovery CODE, never the installed target/tuple."""
    carrier = getattr(args, "recovery_code_deb", None)
    expected = getattr(args, "recovery_code_sha256", None)
    if not carrier and not expected:
        return None
    if not isinstance(carrier, str) or not isinstance(expected, str) \
            or not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise RuntimeError("recovery code carrier requires an independently approved SHA-256")
    carrier_digest = recovery_file_digest(carrier, limit=512 * 1024 * 1024)
    if carrier_digest != expected:
        raise RuntimeError("recovery code carrier SHA-256 mismatch")
    helper_digest = recovery_file_digest(__file__, limit=4 * 1024 * 1024)
    core_digest = recovery_file_digest(LIB, limit=4 * 1024 * 1024)
    members = recovery_carrier_members(carrier)
    if hashlib.sha256(members["sharedlvmthin-candidate-update-policy"]).hexdigest() != helper_digest \
            or hashlib.sha256(members["sharedlvmthin_update_policy.py"]).hexdigest() != core_digest:
        raise RuntimeError("executing recovery code differs from its approved carrier")
    try:
        control = members["control"].decode("utf-8")
    except UnicodeError as exc:
        raise RuntimeError("recovery code carrier control is not UTF-8") from exc
    fields = {}
    for key in ("Package", "Version", "Architecture"):
        values = re.findall(r"^" + key + r": ([^\r\n]+)$", control, re.MULTILINE)
        if len(values) != 1:
            raise RuntimeError("ambiguous recovery carrier package identity")
        fields[key] = values[0]
    if fields["Package"] != args.package or fields["Architecture"] != "all" \
            or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,128}", fields["Version"]):
        raise RuntimeError("recovery code carrier profile/architecture identity differs")
    if recovery_file_digest(carrier, limit=512 * 1024 * 1024) != carrier_digest \
            or recovery_file_digest(__file__, limit=4 * 1024 * 1024) != helper_digest \
            or recovery_file_digest(LIB, limit=4 * 1024 * 1024) != core_digest:
        raise RuntimeError("recovery executor changed during identity inspection")
    return {"schema": "sharedlvmthin-recovery-executor/v1",
            "carrier_sha256": carrier_digest, "carrier_package": fields["Package"],
            "carrier_version": fields["Version"], "carrier_architecture": fields["Architecture"],
            "helper_sha256": helper_digest, "core_sha256": core_digest}


def closed_runtime_release(pending):
    """The non-authorizing release paired with a durable closed latch."""
    keys = ("schema", "runtime_build_id", "artifact_sha256", "plan_digest", "boot_id",
            "kernel_release", "plugin_package", "plugin_version", "runtime_manifest_sha256",
            "runtime_identity_sha256", "transition_sha256")
    if not isinstance(pending, dict) or any(key not in pending for key in keys) \
            or pending.get("state") != "PACKAGE_SETTLED_RUNTIME_CLOSED" \
            or pending.get("authority") != "NONE" \
            or pending.get("reason") != "UNLISTED_RUNTIME_TUPLE":
        raise RuntimeError("closed runtime predecessor is incomplete")
    release = {key: pending[key] for key in keys}
    release.update(qualified="UNQUALIFIED", qualification_txid=pending.get("txid"),
                   verdict="PACKAGE_ONLY_SETTLEMENT", reason=pending["reason"])
    return release


def closed_runtime_successor(receipt, pending, library):
    """Admit one exact closed-to-closed edge, never an unrelated pending tx."""
    completed = read_json(LAST_PACKAGE_TRANSITION)
    old_prepared = assert_blocked_transition(completed, pending, library)
    freeze = read_json(FREEZE)
    release = read_json(RUNTIME_RELEASE)
    if completed.get("state") != "COMPLETE" or not isinstance(freeze, dict) \
            or freeze.get("phase") != "ACTIVE" \
            or library.digest(freeze) != completed.get("successor_ledger_sha256") \
            or freeze.get("generation") != completed.get("successor_generation") \
            or release != closed_runtime_release(pending):
        raise RuntimeError("closed successor requires exact completed predecessor and FREEZE baseline")
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") != "PREPARED" or "kind" in receipt \
            or receipt.get("txid") == pending.get("txid") \
            or pending.get("txid") != old_prepared.get("txid") \
            or receipt.get("parent_generation") != freeze.get("generation") \
            or receipt.get("parent_ledger_sha256") != library.digest(freeze) \
            or receipt.get("source_package") != old_prepared.get("target_package") \
            or receipt.get("source_version") != old_prepared.get("target_version") \
            or pending.get("plugin_package") != old_prepared.get("target_package") \
            or pending.get("plugin_version") != old_prepared.get("target_version") \
            or pending.get("artifact_sha256") != old_prepared.get("candidate_artifact_sha256") \
            or pending.get("plan_digest") != old_prepared.get("candidate_sha256") \
            or pending.get("runtime_manifest_sha256") != old_prepared.get("candidate_manifest_sha256") \
            or receipt.get("hostname") != old_prepared.get("hostname") \
            or receipt.get("boot_id") != old_prepared.get("boot_id") \
            or pending.get("boot_id") != old_prepared.get("boot_id"):
        raise RuntimeError("closed successor package transition is not the exact next edge")
    predecessor = {
        "qualification_sha256": library.digest(pending),
        "release_sha256": library.digest(release),
        "package_settlement_sha256": library.digest(completed),
        "freeze_ledger_sha256": library.digest(freeze),
        "txid": pending["txid"],
    }
    preimage = {"schema": 1, "qualification": pending, "release": release,
                "package_settlement": completed, "freeze_ledger": freeze}
    if len(json.dumps(preimage, sort_keys=True, separators=(",", ":")).encode()) > 1024 * 1024:
        raise RuntimeError("closed predecessor archive exceeds its bound")
    predecessor["preimage_sha256"] = library.digest(preimage)
    return predecessor, completed, freeze, release, preimage


def closed_profile_package_proof(txid, manifest, library):
    """Current package proof only; never infer runtime qualification/ancestry."""
    snapshot = {"policy": read_json(POLICY), "pending": read_json(RUNTIME_QUALIFICATION),
                "release": read_json(RUNTIME_RELEASE), "completed": read_json(LAST_PACKAGE_TRANSITION),
                "freeze": read_json(FREEZE), "active": read_json(PACKAGE_TRANSITION)}
    pending, completed, freeze = (snapshot[key] for key in ("pending", "completed", "freeze"))
    if not isinstance(snapshot["policy"], dict) or snapshot["policy"].get("mode") != "FREEZE" \
            or any(read_json(path, Ellipsis) is not Ellipsis for path in (POST_GATE, FREEZE_MIGRATION)) \
            or not isinstance(pending, dict) or pending.get("txid") != txid \
            or snapshot["release"] != closed_runtime_release(pending):
        raise RuntimeError("profile evidence closure requires exact durable runtime closure")
    prepared = assert_blocked_transition(completed, pending, library)
    if completed.get("state") != "COMPLETE" or not isinstance(freeze, dict) \
            or freeze.get("phase") != "ACTIVE" \
            or library.digest(freeze) != completed.get("successor_ledger_sha256") \
            or freeze.get("generation") != completed.get("successor_generation") \
            or freeze_integrity(freeze, manifest, library).get("result") != "PASS":
        raise RuntimeError("profile evidence closure requires exact COMPLETE and intact FREEZE")
    if snapshot["active"] is not None:
        # A later PREPARED may exist, but no part of it is consumed or changed.
        closed_runtime_successor(snapshot["active"], pending, library)
    package, version = prepared["target_package"], prepared["target_version"]
    opposite = next(name for name in PLUGIN_PACKAGES if name != package)
    rows = package_state_records([package])
    if prepared.get("txid") != txid or prepared.get("hostname") != os.uname().nodename \
            or prepared.get("boot_id") != pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip() \
            or pending.get("boot_id") != prepared.get("boot_id") \
            or pending.get("kernel_release") != os.uname().release \
            or package_version(package) != version or package_version(opposite) is not None \
            or len(rows) != 1 or rows[0].get("package") != package \
            or rows[0].get("version") != version or rows[0].get("status") != "installed" \
            or rows[0].get("architecture") != prepared.get("target_architecture") \
            or pending.get("plugin_package") != package or pending.get("plugin_version") != version \
            or pending.get("plan_digest") != prepared.get("candidate_sha256") \
            or pending.get("artifact_sha256") != prepared.get("candidate_artifact_sha256") \
            or exact_hex_identity(PACKAGE_ARTIFACT_FILE, "installed package artifact identity") != pending.get("artifact_sha256") \
            or exact_runtime_build_id() != pending.get("runtime_build_id") \
            or library.digest(manifest) != prepared.get("candidate_manifest_sha256") \
            or library.digest(manifest) != pending.get("runtime_manifest_sha256"):
        raise RuntimeError("profile evidence closure installed package proof changed")
    for argv in (["dpkg", "--audit"], ["dpkg", "--verify", package]):
        result = run(argv)
        if result.returncode or result.stdout.strip() or result.stderr.strip():
            raise RuntimeError("profile evidence closure requires clean package database/payload")
    return snapshot


def finalize_closed_profile_evidence(package_txid, replacement_txid, *, superseded=False):
    """Archive metadata only. Keep runtime latch and any next PREPARED intact."""
    if not all(isinstance(value, str) and re.fullmatch(r"[0-9a-f]{32}", value)
               for value in (package_txid, replacement_txid)):
        raise RuntimeError("profile evidence closure transaction identity is invalid")
    manifest, library = manifest_and_lib()
    snapshot = closed_profile_package_proof(package_txid, manifest, library)
    helper = load_profile_replacement()
    def recheck():
        current_manifest, _ = manifest_and_lib()
        if library.digest(current_manifest) != library.digest(manifest) \
                or closed_profile_package_proof(package_txid, manifest, library) != snapshot:
            raise RuntimeError("profile evidence closure package CAS changed")
    try:
        with helper.Locked():
            recheck()
            if not superseded:
                completed = snapshot["completed"]
                proof = replacement_proof(completed, replacement_txid, library)
                if proof is None or proof != completed.get("replacement_proof") \
                        or proof != snapshot["pending"].get("replacement_proof"):
                    raise RuntimeError("profile evidence closure is not bound to the completed package")
                reference = (read_json(helper.COMPLETE) or read_json(helper.DONE) or
                             read_json(helper.ARCHIVE / f"{replacement_txid}.json"))
                if helper.executor_is_alive(reference):
                    raise RuntimeError("profile evidence closure executor is still alive")
                # Refuse any foreign fragment before the existing finalizer's
                # cleanup; it must never remove another executor's evidence.
                for path, phase, extras in ((helper.READY, "READY", set()),
                        (helper.INTENT, "PRERM_INTENT", {"consumed"}),
                        (helper.DONE, "DPKG_DONE", {"consumed", "dpkg_completed", "dpkg_exit"})):
                    record = read_json(path)
                    if record is not None:
                        helper.validate_shape(record, phase, extras)
                        if record.get("txid") != replacement_txid:
                            raise RuntimeError("foreign profile replacement fragment blocks cleanup")
                        helper.same_transaction(record, reference)
                recheck()
                helper.finalize(argparse.Namespace(txid=replacement_txid,
                    target_package=completed["target_package"], target_version=completed["target_version"],
                    candidate_sha256=completed["candidate_sha256"], recovery=True))
                if replacement_proof(completed, replacement_txid, library) != proof:
                    raise RuntimeError("archived replacement proof changed")
            else:
                archive_superseded_profile_evidence(helper, replacement_txid, snapshot, library, recheck)
            recheck()
    except helper.Refusal as exc:
        raise RuntimeError(f"profile evidence closure refused: {exc}") from exc
    print("PROFILE_EVIDENCE_CLOSURE=SUPERSEDED_METADATA_ONLY" if superseded else
          "PROFILE_EVIDENCE_CLOSURE=EXACT_PACKAGE_COMPLETE")


def archive_superseded_profile_evidence(helper, txid, snapshot, library, recheck):
    """Not ancestry proof: archive stale successful dpkg metadata, no authority."""
    verdict = "SUPERSEDED_DPKG_EXIT_ZERO_RUNTIME_CLOSED"
    archive = helper.ARCHIVE / f"{txid}.json"
    normal_extras = {"consumed", "dpkg_completed", "dpkg_exit"}
    complete_extras = normal_extras | {"completed", "settlement", "metadata_cleanup_proof"}
    complete = read_json(helper.COMPLETE)
    archived = read_json(archive)
    if complete is not None and archived is not None:
        raise RuntimeError("ambiguous superseded cleanup completion")
    record = complete if complete is not None else archived if archived is not None else read_json(helper.DONE)
    if not isinstance(record, dict):
        raise RuntimeError("superseded cleanup requires exact successful DPKG_DONE")
    helper.validate_shape(record, "COMPLETE" if complete is not None or archived is not None else "DPKG_DONE",
                          complete_extras if complete is not None or archived is not None else normal_extras)
    if record.get("txid") != txid or type(record.get("dpkg_exit")) is not int or record["dpkg_exit"] != 0 \
            or type(record.get("consumed")) is not int or type(record.get("dpkg_completed")) is not int \
            or not record["created"] <= record["consumed"] <= record["dpkg_completed"]:
        raise RuntimeError("superseded cleanup dpkg identity/outcome differs")
    current = snapshot["completed"]
    active = snapshot["active"]
    if not isinstance(active, dict) or active.get("state") != "PREPARED" \
            or active.get("source_package") != current.get("target_package") \
            or active.get("source_version") != current.get("target_version") \
            or record.get("target_package") != current.get("target_package"):
        raise RuntimeError("superseded cleanup requires exact current-profile next PREPARED")
    comparison = run(["dpkg", "--compare-versions", current["target_version"], "ge", record["target_version"]])
    if comparison.returncode or comparison.stdout.strip() or comparison.stderr.strip():
        raise RuntimeError("superseded cleanup refuses downgrade or unavailable version ordering")
    if helper.executor_is_alive(record):
        raise RuntimeError("superseded cleanup executor is still alive")
    identity = {key: record[key] for key in (helper.BASE_KEYS - {"phase"}) | normal_extras}
    proof = {"authority": "NONE", "ancestry": "NOT_CLAIMED", "dpkg_done_sha256": library.digest(identity),
             "current_closed_package_txid": current["txid"], "next_prepared_txid": active["txid"],
             "package_state_sha256": library.digest(snapshot)}
    if complete is not None or archived is not None:
        if record.get("settlement") != verdict or record.get("metadata_cleanup_proof") != proof:
            raise RuntimeError("superseded cleanup receipt proof changed")
    for path, phase, extras in ((helper.INTENT, "PRERM_INTENT", {"consumed"}),
                               (helper.DONE, "DPKG_DONE", normal_extras),
                               (helper.READY, "READY", set())):
        fragment = read_json(path)
        if fragment is None:
            if complete is None and archived is None and path == helper.INTENT:
                raise RuntimeError("superseded DPKG_DONE requires exact consumed INTENT")
            continue
        helper.validate_shape(fragment, phase, extras)
        helper.same_transaction(fragment, record)
        if any(fragment.get(key) != record.get(key) for key in extras):
            raise RuntimeError("superseded cleanup fragment proof changed")
        if archived is not None:
            raise RuntimeError("archived superseded cleanup has unexpected active evidence")
    candidate = pathlib.Path(record["candidate"])
    if archived is not None:
        if os.path.lexists(candidate):
            raise RuntimeError("archived superseded cleanup has unexpected candidate")
        return
    if complete is None or os.path.lexists(candidate):
        helper.validate_candidate(record)
    recheck()
    if complete is None:
        complete = dict(record, phase="COMPLETE", completed=int(helper.time.time()),
                        settlement=verdict, metadata_cleanup_proof=proof)
        helper.write_create(helper.COMPLETE, complete)
    # Existing finalizer order/primitives, but a deliberately distinct receipt
    # which validate_complete/replacement_proof cannot accept as qualification.
    for path, mode in ((candidate, 0o400), (helper.INTENT, 0o600),
                       (helper.DONE, 0o600), (helper.READY, 0o600)):
        recheck()
        if os.path.lexists(path):
            helper.safe_regular(path, mode)
            path.unlink()
            helper.fsync_dir(helper.ROOT)
    recheck()
    if os.path.lexists(archive):
        raise RuntimeError("superseded cleanup archive already exists")
    os.replace(helper.COMPLETE, archive)
    helper.fsync_dir(helper.ARCHIVE)
    helper.fsync_dir(helper.ROOT)


def command_finalize_closed_profile_evidence(args):
