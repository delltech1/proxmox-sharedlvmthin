def exact_runtime_build_id(path=None):
    path = RUNTIME_BUILD_ID_FILE if path is None else path
    stat_result = path.lstat()
    if not path.is_file() or path.is_symlink() or stat_result.st_uid != 0 \
            or stat_result.st_mode & 0o022:
        raise RuntimeError("installed runtime build identity is unsafe")
    raw = path.read_text(encoding="ascii")
    if not re.fullmatch(r"[0-9a-f]{64}\n", raw):
        raise RuntimeError("installed runtime build identity is malformed")
    return raw[:-1]


def exact_hex_identity(path, label):
    stat_result = path.lstat()
    if not path.is_file() or path.is_symlink() or stat_result.st_uid != 0 \
            or stat_result.st_mode & 0o022:
        raise RuntimeError(f"{label} is unsafe")
    raw = path.read_text(encoding="ascii")
    if not re.fullmatch(r"[0-9a-f]{64}\n", raw):
        raise RuntimeError(f"{label} is malformed")
    return raw[:-1]


def maintenance_barrier_present(path=None):
    path = MAINTENANCE_ACTIVE if path is None else path
    try:
        stat_result = path.lstat()
    except FileNotFoundError:
        return False
    return path.is_file() and not path.is_symlink() and stat_result.st_uid == 0 \
        and not stat_result.st_mode & 0o022


def load_profile_replacement():
    path = "/usr/libexec/pve-sharedlvmthin/sharedlvmthin-profile-replacement"
    loader = importlib.machinery.SourceFileLoader("slt_freeze_replacement", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def replacement_proof(receipt, replacement_txid, library):
    """Bind cross-profile settlement to a successful exact dpkg executor."""
    if receipt["source_package"] == receipt["target_package"]:
        if replacement_txid:
            raise RuntimeError("same-profile settlement cannot consume replacement evidence")
        return None
    if not isinstance(replacement_txid, str) or len(replacement_txid) != 32 \
            or any(c not in "0123456789abcdef" for c in replacement_txid):
        raise RuntimeError("cross-profile settlement requires exact replacement txid")
    helper = load_profile_replacement()
    done = read_json(helper.DONE)
    extras = {"consumed", "dpkg_completed", "dpkg_exit"}
    if done is not None:
        helper.validate_shape(done, "DPKG_DONE", extras)
        intent = read_json(helper.INTENT)
        if not isinstance(intent, dict):
            raise RuntimeError("replacement DPKG_DONE has no consumed PRERM_INTENT")
        helper.validate_shape(intent, "PRERM_INTENT", {"consumed"})
        helper.same_transaction(intent, done)
        if done["consumed"] != intent["consumed"]:
            raise RuntimeError("replacement consumed identity changed")
    else:
        # A completed replay may run after the replacement journal was archived.
        done = read_json(helper.ARCHIVE / f"{replacement_txid}.json")
        if not isinstance(done, dict):
            raise RuntimeError("cross-profile settlement has no DPKG_DONE proof")
        helper.validate_complete(done)
        if done.get("settlement") != "DPKG_EXIT_ZERO":
            raise RuntimeError("recovered target alone is not successful DPKG_DONE proof")
    expected = {"txid": replacement_txid, "host": receipt["hostname"],
                "boot_id": receipt["boot_id"], "source_package": receipt["source_package"],
                "source_version": receipt["source_version"],
                "target_package": receipt["target_package"],
                "target_version": receipt["target_version"],
                "candidate_sha256": receipt["candidate_sha256"]}
    if any(done.get(key) != value for key, value in expected.items()) \
            or type(done.get("dpkg_exit")) is not int or done["dpkg_exit"] != 0:
        raise RuntimeError("replacement DPKG_DONE does not match the exact FREEZE transaction")
    identity = {key: done[key] for key in (helper.BASE_KEYS - {"phase"}) | extras}
    return {"txid": replacement_txid, "dpkg_done_sha256": library.digest(identity)}


def load_library(path=LIB):
    spec = importlib.util.spec_from_file_location("slt_update_policy", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def run(argv, *, input_text=None, env=None, timeout=60):
    child_env = {"PATH": SAFE_PATH, "LC_ALL": "C", "LANG": "C"}
    if env:
        child_env.update(env)
    return subprocess.run(argv, input=input_text, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=False, timeout=timeout, env=child_env)


def require_root():
    if os.geteuid() != 0:
        raise SystemExit("This command must run as root")


def secure_state_dir(root=None):
    root = STATE if root is None else root
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = root.lstat()
    if not root.is_dir() or root.is_symlink() or info.st_uid != 0 or info.st_mode & 0o077:
        raise RuntimeError(f"unsafe update-policy state directory: {root}")


def atomic_json(path, value):
    secure_state_dir(path.parent)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def unlink_durable(path):
    try:
        path.unlink()
    except FileNotFoundError:
        return
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def create_json(path, value):
    """Create one durable state record without replacing an existing intent."""
    secure_state_dir(path.parent)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                         os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        raise
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def read_json(path, default=None):
    try:
        info = path.lstat()
        if path.is_symlink() or not path.is_file() or info.st_uid != 0 or info.st_mode & 0o077:
            raise RuntimeError(f"unsafe state file: {path}")
        with path.open(encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default


def manifest_and_lib():
    library = load_library()
    return library.strict_json(MANIFEST), library


@contextlib.contextmanager
def policy_lock(exclusive=True):
    secure_state_dir()
    descriptor = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(descriptor)
        if info.st_uid != 0 or info.st_mode & 0o077:
            raise RuntimeError("unsafe update-policy lock file")
        operation = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
        try:
            fcntl.flock(descriptor, operation | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("another update-policy operation is active") from exc
        yield
    finally:
        os.close(descriptor)


def installed_packages():
    result = run(["dpkg-query", "-W", "-f=${Package}|${db:Status-Status}\n"])
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "dpkg-query failed")
    return [line.split("|", 1)[0] for line in result.stdout.splitlines()
            if line.endswith("|installed")]


def package_state_records(targets):
    """Return exact dpkg state for each frozen base-package name."""
    wanted = set(targets)
    result = run(["dpkg-query", "-W", "-f=${Package}|${binary:Package}|${Version}|"
                  "${Architecture}|${db:Status-Status}\n"])
    # dpkg-query may return 1 when unrelated requested patterns are absent, but
    # this unfiltered inventory has to succeed completely.
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "dpkg-query state inventory failed")
    records = []
    seen = set()
    for line in result.stdout.splitlines():
        fields = line.split("|")
        if len(fields) != 5 or fields[0] not in wanted:
            continue
        name, binary, version, architecture, status = fields
        if name in seen:
            raise RuntimeError(f"ambiguous multiarch package state for {name}")
        seen.add(name)
        records.append({"package": name, "binary": binary, "version": version,
                        "architecture": architecture, "status": status})
    missing = sorted(wanted - seen)
    if missing:
        raise RuntimeError("frozen package disappeared from dpkg inventory: " + ",".join(missing))
    return sorted(records, key=lambda row: row["package"])


def watched_state(manifest, library):
    """Return the exact installed dpkg identity of every watched package."""
    targets = []
    for name in installed_packages():
        if library.watched({"package": name}, manifest):
            targets.append(name)
    return package_state_records(sorted(set(targets)))


def authorization_context(manifest, library, policy):
    records = watched_state(manifest, library)
    value = {
        "schema": 1,
        "node": os.uname().nodename,
        "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "manifest_sha256": library.digest(manifest),
        "policy_sha256": library.digest(policy),
        "watched_state": records,
    }
    value["context_sha256"] = library.digest(value)
    return value


PLUGIN_PACKAGES = {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"}


def freeze_baseline_targets(record):
    return record.get("targets", []) if record.get("schema") == 2 \
        else record.get("baseline_targets", [])


def freeze_hold_targets(record):
    return record.get("targets", []) if record.get("schema") == 2 \
        else record.get("hold_targets", [])


def freeze_required_holds(record):
    required = set(freeze_hold_targets(record))
    if record.get("schema") == 3:
        required.update(record.get("preexisting", []))
    return required


def freeze_integrity_v2(freeze, manifest, library):
    reasons = []
    missing_holds = []
    if not isinstance(freeze, dict) or freeze.get("schema") != 2 or freeze.get("phase") != "ACTIVE":
        return {"result": "FAIL_LEDGER", "reasons": ["ledger schema or phase is invalid"],
                "missing_holds": []}
    targets = freeze.get("targets")
    owned = freeze.get("owned")
    preexisting = freeze.get("preexisting")
    baseline = freeze.get("baseline")
    if not all(isinstance(value, list) for value in (targets, owned, preexisting, baseline)):
        return {"result": "FAIL_LEDGER", "reasons": ["ledger collections are invalid"],
                "missing_holds": []}
    if targets != sorted(set(targets)) or owned != sorted(set(owned)) \
            or preexisting != sorted(set(preexisting)):
        reasons.append("ledger package sets are not canonical")
    if set(owned) & set(preexisting) or set(owned) | set(preexisting) != set(targets):
        reasons.append("owned and preexisting holds do not exactly partition targets")
    current_targets = watched_installed(manifest, library)
    if current_targets != targets:
        reasons.append("watched installed package inventory changed")
    if freeze.get("manifest_sha256") != library.digest(manifest):
        reasons.append("qualified-tuple manifest changed")
    generation = freeze.get("generation")
    if not isinstance(generation, str) or len(generation) != 32 \
            or any(char not in "0123456789abcdef" for char in generation):
        reasons.append("freeze generation is invalid")
    try:
        current = package_state_records(targets)
    except RuntimeError as exc:
        current = None
        reasons.append(str(exc))
    if current is not None and current != baseline:
        reasons.append("frozen package version, architecture or dpkg state changed")
    if reasons:
        return {"result": "FAIL_PACKAGE_BASELINE_DRIFT", "reasons": reasons,
                "missing_holds": []}
    missing_holds = sorted(set(targets) - held_packages())
    return {"result": "FAIL_MISSING_HOLD" if missing_holds else "PASS",
            "reasons": [], "missing_holds": missing_holds}


def freeze_integrity_v3(freeze, manifest, library):
    reasons = []
    if not isinstance(freeze, dict) or freeze.get("schema") != 3 \
            or freeze.get("phase") != "ACTIVE":
        return {"result": "FAIL_LEDGER", "reasons": ["ledger schema or phase is invalid"],
                "missing_holds": []}
    baseline_targets = freeze.get("baseline_targets")
    hold_targets = freeze.get("hold_targets")
    owned = freeze.get("owned")
    preexisting = freeze.get("preexisting")
    baseline = freeze.get("baseline")
    collections = (baseline_targets, hold_targets, owned, preexisting, baseline)
    if not all(isinstance(value, list) for value in collections):
        return {"result": "FAIL_LEDGER", "reasons": ["ledger collections are invalid"],
                "missing_holds": []}
    for name, value in (("baseline_targets", baseline_targets),
                        ("hold_targets", hold_targets), ("owned", owned),
                        ("preexisting", preexisting)):
        if value != sorted(set(value)):
            reasons.append(f"{name} is not canonical")
    expected_hold_targets = sorted(set(baseline_targets) - PLUGIN_PACKAGES)
    if hold_targets != expected_hold_targets:
        reasons.append("hold targets do not equal non-plugin baseline targets")
    if set(owned) & set(preexisting) \
            or set(owned) | (set(preexisting) & set(hold_targets)) != set(hold_targets):
        reasons.append("owned and preexisting holds do not exactly partition hold targets")
    if set(preexisting) - set(baseline_targets):
        reasons.append("preexisting hold is absent from baseline targets")
    current_targets = watched_installed(manifest, library)
    if current_targets != baseline_targets:
        reasons.append("watched installed package inventory changed")
    if freeze.get("manifest_sha256") != library.digest(manifest):
        reasons.append("qualified-tuple manifest changed")
    generation = freeze.get("generation")
    if not isinstance(generation, str) or len(generation) != 32 \
            or any(char not in "0123456789abcdef" for char in generation):
        reasons.append("freeze generation is invalid")
    try:
        current = package_state_records(baseline_targets)
    except RuntimeError as exc:
        current = None
        reasons.append(str(exc))
    if current is not None and current != baseline:
        reasons.append("frozen package version, architecture or dpkg state changed")
    if reasons:
        return {"result": "FAIL_PACKAGE_BASELINE_DRIFT", "reasons": reasons,
                "missing_holds": []}
    required_holds = set(hold_targets) | set(preexisting)
    missing_holds = sorted(required_holds - held_packages())
    return {"result": "FAIL_MISSING_HOLD" if missing_holds else "PASS",
            "reasons": [], "missing_holds": missing_holds}


def freeze_integrity(freeze, manifest, library):
    if isinstance(freeze, dict) and freeze.get("schema") == 2:
        return freeze_integrity_v2(freeze, manifest, library)
    return freeze_integrity_v3(freeze, manifest, library)


def held_packages():
    result = run(["apt-mark", "showhold"])
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "apt-mark showhold failed")
    return set(result.stdout.splitlines())


def watched_installed(manifest, library):
    return sorted({name for name in installed_packages()
                   if library.watched({"package": name}, manifest)})


def apt_mark(operation, packages):
    if not packages:
        return
    result = run(["apt-mark", operation, *packages])
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"apt-mark {operation} failed")


def release_holds(packages):
    """Release owned selections without asking APT to resolve an absent package.

    ``apt-mark unhold`` refuses a package that has neither an installed nor an
    available version.  That exact state is normal after an authorized
    cross-profile replacement: dpkg has removed the source profile while its
    old ``hold`` selection can remain.  Installed packages still go through
    apt-mark.  An absent package is returned to dpkg's non-installing
    ``deinstall`` selection directly, then the caller verifies the complete
    hold set before publishing the successor ledger.
    """
    packages = sorted(set(packages))
    if not packages:
        return
    installed = [name for name in packages if package_version(name) is not None]
    absent = [name for name in packages if name not in installed]
    apt_mark("unhold", installed)
    if absent:
        if any(not name or any(char not in "abcdefghijklmnopqrstuvwxyz0123456789+-."
                               for char in name) for name in absent):
            raise RuntimeError("invalid package identity in absent hold release")
        selections = "".join(f"{name} deinstall\n" for name in absent)
        result = run(["dpkg", "--set-selections"], input_text=selections)
        if result.returncode:
            raise RuntimeError(result.stderr.strip()
                               or "dpkg absent hold release failed")


def enter_freeze(manifest, library):
    baseline_targets = watched_installed(manifest, library)
    hold_targets = sorted(set(baseline_targets) - PLUGIN_PACKAGES)
    existing = read_json(FREEZE)
    if existing:
        if existing.get("schema") != 3 or existing.get("phase") not in {"PREPARED", "ACTIVE"}:
            if existing.get("schema") == 2 and existing.get("phase") == "ACTIVE":
                raise RuntimeError("schema-2 FREEZE requires explicit migrate-freeze-schema")
            raise RuntimeError("unknown existing FREEZE transaction phase")
        recorded_baseline = sorted({library.base_package(name)
                                    for name in existing.get("baseline_targets", [])})
        recorded_holds = sorted({library.base_package(name)
                                 for name in existing.get("hold_targets", [])})
        recorded_owned = sorted({library.base_package(name)
                                 for name in existing.get("owned", [])})
        if recorded_baseline != baseline_targets or recorded_holds != hold_targets:
            raise RuntimeError("watched package inventory changed during FREEZE activation")
        expected = dict(existing)
        expected["phase"] = "ACTIVE"
        check = freeze_integrity(expected, manifest, library)
        if check["result"] not in {"PASS", "FAIL_MISSING_HOLD"}:
            raise RuntimeError("FREEZE baseline drift; holds were not repaired: "
                               + "; ".join(check["reasons"]))
        required = set(hold_targets) | set(existing.get("preexisting", []))
        apt_mark("hold", sorted(set(hold_targets) - held_packages()))
        if not required.issubset(held_packages()):
            raise RuntimeError("FREEZE recovery failed; not every watched package is held")
        existing.update({"phase": "ACTIVE", "baseline_targets": baseline_targets,
                         "hold_targets": hold_targets, "owned": recorded_owned,
                         "preexisting": sorted({library.base_package(name)
                                                for name in existing.get("preexisting", [])})})
        atomic_json(FREEZE, existing)
        return existing
    before = held_packages()
    owned = sorted(set(hold_targets) - before)
    record = {"schema": 3, "phase": "PREPARED", "generation": secrets.token_hex(16),
              "manifest_sha256": library.digest(manifest),
              "baseline_targets": baseline_targets, "hold_targets": hold_targets,
              "baseline": package_state_records(baseline_targets),
              "preexisting": sorted(before & set(baseline_targets)), "owned": owned}
    atomic_json(FREEZE, record)
    apt_mark("hold", owned)
    after = held_packages()
    required = set(hold_targets) | set(record["preexisting"])
    if not required.issubset(after):
        raise RuntimeError("FREEZE verification failed; not every watched package is held")
    record["phase"] = "ACTIVE"
    atomic_json(FREEZE, record)
    return record


def leave_freeze():
    record = read_json(FREEZE)
    if not record:
        return []
    owned = set(record.get("owned", []))
    current = held_packages()
    release = sorted(owned & current)
    release_holds(release)
    if owned & held_packages():
        raise RuntimeError("could not release every BASTRIX-owned hold")
    unlink_durable(FREEZE)
    return release


def migrate_freeze_schema(manifest, library):
    """Crash-safe schema-2 to schema-3 split of baseline and hold targets."""
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists():
        raise RuntimeError("FREEZE schema migration refused while another update transaction is pending")
    replacement_root = pathlib.Path("/var/lib/pve-sharedlvmthin/profile-replacement")
    if any((replacement_root / name).exists()
           for name in ("ready.json", "prerm-intent.json", "dpkg-done.json")):
        raise RuntimeError("FREEZE schema migration refused while profile replacement is pending")
    record = read_json(FREEZE)
    receipt = read_json(FREEZE_MIGRATION)
    if isinstance(record, dict) and record.get("schema") == 3 \
            and record.get("phase") == "ACTIVE":
        if receipt:
            if receipt.get("state") != "PREPARED" \
                    or receipt.get("successor") != record:
                raise RuntimeError("completed FREEZE migration receipt differs from ACTIVE ledger")
            check = freeze_integrity_v3(record, manifest, library)
            if check["result"] != "PASS":
                raise RuntimeError("schema-3 FREEZE integrity is not intact; "
                                   "pending migration evidence was preserved")
            completed = dict(receipt)
            completed["state"] = "COMPLETE"
            atomic_json(LAST_FREEZE_MIGRATION, completed)
            unlink_durable(FREEZE_MIGRATION)
        check = freeze_integrity_v3(record, manifest, library)
        if check["result"] != "PASS":
            raise RuntimeError("schema-3 FREEZE integrity is not intact")
        return record

    if isinstance(record, dict) and record.get("schema") == 2 \
            and record.get("phase") == "ACTIVE":
        check = freeze_integrity_v2(record, manifest, library)
        if check["result"] != "PASS":
            raise RuntimeError("schema-2 FREEZE migration requires an intact ACTIVE baseline")
        baseline_targets = record["targets"]
        hold_targets = sorted(set(baseline_targets) - PLUGIN_PACKAGES)
        old_owned = set(record["owned"])
        old_preexisting = set(record["preexisting"])
        if receipt:
            if receipt.get("schema") != 1 or receipt.get("state") != "PREPARED" \
                    or receipt.get("parent_generation") != record["generation"] \
                    or receipt.get("parent_sha256") != library.digest(record):
                raise RuntimeError("a different FREEZE schema migration is pending")
        else:
            successor = {
                "schema": 3, "phase": "ACTIVE", "generation": secrets.token_hex(16),
                "previous_generation": record["generation"],
                "manifest_sha256": record["manifest_sha256"],
                "baseline_targets": baseline_targets, "hold_targets": hold_targets,
                "baseline": record["baseline"],
                "owned": sorted(old_owned & set(hold_targets)),
                "preexisting": sorted(old_preexisting),
            }
            proposed = {
                "schema": 1, "state": "PREPARED", "txid": secrets.token_hex(16),
                "parent_generation": record["generation"],
                "parent_sha256": library.digest(record),
                "manifest_sha256": record["manifest_sha256"],
                "observed_holds": sorted(held_packages()),
                "release_owned": sorted(old_owned & PLUGIN_PACKAGES),
                "successor": successor,
                "successor_sha256": library.digest(successor),
            }
            create_json(FREEZE_MIGRATION, proposed)
            receipt = proposed
        successor = receipt.get("successor")
        if not isinstance(successor, dict) \
                or receipt.get("successor_sha256") != library.digest(successor):
            raise RuntimeError("FREEZE migration successor identity is invalid")
        migrating = dict(successor)
        migrating["phase"] = "MIGRATING"
        migrating["migration_txid"] = receipt["txid"]
        atomic_json(FREEZE, migrating)
        record = migrating
    elif isinstance(record, dict) and record.get("schema") == 3 \
            and record.get("phase") == "MIGRATING":
        if not isinstance(receipt, dict) or receipt.get("state") != "PREPARED" \
                or record.get("migration_txid") != receipt.get("txid"):
            raise RuntimeError("FREEZE migration has no exact durable receipt")
        expected = dict(receipt.get("successor", {}))
        observed = dict(record)
        observed["phase"] = "ACTIVE"
        observed.pop("migration_txid", None)
        if observed != expected:
            raise RuntimeError("FREEZE migrating ledger differs from pinned successor")
    else:
        raise RuntimeError("FREEZE schema migration requires ACTIVE schema-2 or replayable schema-3 state")

    successor = receipt["successor"]
    if read_json(FREEZE) != record or read_json(FREEZE_MIGRATION) != receipt:
        raise RuntimeError("FREEZE migration CAS changed before hold reconciliation")
    if library.digest(manifest) != successor.get("manifest_sha256") \
            or watched_installed(manifest, library) != successor.get("baseline_targets") \
            or package_state_records(successor["baseline_targets"]) != successor.get("baseline"):
        raise RuntimeError("FREEZE migration baseline changed before hold reconciliation")
    before_holds = held_packages()
    expected_before = set(receipt.get("observed_holds", []))
    release_set = set(receipt.get("release_owned", []))
    if before_holds not in (expected_before, expected_before - release_set):
        raise RuntimeError("FREEZE migration observed an unknown hold delta")
    release = sorted(set(receipt.get("release_owned", [])) & held_packages())
    release_holds(release)
    if read_json(FREEZE) != record or read_json(FREEZE_MIGRATION) != receipt:
        raise RuntimeError("FREEZE migration CAS changed during hold reconciliation")
    if library.digest(manifest) != successor.get("manifest_sha256") \
            or watched_installed(manifest, library) != successor.get("baseline_targets") \
            or package_state_records(successor["baseline_targets"]) != successor.get("baseline"):
        raise RuntimeError("FREEZE migration baseline changed during hold reconciliation")
    final_holds = held_packages()
    if final_holds != expected_before - release_set:
        raise RuntimeError("FREEZE migration hold result differs from exact expected delta")
    required = set(successor["hold_targets"]) | set(successor["preexisting"])
    if not required.issubset(final_holds):
        raise RuntimeError("FREEZE migration lost a required upstream or administrator hold")
    atomic_json(FREEZE, successor)
    completed = dict(receipt)
    completed["state"] = "COMPLETE"
    atomic_json(LAST_FREEZE_MIGRATION, completed)
    unlink_durable(FREEZE_MIGRATION)
    return successor


def prepare_freeze_package(source_package, source_version, target_package,
                           target_version, target_architecture, candidate_sha256,
                           candidate_manifest_path, manifest, library,
                           candidate_artifact_sha256=None):
    allowed = {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"}
    if FREEZE_MIGRATION.exists():
        raise RuntimeError("FREEZE prepare refused while schema migration is pending")
    if source_package not in allowed or target_package not in allowed:
        raise RuntimeError("FREEZE prepare requires exact plugin package identities")
    if len(candidate_sha256) != 64 or any(c not in "0123456789abcdef"
                                           for c in candidate_sha256.lower()):
        raise RuntimeError("candidate SHA-256 is invalid")
    candidate_artifact_sha256 = candidate_artifact_sha256 or candidate_sha256
    if len(candidate_artifact_sha256) != 64 or any(
            c not in "0123456789abcdef"
            for c in candidate_artifact_sha256.lower()):
        raise RuntimeError("candidate artifact SHA-256 is invalid")
    if package_version(source_package) != source_version:
        raise RuntimeError("FREEZE prepare source package/version is not installed")
    if package_version(allowed.difference({source_package}).pop()) is not None:
        raise RuntimeError("FREEZE prepare found both package profiles installed")
    record = read_json(FREEZE)
    check = freeze_integrity(record, manifest, library)
    if check["result"] != "PASS":
        raise RuntimeError("FREEZE prepare requires an intact ACTIVE baseline")
    source_admin_held = (source_package in record.get("preexisting", [])
                         if record.get("schema") == 2
                         else source_package in held_packages())
    if source_package != target_package and source_admin_held:
        raise RuntimeError("cross-profile replacement cannot discard an administrator-held source")
    candidate_manifest = library.strict_json(candidate_manifest_path)
    receipt = {
        "schema": 2, "state": "PREPARED", "txid": secrets.token_hex(16),
        "hostname": os.uname().nodename,
        "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "parent_generation": record["generation"],
        "parent_ledger_sha256": library.digest(record),
        "source_package": source_package, "source_version": source_version,
        "target_package": target_package, "target_version": target_version,
        "target_architecture": target_architecture,
        "candidate_sha256": candidate_sha256.lower(),
        "candidate_artifact_sha256": candidate_artifact_sha256.lower(),
        "candidate_manifest_sha256": library.digest(candidate_manifest),
    }
    existing = read_json(PACKAGE_TRANSITION)
    if existing:
        comparable = dict(existing)
        comparable.pop("txid", None)
        proposed = dict(receipt)
        proposed.pop("txid", None)
        if existing.get("state") != "PREPARED" or comparable != proposed:
            raise RuntimeError("a different package baseline transition is pending")
        return existing
    create_json(PACKAGE_TRANSITION, receipt)
    return receipt


def settle_freeze_package(package, version, candidate_sha256, txid,
                          manifest, library, replacement_txid=None):
    """Rotate an existing FREEZE baseline after one exact package transaction.

    Ordinary ``select freeze`` deliberately refuses any package or manifest
    drift.  The package-profile gate needs one narrower settlement path after
    it has installed and verified an exact local candidate.  Only the plugin
    profile package may differ; every other watched package must still match
    the old immutable baseline byte-for-byte at the dpkg-state level.

    The ROTATING ledger is written before apt selections are reconciled.  A
    crash therefore remains fail-closed and this same exact command can finish
    the idempotent hold transition later.
    """
    if FREEZE_MIGRATION.exists():
        raise RuntimeError("FREEZE settlement refused while schema migration is pending")
    if package not in {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"}:
        raise RuntimeError("FREEZE settlement requires an exact plugin package")
    if not version or package_version(package) != version:
        raise RuntimeError("FREEZE settlement target package/version is not installed")
    opposite = "pve-sharedlvmthin-thick" if package == "pve-sharedlvmthin" \
        else "pve-sharedlvmthin"
    if package_version(opposite) is not None:
        raise RuntimeError("FREEZE settlement found both package profiles installed")

    receipt = read_json(PACKAGE_TRANSITION)
    completed_retry = receipt is None
    if completed_retry:
        receipt = read_json(LAST_PACKAGE_TRANSITION)
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") not in ({"COMPLETE"} if completed_retry else
                                           {"PREPARED", "SETTLEMENT_PREPARED"}):
        raise RuntimeError("FREEZE settlement has no exact prepared transaction")
    if receipt.get("txid") != txid or receipt.get("target_package") != package \
            or receipt.get("target_version") != version \
            or receipt.get("candidate_sha256") != candidate_sha256.lower():
        raise RuntimeError("FREEZE settlement transaction identity changed")
    if receipt.get("hostname") != os.uname().nodename:
        raise RuntimeError("FREEZE settlement node identity changed")
    if receipt.get("candidate_manifest_sha256") != library.digest(manifest):
        raise RuntimeError("installed qualification manifest differs from prepared candidate")
    record = read_json(FREEZE)
    if not isinstance(record, dict) or record.get("schema") not in {2, 3}:
        raise RuntimeError("FREEZE settlement requires a supported ledger")
    source_admin_held = (receipt.get("source_package") in record.get("preexisting", [])
                         if record.get("schema") == 2
                         else receipt.get("source_package") in held_packages())
    if receipt.get("source_package") != package and source_admin_held:
        raise RuntimeError("cross-profile replacement cannot discard an administrator-held source")
    proof = replacement_proof(receipt, replacement_txid, library)
    if receipt.get("state") != "PREPARED" and receipt.get("replacement_proof") != proof:
        raise RuntimeError("prepared replacement proof changed")
    current_targets = watched_installed(manifest, library)
    current_baseline = package_state_records(current_targets)
    current_by_name = {row["package"]: row for row in current_baseline}
    target_record = current_by_name.get(package)
    if not target_record or target_record.get("version") != version \
            or target_record.get("architecture") != receipt.get("target_architecture") \
            or target_record.get("status") != "installed":
        raise RuntimeError("FREEZE settlement target package state differs from prepared identity")

    # The successor is recorded durably before replacing the parent ledger.
    # A crash after publishing ACTIVE must finish this exact receipt, not try
    # to authorize a second rotation against a now-obsolete parent generation.
    successor = receipt.get("successor_ledger")
    if completed_retry or (record.get("phase") == "ACTIVE" and successor == record):
        expected_digest = (receipt.get("successor_ledger_sha256") if completed_retry
                           else library.digest(successor))
        if record.get("settlement_txid") != txid \
                or library.digest(record) != expected_digest \
                or freeze_baseline_targets(record) != current_targets \
                or record.get("baseline") != current_baseline \
                or record.get("manifest_sha256") != library.digest(manifest):
            raise RuntimeError("completed FREEZE settlement no longer matches its exact successor")
        check = freeze_integrity(record, manifest, library)
        if check["result"] != "PASS":
            raise RuntimeError("completed FREEZE settlement integrity is not intact")
        if not completed_retry:
            completed = dict(receipt)
            completed.update(state="COMPLETE", successor_generation=record["generation"],
                             successor_ledger_sha256=library.digest(record))
            atomic_json(LAST_PACKAGE_TRANSITION, completed)
            unlink_durable(PACKAGE_TRANSITION)
        return record

    if record.get("phase") == "ROTATING":
        rotation = record.get("rotation")
        if not isinstance(rotation, dict) \
                or rotation.get("txid") != txid \
                or rotation.get("package") != package \
                or rotation.get("version") != version:
            raise RuntimeError("a different FREEZE package rotation is pending")
        if freeze_baseline_targets(record) != current_targets \
                or record.get("baseline") != current_baseline \
                or record.get("manifest_sha256") != library.digest(manifest):
            raise RuntimeError("pending FREEZE rotation no longer matches installed state")
        expected_successor = dict(record)
        expected_successor["phase"] = "ACTIVE"
        expected_successor.pop("rotation", None)
        if receipt.get("state") != "SETTLEMENT_PREPARED" \
                or receipt.get("successor_ledger") != expected_successor \
                or receipt.get("rotation_ledger_sha256") != library.digest(record):
            raise RuntimeError("pending FREEZE rotation differs from its prepared CAS identity")
    elif record.get("phase") == "ACTIVE":
        if record.get("generation") != receipt.get("parent_generation") \
                or library.digest(record) != receipt.get("parent_ledger_sha256"):
            raise RuntimeError("FREEZE settlement parent generation changed")
        old_targets = freeze_baseline_targets(record)
        old_hold_targets = freeze_hold_targets(record)
        old_baseline = record.get("baseline")
        old_owned = record.get("owned")
        old_preexisting = record.get("preexisting")
        if not all(isinstance(value, list) for value in
                   (old_targets, old_hold_targets, old_baseline,
                    old_owned, old_preexisting)):
            raise RuntimeError("existing FREEZE ledger collections are invalid")
        source_admin_held = (receipt.get("source_package") in old_preexisting
                             if record.get("schema") == 2
                             else receipt.get("source_package") in held_packages())
        if receipt.get("source_package") != package and source_admin_held:
            raise RuntimeError("cross-profile replacement cannot discard an administrator-held source")
        old_by_name = {row.get("package"): row for row in old_baseline
                       if isinstance(row, dict) and row.get("package")}
        if len(old_by_name) != len(old_baseline):
            raise RuntimeError("existing FREEZE baseline is ambiguous")
        allowed = {package, opposite}
        changed = {name for name in set(old_by_name) | set(current_by_name)
                   if old_by_name.get(name) != current_by_name.get(name)}
        if not changed.issubset(allowed) or (changed and package not in changed):
            raise RuntimeError("FREEZE settlement found drift outside the exact plugin profile")
        if any(name not in allowed and old_by_name.get(name) != current_by_name.get(name)
               for name in set(old_by_name) | set(current_by_name)):
            raise RuntimeError("non-plugin frozen package state changed")

        holds = held_packages()
        old_owned_set = set(old_owned)
        old_preexisting_set = set(old_preexisting)
        current_hold_targets = sorted(set(current_targets) - PLUGIN_PACKAGES)
        common_holds = set(old_hold_targets) & set(current_hold_targets)
        added_holds = set(current_hold_targets) - set(old_hold_targets)
        removed_owned = old_owned_set - set(current_hold_targets)
        new_owned = (old_owned_set & common_holds) \
            | {name for name in added_holds if name not in holds}
        new_preexisting = ((old_preexisting_set & set(current_hold_targets))
                           | (added_holds & holds)
                           | (old_preexisting_set & PLUGIN_PACKAGES))
        if new_owned & new_preexisting \
                or new_owned | (new_preexisting & set(current_hold_targets)) \
                != set(current_hold_targets):
            raise RuntimeError("FREEZE settlement cannot preserve hold ownership")
        record = {
            "schema": 3,
            "phase": "ROTATING",
            "generation": (successor["generation"] if isinstance(successor, dict)
                           and receipt.get("state") == "SETTLEMENT_PREPARED"
                           else secrets.token_hex(16)),
            "previous_generation": record.get("generation"),
            "manifest_sha256": library.digest(manifest),
            "baseline_targets": current_targets,
            "hold_targets": current_hold_targets,
            "baseline": current_baseline,
            "owned": sorted(new_owned),
            "preexisting": sorted(new_preexisting),
            "settlement_txid": txid,
            "rotation": {"txid": txid, "package": package, "version": version,
                         "release_owned": sorted(removed_owned)},
        }
        prepared_receipt = dict(receipt)
        prepared_receipt["state"] = "SETTLEMENT_PREPARED"
        prepared_receipt["replacement_proof"] = proof
        successor = dict(record)
        successor["phase"] = "ACTIVE"
        successor.pop("rotation", None)
        if receipt.get("state") == "SETTLEMENT_PREPARED" \
                and (receipt.get("successor_ledger") != successor
                     or receipt.get("rotation_ledger_sha256") != library.digest(record)):
            raise RuntimeError("prepared FREEZE successor changed before ledger publication")
        prepared_receipt["successor_ledger"] = successor
        prepared_receipt["rotation_ledger_sha256"] = library.digest(record)
        atomic_json(PACKAGE_TRANSITION, prepared_receipt)
        receipt = prepared_receipt
        atomic_json(FREEZE, record)
    else:
        raise RuntimeError("FREEZE settlement requires ACTIVE or ROTATING state")

    rotation = record["rotation"]

    def recheck_rotation():
        # apt-mark is a separate process. Neither its success nor the policy
        # lock proves that package state or our durable CAS inputs stayed put.
        # Preserve a foreign ledger/receipt and keep ROTATING on any drift.
        if read_json(FREEZE) != record or read_json(PACKAGE_TRANSITION) != receipt:
            raise RuntimeError("FREEZE settlement CAS changed during hold reconciliation")
        if watched_installed(manifest, library) != current_targets \
                or package_state_records(current_targets) != current_baseline:
            raise RuntimeError("FREEZE package baseline changed during hold reconciliation")
        if replacement_proof(receipt, replacement_txid, library) != proof:
            raise RuntimeError("replacement proof changed during hold reconciliation")

    recheck_rotation()
    original_holds = held_packages()
    apt_mark("hold", sorted(set(record["hold_targets"]) - held_packages()))
    recheck_rotation()
    release = sorted(set(rotation.get("release_owned", [])) & held_packages())
    release_holds(release)
    recheck_rotation()
    final_holds = held_packages()
    if not freeze_required_holds(record).issubset(final_holds):
        raise RuntimeError("FREEZE settlement could not establish every required hold")
    if (original_holds - set(rotation.get("release_owned", []))) - final_holds:
        raise RuntimeError("FREEZE settlement lost a hold outside its exact release set")
    settled = dict(record)
    settled["phase"] = "ACTIVE"
    settled.pop("rotation", None)
    atomic_json(FREEZE, settled)
    completed = dict(receipt)
    completed.update({"state": "COMPLETE", "successor_generation": settled["generation"],
                      "successor_ledger_sha256": library.digest(settled)})
    atomic_json(LAST_PACKAGE_TRANSITION, completed)
    unlink_durable(PACKAGE_TRANSITION)
    return settled


def prepare_direct_package(source_package, source_version, target_package,
                           target_version, target_architecture, candidate_sha256,
                           candidate_artifact_sha256, candidate_manifest_path):
    """Close mutation admission for first install or a non-FREEZE direct gate."""
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() \
            or RUNTIME_QUALIFICATION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("another update transaction is already pending")
    allowed = {"pve-sharedlvmthin", "pve-sharedlvmthin-thick"}
    if target_package not in allowed or not target_version \
            or target_architecture != "all" \
            or not re.fullmatch(r"[0-9a-f]{64}", candidate_sha256) \
            or not re.fullmatch(r"[0-9a-f]{64}", candidate_artifact_sha256):
        raise RuntimeError("direct package transition target identity is invalid")
    installed = {name: package_version(name) for name in allowed}
    installed = {name: version for name, version in installed.items() if version is not None}
    initial = source_package == "NONE" and source_version == "NONE"
    if initial:
        if installed:
            raise RuntimeError("initial package transition found an installed package profile")
    elif installed != {source_package: source_version}:
        raise RuntimeError("direct package transition source identity changed")
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if not initial and policy.get("mode") not in {
            "WARN", "QUALIFIED_AUTO", "MANUAL_OVERRIDE", "QUALIFIED_ONLY"}:
        raise RuntimeError(
            "non-FREEZE direct transition requires WARN, QUALIFIED_AUTO or "
            "one exact schema-1 predecessor"
        )
    library = load_library()
    candidate_manifest = library.strict_json(candidate_manifest_path)
    receipt = {
        "schema": 2, "state": "PREPARED", "kind": "DIRECT_PROFILE_GATE",
        "txid": secrets.token_hex(16), "hostname": os.uname().nodename,
        "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "source_package": source_package, "source_version": source_version,
        "target_package": target_package, "target_version": target_version,
        "target_architecture": target_architecture,
        "candidate_sha256": candidate_sha256,
        "candidate_artifact_sha256": candidate_artifact_sha256,
        "candidate_manifest_sha256": library.digest(candidate_manifest),
        "policy_mode": policy.get("mode", "UNSELECTED"),
    }
    create_json(PACKAGE_TRANSITION, receipt)
    return receipt


def settle_direct_package(package, version, candidate_sha256, txid):
    """Close one exact direct package transaction after runtime qualification."""
    receipt = read_json(PACKAGE_TRANSITION)
    release = read_json(RUNTIME_RELEASE)
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") != "PREPARED" \
            or receipt.get("kind") != "DIRECT_PROFILE_GATE":
        raise RuntimeError("direct package settlement has no exact prepared transaction")
    if receipt.get("txid") != txid or receipt.get("target_package") != package \
            or receipt.get("target_version") != version \
            or receipt.get("candidate_sha256") != candidate_sha256:
        raise RuntimeError("direct package settlement transaction identity changed")
    if not isinstance(release, dict) or release.get("qualified") != "QUALIFIED" \
            or release.get("qualification_txid") != txid \
            or release.get("artifact_sha256") != receipt.get("candidate_artifact_sha256"):
        raise RuntimeError("direct package settlement lacks matching runtime qualification")
    opposite = "pve-sharedlvmthin-thick" if package == "pve-sharedlvmthin" \
        else "pve-sharedlvmthin"
    if package_version(package) != version or package_version(opposite) is not None:
        raise RuntimeError("direct package settlement installed profile differs")
    _, library = manifest_and_lib()
    if receipt.get("candidate_manifest_sha256") != library.digest(
            library.strict_json(MANIFEST)):
        raise RuntimeError("direct package settlement manifest differs")
    if exact_hex_identity(PACKAGE_ARTIFACT_FILE,
                          "installed package artifact identity") \
            != receipt.get("candidate_artifact_sha256"):
        raise RuntimeError("direct package settlement artifact differs")
    audit = run(["dpkg", "--audit"])
    verify = run(["dpkg", "--verify", package])
    if audit.returncode or audit.stdout.strip() or audit.stderr.strip() \
            or verify.returncode or verify.stdout.strip() or verify.stderr.strip():
        raise RuntimeError("direct package settlement package database is not clean")
    if read_json(PACKAGE_TRANSITION) != receipt or read_json(RUNTIME_RELEASE) != release:
        raise RuntimeError("direct package settlement CAS changed")
    completed = dict(receipt)
    completed["state"] = "COMPLETE"
    completed["runtime_release_sha256"] = library.digest(release)
    atomic_json(LAST_PACKAGE_TRANSITION, completed)
    unlink_durable(PACKAGE_TRANSITION)
    return completed


def command_select(args):
    require_root()
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("another update transaction is pending; policy change refused")
    manifest, library = manifest_and_lib()
    mode = args.mode.upper().replace("-", "_")
    if mode not in {"FREEZE", "QUALIFIED_AUTO", "WARN"}:
        raise SystemExit("mode must be freeze, qualified-auto or warn")
    if mode == "FREEZE":
        record = enter_freeze(manifest, library)
    else:
        leave_freeze()
        record = None
    atomic_json(POLICY, {"schema": 2, "mode": mode, "required_scope": "san-dataplane"})
    unlink_durable(AUTH)
    print(f"UPDATE_POLICY={mode}")
    if record:
        print("HELD=" + ",".join(record["hold_targets"]))


def command_prepare_direct_package(args):
    require_root()
    receipt = prepare_direct_package(
        args.source_package, args.source_version, args.target_package,
        args.target_version, args.target_architecture, args.sha256.lower(),
        args.artifact_sha256.lower(), args.candidate_manifest,
    )
    print(f"DIRECT_PACKAGE_TXID={receipt['txid']}")
    print("DIRECT_PACKAGE_PREPARED=PASS")


def command_settle_direct_package(args):
    require_root()
    settle_direct_package(args.package, args.version, args.sha256.lower(), args.txid)
    print("DIRECT_PACKAGE_SETTLEMENT=PASS")


def command_migrate_policy_schema(_args):
    require_root()
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("policy schema migration refused while an update transaction is pending")
    policy = read_json(POLICY)
    if not isinstance(policy, dict) or policy.get("schema") != 1:
        raise RuntimeError("policy schema migration requires an exact schema-1 policy")
    mapping = {
        "FREEZE": "FREEZE",
        "QUALIFIED_ONLY": "QUALIFIED_AUTO",
        "MANUAL_OVERRIDE": "WARN",
        "UNSELECTED": "UNSELECTED",
    }
    old_mode = policy.get("mode")
    if old_mode not in mapping:
        raise RuntimeError("policy schema migration found an unknown legacy mode")
    successor = dict(policy)
    successor.update({"schema": 2, "mode": mapping[old_mode]})
    atomic_json(POLICY, successor)
    atomic_json(LAST_POLICY_MIGRATION, {
        "schema": 1,
        "from_policy": policy,
        "to_policy": successor,
    })
    print(f"POLICY_SCHEMA_MIGRATED={old_mode}->{successor['mode']}")


def command_migrate_freeze_schema(_args):
    require_root()
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") != "FREEZE":
        raise RuntimeError("FREEZE schema migration requires selected FREEZE policy")
    manifest, library = manifest_and_lib()
    record = migrate_freeze_schema(manifest, library)
    print("FREEZE_SCHEMA=3")
    print("FREEZE_SCHEMA_MIGRATION=PASS")
    print("BASELINE_TARGETS=" + ",".join(record["baseline_targets"]))
    print("HELD_TARGETS=" + ",".join(record["hold_targets"]))


def command_settle_freeze_package(args):
    require_root()
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") != "FREEZE":
        raise RuntimeError("exact package settlement requires selected FREEZE policy")
    if POST_GATE.exists():
        raise RuntimeError("post-update gate is still required; FREEZE settlement refused")
    manifest, library = manifest_and_lib()
    record = settle_freeze_package(args.package, args.version, args.sha256,
                                   args.txid, manifest, library, args.replacement_txid)
    unlink_durable(AUTH)
    print("UPDATE_POLICY=FREEZE")
    print("FREEZE_BASELINE_ROTATED=YES")
