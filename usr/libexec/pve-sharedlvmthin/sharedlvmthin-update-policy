@contextlib.contextmanager
def dpkg_transaction_locks():
    """Refuse recovery while dpkg or an APT frontend owns package state."""
    handles = []
    try:
        for name in ("/var/lib/dpkg/lock-frontend", "/var/lib/dpkg/lock"):
            handle = open(name, "a+", encoding="utf-8")
            try:
                fcntl.lockf(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError as exc:
                handle.close()
                raise RuntimeError(f"package-state lock is busy: {name}") from exc
            handles.append(handle)
        yield
    finally:
        for handle in reversed(handles):
            try:
                fcntl.lockf(handle.fileno(), fcntl.LOCK_UN)
            finally:
                handle.close()


def recover_prepared_freeze_source(txid, manifest, library):
    """Close PREPARED only after revalidating the unchanged source baseline.

    This deliberately does not claim historical zero effect or that the
    candidate was never unpacked.  Any former runtime release is invalidated,
    so mutation admission stays closed until a new exact qualification.
    """
    # Use the state reader consistently: injected state stays isolated, and
    # every existing JSON value (including null/false/{}) still means HOLD.
    absent = Ellipsis  # Cannot be a decoded JSON value; stable under fixture copies.
    def gates_pending():
        return any(read_json(path, absent) is not absent for path in
                   (POST_GATE, RUNTIME_QUALIFICATION, FREEZE_MIGRATION))
    if gates_pending():
        raise RuntimeError("source recovery refused while another gate is pending")
    if not re.fullmatch(r"[0-9a-f]{32}", txid):
        raise RuntimeError("source recovery transaction identity is invalid")
    archive = PACKAGE_RECOVERY_ARCHIVE / f"{txid}.json"
    receipt = read_json(PACKAGE_TRANSITION)
    if receipt is None:
        completed = read_json(archive)
        if isinstance(completed, dict) \
                and completed.get("state") == "SOURCE_REVALIDATED_AFTER_FAILED_TRANSACTION" \
                and completed.get("txid") == txid:
            return completed
        raise RuntimeError("source recovery has no exact prepared transition")
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") != "PREPARED" \
            or receipt.get("txid") != txid:
        raise RuntimeError("source recovery requires the exact PREPARED transition")
    boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    if receipt.get("hostname") != os.uname().nodename \
            or receipt.get("boot_id") != boot_id:
        raise RuntimeError("source recovery node or boot identity changed")
    record = read_json(FREEZE)
    if not isinstance(record, dict) \
            or receipt.get("parent_generation") != record.get("generation") \
            or receipt.get("parent_ledger_sha256") != library.digest(record):
        raise RuntimeError("source recovery parent FREEZE ledger changed")
    if freeze_integrity(record, manifest, library).get("result") != "PASS":
        raise RuntimeError("source recovery requires the unchanged frozen baseline")
    baseline_targets = freeze_baseline_targets(record)
    baseline_before = package_state_records(baseline_targets)
    holds_before = held_packages()
    source = receipt.get("source_package")
    target = receipt.get("target_package")
    source_version = receipt.get("source_version")
    if package_version(source) != source_version:
        raise RuntimeError("source recovery source package was replaced")
    if target != source and package_version(target) is not None:
        raise RuntimeError("source recovery found the target profile installed")
    audit = run(["dpkg", "--audit"])
    if audit.returncode or audit.stdout.strip() or audit.stderr.strip():
        raise RuntimeError("source recovery requires a clean dpkg audit")
    if gates_pending() or read_json(PACKAGE_TRANSITION) != receipt \
            or read_json(FREEZE) != record \
            or package_state_records(baseline_targets) != baseline_before \
            or held_packages() != holds_before:
        raise RuntimeError("source recovery CAS changed during proof")
    completed = dict(receipt)
    completed.update({
        "state": "SOURCE_REVALIDATED_AFTER_FAILED_TRANSACTION",
        "recovery_proof": "CURRENT_SOURCE_PACKAGE_AND_FROZEN_BASELINE_REVALIDATED",
        "runtime_release_invalidated": read_json(RUNTIME_RELEASE, absent) is not absent,
    })
    create_json(archive, completed)
    unlink_durable(RUNTIME_RELEASE)
    unlink_durable(PACKAGE_TRANSITION)
    return completed


def command_recover_prepared_freeze_source(args):
    require_root()
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") != "FREEZE":
