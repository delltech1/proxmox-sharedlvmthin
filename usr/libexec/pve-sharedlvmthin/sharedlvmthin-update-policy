def command_migrate_policy_schema(_args):
    require_root()
    if POST_GATE.exists() or PACKAGE_TRANSITION.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("policy schema migration refused while an update transaction is pending")
    policy = read_json(POLICY)
    if not isinstance(policy, dict) or policy.get("schema") != 1:
        raise RuntimeError("policy schema migration requires an exact schema-1 policy")
    mapping = {
        "FREEZE": "FREEZE",
        "QUALIFIED_ONLY": "QUALIFIED_AUTO",
        "MANUAL_OVERRIDE": "WARN",
        "UNSELECTED": "UNSELECTED",
    }
    old_mode = policy.get("mode")
    if old_mode not in mapping:
        raise RuntimeError("policy schema migration found an unknown legacy mode")
    successor = dict(policy)
    successor.update({"schema": 2, "mode": mapping[old_mode]})
    atomic_json(POLICY, successor)
    atomic_json(LAST_POLICY_MIGRATION, {
        "schema": 1,
        "from_policy": policy,
        "to_policy": successor,
    })
    print(f"POLICY_SCHEMA_MIGRATED={old_mode}->{successor['mode']}")


