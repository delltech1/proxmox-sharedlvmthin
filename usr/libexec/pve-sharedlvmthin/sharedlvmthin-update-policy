    prepare_direct.add_argument("--target-architecture", required=True)
    prepare_direct.add_argument("--sha256", required=True)
    prepare_direct.add_argument("--artifact-sha256", required=True)
    prepare_direct.add_argument("--candidate-manifest", required=True)
    prepare_direct.set_defaults(func=command_prepare_direct_package)
    settle_direct = subs.add_parser("settle-direct-package")
    settle_direct.add_argument("--package", required=True)
    settle_direct.add_argument("--version", required=True)
    settle_direct.add_argument("--sha256", required=True)
    settle_direct.add_argument("--txid", required=True)
