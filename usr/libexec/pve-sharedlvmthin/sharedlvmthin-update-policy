def command_settle_freeze_package(args):
    require_root()
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") != "FREEZE":
        raise RuntimeError("exact package settlement requires selected FREEZE policy")
    if POST_GATE.exists():
        raise RuntimeError("post-update gate is still required; FREEZE settlement refused")
    manifest, library = manifest_and_lib()
    pending = read_json(RUNTIME_QUALIFICATION)
    release = read_json(RUNTIME_RELEASE)
    if not isinstance(pending, dict) or pending.get("state") != "QUALIFYING" \
            or pending.get("txid") != args.txid \
            or pending.get("plugin_package") != args.package \
