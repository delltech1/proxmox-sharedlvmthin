        result = recover_prepared_freeze_source(args.txid, manifest, library)
    print("FREEZE_PACKAGE_SOURCE_REVALIDATED=YES")
    print("RUNTIME_REQUALIFICATION_REQUIRED=YES")
    print(f"FREEZE_PACKAGE_TXID={result['txid']}")


def command_verify_prepared_freeze_package(args):
    """Preinst-only read-only proof that the external gate prepared this candidate."""
    require_root()
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    if policy.get("mode") != "FREEZE":
        print("FREEZE_PREPARED=NOT_APPLICABLE")
        return 3
    manifest, library = manifest_and_lib()
    receipt = read_json(PACKAGE_TRANSITION)
    parent = read_json(FREEZE)
    candidate_manifest = library.strict_json(args.candidate_manifest)
    expected = {
        "source_package": args.source_package,
        "source_version": args.source_version,
        "target_package": args.target_package,
        "target_version": args.target_version,
        "target_architecture": args.target_architecture,
        "candidate_artifact_sha256": args.artifact_sha256.lower(),
        "candidate_manifest_sha256": library.digest(candidate_manifest),
    }
    if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
            or receipt.get("state") != "PREPARED":
        raise RuntimeError(
            "active FREEZE requires an exact package-profile-gate PREPARED receipt"
        )
    if any(receipt.get(key) != value for key, value in expected.items()):
        raise RuntimeError("prepared FREEZE receipt does not match this candidate")
    if receipt.get("hostname") != os.uname().nodename \
            or receipt.get("boot_id") != pathlib.Path(
                "/proc/sys/kernel/random/boot_id").read_text().strip():
        raise RuntimeError("prepared FREEZE receipt belongs to another node or boot")
    if receipt.get("parent_generation") != (parent or {}).get("generation") \
            or receipt.get("parent_ledger_sha256") != library.digest(parent):
        raise RuntimeError("prepared FREEZE parent ledger changed before unpack")
    candidate_sha = receipt.get("candidate_sha256")
    if not isinstance(candidate_sha, str) or len(candidate_sha) != 64 \
            or any(c not in "0123456789abcdef" for c in candidate_sha):
        raise RuntimeError("prepared FREEZE whole-package identity is invalid")
    print(f"FREEZE_PACKAGE_TXID={receipt['txid']}")
    print("FREEZE_PREPARED=PASS")
    return 0


def command_status(args):
    policy = read_json(POLICY, {"mode": "UNSELECTED"})
    freeze = read_json(FREEZE)
    post = read_json(POST_GATE)
    runtime_release = read_json(RUNTIME_RELEASE)
    runtime_pending = read_json(RUNTIME_QUALIFICATION)
    print(f"UPDATE_POLICY={policy.get('mode', 'UNSELECTED')}")
    print(f"UPDATE_POLICY_SCHEMA={policy.get('schema', 'LEGACY_OR_UNSET')}")
    print(f"FREEZE_SCHEMA={(freeze or {}).get('schema', 'NONE')}")
    print(f"FREEZE_STATE={(freeze or {}).get('phase', 'INACTIVE')}")
    print("BASTRIX_OWNED_HOLDS=" + ",".join((freeze or {}).get("owned", [])))
    print("FREEZE_HOLD_TARGETS=" + ",".join(
        (freeze or {}).get("hold_targets", (freeze or {}).get("targets", []))))
    print(f"POST_GATE_REQUIRED={'YES' if post else 'NO'}")
    print(f"RUNTIME_QUALIFICATION={(runtime_release or {}).get('qualified', 'ABSENT')}")
    qualified_boot = (runtime_release or {}).get("boot_id")
    current_boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    boot_match = bool(qualified_boot and qualified_boot == current_boot)
    print(f"CURRENT_BOOT_ID={current_boot}")
    print(f"RUNTIME_QUALIFIED_BOOT={qualified_boot or 'ABSENT'}")
    print(f"RUNTIME_BOOT_MATCH={'YES' if boot_match else 'NO'}")
    print(f"REBOOT_REQUALIFICATION_REQUIRED={'NO' if boot_match else 'YES'}")
    print(f"RUNTIME_QUALIFIED_KERNEL={(runtime_release or {}).get('kernel_release', 'ABSENT')}")
    print(f"RUNTIME_FINALIZATION_PENDING={'YES' if runtime_pending else 'NO'}")
    transition = read_json(PACKAGE_TRANSITION)
    print(f"PACKAGE_TRANSITION_PENDING={'YES' if transition else 'NO'}")
    migration = read_json(FREEZE_MIGRATION)
    print(f"FREEZE_SCHEMA_MIGRATION_PENDING={'YES' if migration else 'NO'}")
    integrity = "NOT_APPLICABLE"
    missing_holds = []
    mode = policy.get("mode", "UNSELECTED")
    if mode == "FREEZE":
        try:
            manifest_for_freeze, library_for_freeze = manifest_and_lib()
            check = freeze_integrity(freeze, manifest_for_freeze, library_for_freeze)
            integrity = check["result"]
            missing_holds = check["missing_holds"]
            for reason in check["reasons"]:
                print(f"FREEZE_INTEGRITY_REASON={reason}")
