def command_settle_unqualified_freeze_package(args):
    """Settle exact package state only. Persist runtime closure indefinitely.

    Only typed UNLISTED classification is accepted, never arbitrary Doctor,
    source, dpkg or storage failure. This command cannot publish QUALIFIED.
    """
    require_root()
    policy = read_json(POLICY)
    if not isinstance(policy, dict) or policy.get("mode") != "FREEZE" \
            or POST_GATE.exists() or FREEZE_MIGRATION.exists():
        raise RuntimeError("unqualified package settlement requires isolated FREEZE policy")
    if args.package not in PLUGIN_PACKAGES \
            or not re.fullmatch(r"[0-9a-f]{32}", args.txid) \
            or not re.fullmatch(r"[0-9a-f]{64}", args.sha256):
        raise RuntimeError("unqualified package settlement identity is invalid")
    manifest, library = manifest_and_lib()
    receipt = read_json(PACKAGE_TRANSITION)
    pending = read_json(RUNTIME_QUALIFICATION)
    successor_context = None
    predecessor = None
    if pending is not None:
        if not isinstance(pending, dict) or pending.get("schema") != 1 \
                or pending.get("state") != "PACKAGE_SETTLED_RUNTIME_CLOSED":
            raise RuntimeError("a different runtime qualification is pending")
        if isinstance(receipt, dict) and receipt.get("txid") != pending.get("txid"):
            successor_context = closed_runtime_successor(receipt, pending, library)
            predecessor = successor_context[0]
            prepared = dict(receipt)
        else:
            receipt = receipt if receipt is not None else read_json(LAST_PACKAGE_TRANSITION)
            prepared = assert_blocked_transition(receipt, pending, library)
            predecessor = pending.get("closed_predecessor")
    else:
        if not isinstance(receipt, dict) or receipt.get("schema") != 2 \
                or receipt.get("state") != "PREPARED" or "kind" in receipt:
            raise RuntimeError("unqualified settlement requires exact PREPARED FREEZE transition")
        prepared = dict(receipt)
    if prepared.get("txid") != args.txid or prepared.get("target_package") != args.package \
            or prepared.get("target_version") != args.version \
            or prepared.get("candidate_sha256") != args.sha256:
        raise RuntimeError("unqualified package settlement transaction identity changed")
    if predecessor is not None:
        digest_keys = {"qualification_sha256", "release_sha256", "package_settlement_sha256",
                       "freeze_ledger_sha256"}
        if isinstance(predecessor, dict) and "preimage_sha256" in predecessor:
            digest_keys.add("preimage_sha256")
        if not isinstance(predecessor, dict) or set(predecessor) != digest_keys | {"txid"} \
                or any(not isinstance(predecessor.get(key), str) or
                       not re.fullmatch(r"[0-9a-f]{64}", predecessor[key]) for key in digest_keys) \
                or not isinstance(predecessor.get("txid"), str) \
                or not re.fullmatch(r"[0-9a-f]{32}", predecessor["txid"]) \
                or predecessor["txid"] == args.txid \
                or predecessor["freeze_ledger_sha256"] != prepared.get("parent_ledger_sha256"):
            raise RuntimeError("closed-runtime predecessor binding is invalid")
        if successor_context is None and "preimage_sha256" in predecessor:
            archived = read_json(STATE / "closed-runtime-history" / f"{predecessor['txid']}.json")
            if library.digest(archived) != predecessor["preimage_sha256"]:
                raise RuntimeError("closed-runtime predecessor preimage changed or is absent")
    previous_release_sha256 = (library.digest(successor_context[3]) if successor_context else
                               pending.get("previous_runtime_release_sha256") if pending is not None
                               else library.digest(read_json(RUNTIME_RELEASE)))
    if not isinstance(previous_release_sha256, str) \
            or not re.fullmatch(r"[0-9a-f]{64}", previous_release_sha256) \
            or (predecessor is not None and
                previous_release_sha256 != predecessor["release_sha256"]):
        raise RuntimeError("closed-runtime predecessor release identity is invalid")

    def proof():
        current_manifest, _ = manifest_and_lib()
        if library.digest(current_manifest) != library.digest(manifest) \
                or prepared.get("candidate_manifest_sha256") != library.digest(manifest):
            raise RuntimeError("unqualified settlement installed manifest changed")
        boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        if prepared.get("hostname") != os.uname().nodename or prepared.get("boot_id") != boot:
            raise RuntimeError("unqualified settlement node/boot changed")
        opposite = next(name for name in PLUGIN_PACKAGES if name != args.package)
        if package_version(args.package) != args.version or package_version(opposite) is not None:
            raise RuntimeError("unqualified settlement installed profile differs")
        rows = package_state_records([args.package])
        if len(rows) != 1 or rows[0].get("package") != args.package \
                or rows[0].get("version") != args.version \
                or rows[0].get("architecture") != prepared.get("target_architecture") \
                or rows[0].get("status") != "installed":
            raise RuntimeError("unqualified settlement target is not exactly configured")
        artifact = exact_hex_identity(PACKAGE_ARTIFACT_FILE, "installed package artifact identity")
        if artifact != prepared.get("candidate_artifact_sha256"):
            raise RuntimeError("unqualified settlement installed artifact differs")
        build = exact_runtime_build_id()
        for argv in (["dpkg", "--audit"], ["dpkg", "--verify", args.package]):
            result = run(argv)
            if result.returncode or result.stdout.strip() or result.stderr.strip():
                raise RuntimeError("unqualified settlement package database/payload is not clean")
        try:
            assert_listed_runtime_tuple(manifest, library, args.package, args.version)
        except UnlistedRuntimeTuple as unlisted:
            identity = unlisted.identity
        else:
            raise RuntimeError("package-only settlement is restricted to an UNLISTED runtime")
        result = {"schema": 1, "state": "PACKAGE_SETTLED_RUNTIME_CLOSED",
                "txid": args.txid, "transition_sha256": library.digest(prepared),
                "prepared_transition": prepared, "plugin_package": args.package,
                "plugin_version": args.version, "artifact_sha256": artifact,
                "runtime_build_id": build, "plan_digest": args.sha256,
                "boot_id": boot, "kernel_release": os.uname().release,
                "runtime_manifest_sha256": library.digest(manifest),
                "runtime_identity_sha256": library.digest(identity),
                "reason": "UNLISTED_RUNTIME_TUPLE", "authority": "NONE",
                "previous_runtime_release_sha256": previous_release_sha256,
                "replacement_proof": replacement_proof(prepared, args.replacement_txid, library)}
        executor = recovery_executor_identity(args)
        if executor is not None:
            result["recovery_executor"] = executor
        if predecessor is not None:
            result["closed_predecessor"] = predecessor
        return result

    expected = proof()
    if pending is not None and successor_context is None and pending != expected:
        raise RuntimeError("closed-runtime settlement proof changed")
    if successor_context is not None:
        # main() holds the policy lock. Recheck all predecessor/edge records
        # after package probes, then replace CLOSED with CLOSED atomically.
        if read_json(POLICY) != policy or read_json(PACKAGE_TRANSITION) != receipt \
                or read_json(RUNTIME_QUALIFICATION) != pending \
                or closed_runtime_successor(receipt, pending, library) != successor_context:
            raise RuntimeError("closed-runtime successor CAS changed")
        archive_path = STATE / "closed-runtime-history" / f"{predecessor['txid']}.json"
        archived = read_json(archive_path, Ellipsis)
        if archived is Ellipsis:
            create_json(archive_path, successor_context[4])
        elif archived != successor_context[4]:
            raise RuntimeError("closed-runtime predecessor archive fork")
        if read_json(POLICY) != policy or read_json(PACKAGE_TRANSITION) != receipt \
                or read_json(RUNTIME_QUALIFICATION) != pending \
                or closed_runtime_successor(receipt, pending, library) != successor_context:
            raise RuntimeError("closed-runtime successor CAS changed after archive")
        atomic_json(RUNTIME_QUALIFICATION, expected)
    elif pending is None:
        if read_json(PACKAGE_TRANSITION) != receipt:
            raise RuntimeError("package transition changed before runtime closure")
        create_json(RUNTIME_QUALIFICATION, expected)
    # The durable latch is the admission fence. A stale same-build/same-boot
    # QUALIFIED release must not become usable when package state is settled.
    closed_release = closed_runtime_release(expected)
    if read_json(RUNTIME_QUALIFICATION) != expected or proof() != expected:
        raise RuntimeError("runtime closure changed before unqualified publication")
    current_release = read_json(RUNTIME_RELEASE)
    if current_release != closed_release and library.digest(current_release) != previous_release_sha256:
        raise RuntimeError("runtime release changed outside the closed settlement")
    atomic_json(RUNTIME_RELEASE, closed_release)

    def recheck():
        if read_json(POLICY) != policy or read_json(RUNTIME_QUALIFICATION) != expected \
                or read_json(RUNTIME_RELEASE) != closed_release or proof() != expected:
            raise RuntimeError("closed-runtime settlement CAS changed")
        active = read_json(PACKAGE_TRANSITION)
        assert_blocked_transition(active if active is not None else
                                  read_json(LAST_PACKAGE_TRANSITION), expected, library)

    recheck()
    settle_freeze_package(args.package, args.version, args.sha256, args.txid,
                          manifest, library, args.replacement_txid, before_release=recheck)
    recheck()
    unlink_durable(AUTH)
    if args.replacement_txid:
        finalize_closed_profile_evidence(args.txid, args.replacement_txid)
    print("PACKAGE_SETTLEMENT=COMPLETE")
    print("RUNTIME_QUALIFICATION=UNQUALIFIED")
    print("RUNTIME_ADMISSION=CLOSED")
    print("RESULT=PACKAGE_SETTLED_RUNTIME_CLOSED")


