set -u

fail=0
pass=0
check() {
    local label=$1
    shift
    if timeout --foreground --kill-after=5 60 "$@"; then
        echo "PASS=$label"
        pass=$((pass + 1))
    else
        echo "FAIL=$label"
        fail=$((fail + 1))
    fi
}

# Return 0 when this kernel owns at least one managed thin-pool mapper, 1 when
# no managed pool has a local mapper, and 2 when the evidence cannot be read or
# LVM and device-mapper disagree.  A hidden "-tpool" mapper counts as active
# even when the public pool LV is reported inactive.
managed_thin_runtime_present() {
    local lvm_inventory dm_inventory line vg pool segtype attr tags mapper

    if ! lvm_inventory=$(timeout --foreground --kill-after=5 60 \
        lvs --noheadings --separator '|' \
        -o vg_name,lv_name,segtype,lv_attr,lv_tags 2>/dev/null); then
        return 2
    fi
    if ! dm_inventory=$(timeout --foreground --kill-after=5 60 \
        dmsetup info -c --noheadings -o name 2>/dev/null); then
        return 2
    fi
    dm_inventory=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$dm_inventory")

    while IFS='|' read -r vg pool segtype attr tags; do
        vg=${vg//[[:space:]]/}
        pool=${pool//[[:space:]]/}
        segtype=${segtype//[[:space:]]/}
        attr=${attr//[[:space:]]/}
        tags=${tags//[[:space:]]/}
        [ "$segtype" = "thin-pool" ] || continue
        [[ ",$tags," =~ ,pve-slt-sid-[A-Za-z0-9_-]+, ]] || continue

        mapper=${vg//-/--}-${pool//-/--}-tpool
        if grep -Fxq "$mapper" <<<"$dm_inventory"; then
            return 0
        fi
        # LVM claiming an active managed pool without its exact hidden mapper
        # is contradictory evidence and must fail closed.
        if [[ "$attr" =~ ^....a ]]; then
            return 2
        fi
    done <<<"$lvm_inventory"

    return 1
}

echo "COMPATIBILITY_CHECK_VERSION=1"
echo "HOST=$(hostname)"
echo "KERNEL=$(uname -r)"

for command in perl python3 pvesm pvesh qm lvs vgs pvs lvcreate lvremove \
    lvchange lvextend vgcfgbackup dmsetup multipath multipathd iscsiadm \
    qemu-img qemu-io sha256sum timeout systemctl lsinitramfs update-initramfs; do
    if command -v "$command" >/dev/null 2>&1; then
        echo "PASS=command:$command"
        pass=$((pass + 1))
    else
        echo "FAIL=command:$command"
        fail=$((fail + 1))
    fi
done

thick_required=0
[ "$(sed -n '1p' /usr/share/pve-sharedlvmthin/package-flavor 2>/dev/null)" != "thick-only" ] \
    || thick_required=1
if awk '
    function emit() {
        if (inside && disabled !~ /^(1|yes|on|true)$/ && mode == "thick-generations") found=1
    }
    /^sharedlvmthin:[[:space:]]+/ { emit(); inside=1; disabled="0"; mode="thin"; next }
    /^[^[:space:]]/ { emit(); inside=0; next }
    inside && $1=="disable" { disabled=(NF==1?"1":tolower($2)); next }
    inside && $1=="slt-allocation-mode" { mode=$2; next }
    END { emit(); exit found ? 0 : 1 }
' /etc/pve/storage.cfg; then
    thick_required=1
fi

if [ "$thick_required" -eq 1 ]; then
    # Prove the running kernel can load the experimental target after a reboot
    # without loading it as a side effect of this read-only compatibility check.
    if command -v modprobe >/dev/null 2>&1; then
        echo "PASS=command:modprobe"
        pass=$((pass + 1))
        check dm-clone-module-available modprobe --dry-run --show-depends dm-clone
    else
        echo "FAIL=command:modprobe"
        fail=$((fail + 1))
    fi

    if targets=$(timeout --foreground --kill-after=5 60 dmsetup targets 2>/dev/null); then
        clone_target=$(awk '$1 == "clone" { print $2 }' <<<"$targets")
        if [ -z "$clone_target" ]; then
            echo "PASS=dm-clone-target:not-loaded-module-available"
            pass=$((pass + 1))
        elif [[ "$clone_target" =~ ^v1([.]|$) ]]; then
            echo "PASS=dm-clone-target:$clone_target"
            pass=$((pass + 1))
        else
            echo "FAIL=dm-clone-target:unsupported-version:${clone_target:-ambiguous}"
            fail=$((fail + 1))
        fi
    else
        echo "FAIL=dm-clone-target:inventory-unavailable"
        fail=$((fail + 1))
    fi
else
    echo "PASS=dm-clone-target:not-required-by-enabled-storage"
    pass=$((pass + 1))
fi

check perl-module-load perl -MPVE::Storage -MPVE::Storage::Custom::SharedLvmThinPlugin -e 1
check api-and-hook-contract perl -MPVE::Storage -MPVE::Storage::Custom::SharedLvmThinPlugin -e '
    my $api = PVE::Storage::APIVER();
    die "unsupported API $api\n" if $api < 14 || $api > 15;
    die "plugin API mismatch\n" if PVE::Storage::Custom::SharedLvmThinPlugin->api() != $api;
    for my $hook (qw(type plugindata properties options status list_images alloc_image free_image
        activate_storage deactivate_storage activate_volume deactivate_volume volume_size_info
        volume_resize volume_snapshot volume_snapshot_delete volume_snapshot_rollback
        volume_snapshot_needs_fsfreeze volume_has_feature path parse_volname)) {
        die "missing hook $hook\n" if !PVE::Storage::Custom::SharedLvmThinPlugin->can($hook);
    }
'

check pve-storage-status pvesm status
check pve-storage-api pvesh get /storage --output-format json
if [ -f /etc/pve/corosync.conf ]; then
    check quorum bash -c "pvecm status | grep -q 'Quorate:[[:space:]]*Yes'"
fi

for service in pvedaemon.service pvestatd.service pveproxy.service multipathd.service; do
    check "service:$service" systemctl is-active --quiet "$service"
done

if systemctl is-active --quiet dm-event.service; then
    echo "PASS=service:dm-event.service:active"
    pass=$((pass + 1))
else
    managed_thin_runtime_present
    runtime_rc=$?
    if [ "$runtime_rc" -eq 1 ]; then
        echo "PASS=service:dm-event.service:not-required-no-local-managed-thin-mapper"
        pass=$((pass + 1))
    elif [ "$runtime_rc" -eq 0 ]; then
        echo "FAIL=service:dm-event.service:inactive-with-local-managed-thin-mapper"
        fail=$((fail + 1))
    else
        echo "FAIL=service:dm-event.service:runtime-evidence-unknown"
        fail=$((fail + 1))
    fi
fi

initrd_dirty=0
for image in /boot/initrd.img-*; do
    [ -f "$image" ] || continue
    if lsinitramfs "$image" 2>/dev/null | grep -qE '^etc/lvm/(archive|backup)/'; then
        echo "FAIL=initramfs-host-lvm-recovery-copy:$image"
        fail=$((fail + 1))
        initrd_dirty=1
    fi
done
if [ "$initrd_dirty" -eq 0 ]; then
    echo "PASS=initramfs-no-host-lvm-recovery-copies"
    pass=$((pass + 1))
fi

while IFS='|' read -r sid disabled nodes; do
    [ -n "$sid" ] || continue
    case "$disabled" in 1|yes|on|true) continue;; esac
    if [ -n "$nodes" ]; then case ",$nodes," in *",$(hostname),"*) ;; *) continue;; esac; fi
    check "recovery:$sid" /usr/libexec/pve-sharedlvmthin/sharedlvmthin-recovery-check "$sid"
done < <(awk '
    function emit(){if(inside) print sid "|" disabled "|" nodes}
    /^sharedlvmthin:[[:space:]]+/{emit(); inside=1; sid=$2; disabled="0"; nodes=""; next}
    /^[^[:space:]]/{emit(); inside=0; next}
    inside && $1=="disable"{disabled=(NF==1?"1":tolower($2)); next}
    inside && $1=="nodes"{nodes=$2; next}
    END{emit()}
' /etc/pve/storage.cfg)

if ps -eo stat= | grep -q '^D'; then
    echo "FAIL=global-dstate-present"
    fail=$((fail + 1))
else
    echo "PASS=no-global-dstate"
    pass=$((pass + 1))
fi

echo "COMPAT_PASS=$pass"
echo "COMPAT_FAIL=$fail"
if [ "$fail" -ne 0 ]; then
    echo "COMPATIBILITY=FAIL"
    exit 2
fi
echo "COMPATIBILITY=PASS"
