#!/usr/bin/perl
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use PVE::Cluster;
use PVE::QemuConfig;
use PVE::QemuServer;
use PVE::QemuServer::Helpers;
use PVE::Storage;
use PVE::Storage::Custom::SharedLvmThinPlugin;

sub usage {
    die "Usage: sharedlvmthin storage-move-preflight <vmid> <disk> <target-storage>\n";
}

my ($vmid, $disk, $target_store, @extra) = @ARGV;
usage() if !defined($vmid) || !defined($disk) || !defined($target_store) || @extra;
die "VMID must be a positive decimal integer\n"
    if $vmid !~ /^(\d+)$/ || $1 < 1;
$vmid = int($1);
die "disk key is unsafe or unsupported\n"
    if $disk !~ /^(?:(?:ide|sata|scsi|virtio)[0-9]+|efidisk0|tpmstate0)$/;
die "target storage ID is unsafe\n"
    if $target_store !~ /^([A-Za-z0-9][A-Za-z0-9_.-]{0,63})$/;
$target_store = $1;

PVE::Cluster::cfs_update();
my ($local_node, $local_boot) =
    PVE::Storage::Custom::SharedLvmThinPlugin->_lazy_local_identity();
my $config_path = "/etc/pve/local/qemu-server/$vmid.conf";
die "VM $vmid is not owned by local source node '$local_node'\n"
    if !-f $config_path;

open(my $config_fh, '<', $config_path)
    or die "cannot read VM $vmid configuration: $!\n";
local $/;
my $config_bytes = <$config_fh>;
close($config_fh) or die "cannot close VM $vmid configuration: $!\n";
my $config_sha256 = sha256_hex($config_bytes // '');

my $conf = PVE::QemuConfig->load_config($vmid);
my (@blocked, @passed);
push @blocked, "VM_CONFIG: VM has lock '$conf->{lock}'"
    if defined($conf->{lock}) && $conf->{lock} ne '';
push @blocked, "DISK: '$disk' is absent from the current VM configuration"
    if !defined($conf->{$disk}) || $conf->{$disk} eq '';

my ($source_store, $volname, $volid);
if (defined($conf->{$disk}) && $conf->{$disk} ne '') {
    my $drive = PVE::QemuServer::parse_drive($disk, $conf->{$disk});
    if (!$drive || !defined($drive->{file}) || $drive->{file} eq '') {
        push @blocked, "DISK: '$disk' is not a storage-backed volume";
    } elsif (($drive->{media} // '') eq 'cdrom') {
        push @blocked, "DISK: '$disk' is a CD-ROM";
    } else {
        $volid = $drive->{file};
        my $parse_ok = eval {
            ($source_store, $volname) = PVE::Storage::parse_volume_id($volid);
            1;
        };
        push @blocked, "DISK: cannot parse volume '$volid': $@" if !$parse_ok;
    }
}

my $storecfg = PVE::Storage::config();
my ($source_scfg, $target_scfg);
if (defined($source_store)) {
    my $source_ok = eval {
        $source_scfg = PVE::Storage::storage_config($storecfg, $source_store);
        1;
    };
    push @blocked, "SOURCE: storage '$source_store' is unavailable: $@" if !$source_ok;
}
my $target_ok = eval {
    $target_scfg = PVE::Storage::storage_check_enabled($storecfg, $target_store);
    1;
};
push @blocked, "TARGET: storage '$target_store' is unavailable or disabled on '$local_node': $@"
    if !$target_ok;
push @blocked, "TARGET: source and target storage are identical"
    if defined($source_store) && $source_store eq $target_store;

if ($source_scfg) {
    if (($source_scfg->{type} // '') ne 'sharedlvmthin') {
        push @passed, "$volid: external source; native PVE admission remains authoritative";
    } elsif (!$source_scfg->{shared}) {
        push @blocked, "$volid: sharedlvmthin source is not configured shared";
    } else {
        my $mode = PVE::Storage::Custom::SharedLvmThinPlugin->_allocation_mode($source_scfg);
        if ($mode eq 'thin') {
            push @passed, "$volid: Thin source does not use the Lazy activation graph";
        } else {
            my $read_ok = eval {
                my ($state) =
                    PVE::Storage::Custom::SharedLvmThinPlugin->_thick_read_anchor(
                        $source_store, $source_scfg, $volname,
                    );
                my $phase = $state->{phase} // 'UNKNOWN';
                if ($phase eq 'MATERIALIZED') {
                    push @passed, "$volid: materialized Thick source";
                } elsif ($mode ne 'thick-generations-lazy') {
                    push @blocked, "$volid: Eager Thick anchor is '$phase', not MATERIALIZED";
                } elsif ($phase eq 'LAZY_DORMANT') {
                    push @blocked,
                        "$volid: unmaterialized Lazy source is still closed; materialize it "
                        . "with 'sharedlvmthin thick-lazy-materialize $source_store $volname' "
                        . "on its exact owner before dispatching native Storage Move";
                } elsif ($phase eq 'LAZY_ACTIVE') {
                    my $owner_node = $state->{owner_node} // '';
                    my $owner_boot = $state->{owner_boot} // '';
                    if ($owner_node eq $local_node && $owner_boot eq $local_boot) {
                        push @blocked,
                            "$volid: active unmaterialized Lazy source; materialize it on "
                            . "this exact owner before native Storage Move";
                    } else {
                        push @blocked,
                            "$volid: active Lazy owner is not this exact node/boot epoch; "
                            . "use ownership recovery and do not dispatch Storage Move";
                    }
                } else {
                    push @blocked,
                        "$volid: Lazy transition phase '$phase' requires explicit recovery "
                        . "or completion before Storage Move";
                }
                1;
            };
            push @blocked, "$volid: anchor inspection failed: $@" if !$read_ok;
        }
    }
}

if ($target_scfg) {
    push @passed, "TARGET: storage '$target_store' is enabled on '$local_node'";
}

my $running = PVE::QemuServer::Helpers::vm_running_locally($vmid) ? 1 : 0;
print "STORAGE_MOVE_PREFLIGHT_VERSION=1\n";
print "VMID=$vmid\nNODE=$local_node\nBOOT_ID=$local_boot\nDISK=$disk\n";
print "VM_STATE=" . ($running ? 'RUNNING' : 'STOPPED') . "\n";
print "CONFIG_SHA256=$config_sha256\n";
print "SOURCE_VOLUME=$volid\n" if defined($volid);
print "TARGET_STORAGE=$target_store\n";
print "PASS=$_\n" for @passed;
print "BLOCKED=$_\n" for @blocked;
if (@blocked) {
    print "STORAGE_MOVE_READY=NO\nRESULT=BLOCKED\n";
    exit 2;
}
print "STORAGE_MOVE_READY=YES\nRESULT=PASS\n";
exit 0;
