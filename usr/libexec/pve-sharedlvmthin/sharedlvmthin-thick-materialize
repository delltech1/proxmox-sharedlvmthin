#!/usr/bin/perl
# SPDX-License-Identifier: GPL-3.0-only

use strict;
use warnings;

use PVE::Storage;
use PVE::Storage::Custom::SharedLvmThinPlugin;

my $derive = @ARGV == 3 && $ARGV[0] eq '--resume';
die "Usage: sharedlvmthin-thick-materialize <storage-id> <volume> <snapshot> <operation> <transaction>\n"
    . "       sharedlvmthin-thick-materialize --resume <storage-id> <volume>\n"
    if !$derive && @ARGV != 5;

my ($storeid, $volname, $snapshot, $operation, $transaction) =
    $derive ? ($ARGV[1], $ARGV[2], undef, undef, undef) : @ARGV;
die "invalid storage identifier\n"
    if !defined($storeid) || $storeid !~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/;
die "invalid Thick Generations volume name\n"
    if !defined($volname) || $volname !~ /^(?:vm|base)-\d+-disk-\d+$/;

my $cfg = PVE::Storage::config();
my $scfg = PVE::Storage::storage_config($cfg, $storeid);
die "storage '$storeid' is not SharedLvmThin\n"
    if ($scfg->{type} // '') ne 'sharedlvmthin';

my $class = 'PVE::Storage::Custom::SharedLvmThinPlugin';
die "storage '$storeid' is not configured for Thick Generations\n"
    if $class->_allocation_mode($scfg) ne 'thick-generations';
$class->_require_thick_identity_config($storeid, $scfg);

if ($derive) {
    my ($state) = $class->_thick_read_anchor($storeid, $scfg, $volname);
    my $phase = $state->{phase} // '';
    die "volume '$storeid:$volname' has no resumable materialization transition\n"
        if $phase ne 'HYDRATING'
        && $phase ne 'HYDRATION_COMPLETE'
        && $phase ne 'LINEAR_PIVOTED';
    $snapshot = $state->{snapshot};
    $operation = $state->{op};
    $transaction = $state->{tx};
}

die "invalid snapshot name\n"
    if !defined($snapshot) || $snapshot !~ /^[A-Za-z0-9_.+-]+$/;
die "invalid materialization operation\n"
    if !defined($operation) || $operation ne 'SNAPSHOT';
die "invalid transaction UUID\n"
    if !defined($transaction) || $transaction !~ /^[0-9a-f]{32}$/;

my $vg = $scfg->{'slt-vgname'};
my $device = "/dev/mapper/$scfg->{'slt-expected-wwid'}";
my $intent = $class->_read_vg_intent($vg, $device);
die "transaction '$transaction' no longer has an OPEN VG intent\n"
    if !defined($intent);
die "OPEN VG intent does not match materialization transaction '$transaction'\n"
    if ($intent->{tx} // '') ne $transaction
    || ($intent->{state} // '') ne 'OPEN'
    || ($intent->{op} // '') ne 'DM_CUTOVER';

print "MATERIALIZATION_START transaction=$transaction storage=$storeid volume=$volname\n";
$class->_thick_volume_snapshot(
    $scfg, $storeid, $volname, $snapshot, $operation, 1,
);
print "MATERIALIZATION_COMPLETE transaction=$transaction storage=$storeid volume=$volname\n";

exit 0;
