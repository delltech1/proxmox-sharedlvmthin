set -u

STORAGECFG=/etc/pve/storage.cfg
RECOVERY_CHECK=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-recovery-check
UPDATE_POLICY=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-update-policy
PROBE_TIMEOUT=150

failures=0
checked=0
skipped=0
checked_disabled=0
skipped_node_scope=0
result=
inventory_result=
fail_fast=0
runtime_qualification=0
runtime_operational=0
scan_complete=1
declare -A seen=()

case "$#" in
    0) ;;
    1)
        case "$1" in
            --fail-fast) fail_fast=1 ;;
            --runtime-qualification) runtime_qualification=1 ;;
            --runtime-operational) runtime_operational=1 ;;
            *)
                echo "Usage: sharedlvmthin-upgrade-check [--fail-fast|--runtime-qualification|--runtime-operational]" >&2
                exit 64
                ;;
        esac
        ;;
    *)
        echo "Usage: sharedlvmthin-upgrade-check [--fail-fast]" >&2
        exit 64
        ;;
esac

# Invoked through the signal and exit trap below.
# shellcheck disable=SC2317,SC2329
cleanup() {
    [ -z "$result" ] || rm -f -- "$result"
    [ -z "$inventory_result" ] || rm -f -- "$inventory_result"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

case "$PROBE_TIMEOUT" in
    ''|*[!0-9]*)
        echo "UPGRADE_SAFE=NO" >&2
        echo "ERROR=probe timeout must be an integer" >&2
        exit 64
        ;;
esac

if [ "$PROBE_TIMEOUT" -lt 1 ] || [ "$PROBE_TIMEOUT" -gt 600 ]; then
    echo "UPGRADE_SAFE=NO" >&2
    echo "ERROR=probe timeout must be between 1 and 600 seconds" >&2
    exit 64
fi

if [ ! -r "$STORAGECFG" ]; then
    echo "UPGRADE_SAFE=NO"
    echo "ERROR=storage configuration is not readable"
    exit 2
fi

if [ ! -x "$RECOVERY_CHECK" ]; then
    echo "UPGRADE_SAFE=NO"
    echo "ERROR=recovery checker is not executable"
    exit 2
fi

if [ ! -x "$UPDATE_POLICY" ]; then
    echo "UPGRADE_SAFE=NO"
    echo "ERROR=update-policy integrity checker is not executable"
    exit 2
fi
if [ "$runtime_qualification" -eq 0 ] && [ "$runtime_operational" -eq 0 ]; then
    if ! policy_status=$("$UPDATE_POLICY" status 2>&1); then
        printf '%s\n' "$policy_status"
        echo "UPGRADE_SAFE=NO"
        echo "ERROR=update-policy state is unsettled, ambiguous or has integrity drift"
        exit 2
    fi
    printf '%s\n' "$policy_status"
else
    echo "UPDATE_POLICY_STATUS=HELD_BY_RUNTIME_GATE"
fi

inventory() {
    awk '
        function emit() {
            if (inside) {
                print sid "|" disabled "|" mode "|" nodes
            }
        }
        /^sharedlvmthin:[[:space:]]+/ {
            emit()
            inside=1
            sid=$2
            disabled="0"
            mode="thin"
            nodes=""
            next
        }
        /^[^[:space:]]/ {
            emit()
            inside=0
            next
        }
        inside && $1 == "disable" {
            disabled=(NF == 1 ? "1" : tolower($2))
            next
        }
        inside && $1 == "slt-allocation-mode" {
            mode=$2
            next
        }
        inside && $1 == "nodes" {
            nodes=$2
            next
        }
        END { emit() }
    ' "$STORAGECFG"
}

local_node=$(hostname)

if ! inventory_result=$(mktemp); then
    echo "UPGRADE_SCAN_COMPLETE=NO"
    echo "UPGRADE_SAFE=NO"
    echo "ERROR=could not create private storage inventory"
    exit 2
fi
if ! inventory >"$inventory_result"; then
    echo "UPGRADE_SCAN_COMPLETE=NO"
    echo "UPGRADE_SAFE=NO"
    echo "ERROR=storage inventory failed"
    exit 2
fi

while IFS='|' read -r sid disabled mode nodes; do
    [ -n "$sid" ] || continue

    if [[ ! "$sid" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
        echo "STORAGE_ID=$sid"
        echo "RESULT=FAIL"
        echo "DETAIL=invalid storage identifier"
        failures=$((failures + 1))
        if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
        continue
    fi

    if [ -n "${seen[$sid]+x}" ]; then
        echo "STORAGE_ID=$sid"
        echo "RESULT=FAIL"
        echo "DETAIL=duplicate storage identifier"
        failures=$((failures + 1))
        if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
        continue
    fi
    seen[$sid]=1

    case "$disabled" in
        0|no|off|false|1|yes|on|true) ;;
        *)
            echo "STORAGE_ID=$sid"
            echo "RESULT=FAIL"
            echo "DETAIL=invalid disable value"
            failures=$((failures + 1))
            if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
            continue
            ;;
    esac

    if [ -n "$nodes" ]; then
        case ",$nodes," in
            *",$local_node,"*) ;;
            *)
                echo "STORAGE_ID=$sid"
                echo "RESULT=SKIP_NODE_SCOPE"
                skipped=$((skipped + 1))
                skipped_node_scope=$((skipped_node_scope + 1))
                continue
                ;;
        esac
    fi

    case "$mode" in
        thin|thick-generations|thick-generations-lazy) ;;
        *)
            echo "STORAGE_ID=$sid"
            echo "RESULT=FAIL"
            echo "DETAIL=unsupported allocation mode"
            failures=$((failures + 1))
            if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
            continue
            ;;
    esac

    case "$disabled" in
        1|yes|on|true)
            checked_disabled=$((checked_disabled + 1))
            echo "UPGRADE_STORAGE_DISABLED=YES"
            ;;
    esac

    checked=$((checked + 1))
    echo "UPGRADE_STORAGE_ID=$sid"
    echo "UPGRADE_ALLOCATION_MODE=$mode"
    if ! result=$(mktemp); then
        echo "UPGRADE_STORAGE_RESULT=FAIL"
        echo "UPGRADE_STORAGE_DETAIL=could not create private probe output"
        failures=$((failures + 1))
        if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
        continue
    fi
    recovery_args=("$sid")
    if [ "$runtime_qualification" -eq 1 ]; then
        recovery_args=(--runtime-qualification "$sid")
    fi
    if timeout --foreground --kill-after=10 "$PROBE_TIMEOUT" \
        "$RECOVERY_CHECK" "${recovery_args[@]}" >"$result" 2>&1; then
        rc=0
    else
        rc=$?
    fi

    cat "$result"

    if [ "$runtime_qualification" -eq 1 ]; then
        healthy=$(grep -c '^RUNTIME_QUALIFICATION_READY=YES$' "$result" || true)
        safe=$healthy
    else
        healthy=$(grep -c '^STATE=HEALTHY$' "$result" || true)
        safe=$(grep -c '^SAFE_FOR_MUTATION=YES$' "$result" || true)
    fi
    anchors=$(grep -c '^THICK_ANCHORS_HEALTHY=PASS$' "$result" || true)
    intent_clear=$(grep -c '^VG_INTENT_CLEAR=PASS$' "$result" || true)

    rm -f -- "$result"
    result=

    if [ "$rc" -eq 0 ] && [ "$healthy" -eq 1 ] && \
       [ "$safe" -eq 1 ] && [ "$anchors" -eq 1 ] && \
       [ "$intent_clear" -eq 1 ]; then
        echo "UPGRADE_STORAGE_RESULT=PASS"
    else
        echo "UPGRADE_STORAGE_RESULT=FAIL"
        echo "UPGRADE_STORAGE_DETAIL=recovery gate did not positively prove a healthy mutation-safe state"
        failures=$((failures + 1))
        if [ "$fail_fast" -eq 1 ]; then scan_complete=0; break; fi
    fi
done <"$inventory_result"

if [ "$fail_fast" -eq 1 ]; then
    echo "UPGRADE_FAIL_FAST=YES"
else
    echo "UPGRADE_FAIL_FAST=NO"
fi
if [ "$scan_complete" -eq 1 ]; then
    echo "UPGRADE_SCAN_COMPLETE=YES"
else
    echo "UPGRADE_SCAN_COMPLETE=NO"
fi
echo "UPGRADE_STORAGES_CHECKED=$checked"
echo "UPGRADE_STORAGES_SKIPPED_DISABLED=0"
echo "UPGRADE_STORAGES_CHECKED_EXPLICITLY_DISABLED=$checked_disabled"
echo "UPGRADE_STORAGES_SKIPPED_NODE_SCOPE=$skipped_node_scope"

if [ "$failures" -ne 0 ]; then
    echo "UPGRADE_SAFE=NO"
    exit 2
fi

echo "UPGRADE_SAFE=YES"
if [ "$runtime_qualification" -eq 1 ]; then
    echo "RUNTIME_QUALIFICATION_READY=YES"
fi
exit 0
