def page(title,body):
    return "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>"+html.escape(title)+"</title><style>"+CSS+"</style></head><body><div class='w'><div class='brand'>SharedLvmThin <span>Health</span></div>"+body+"<div class='note' style='text-align:center;margin-top:14px'>Authentication handled by Proxmox VE · <span class='ro'>READ ONLY</span></div></div></body></html>"

def login(error="",user=""):
    e="<div class='err'>"+html.escape(error)+"</div>" if error else ""
    b="<div class='card'><h1>Proxmox VE Authentication</h1><div class='sub'>Use an existing PVE administrator account.</div>"+e
    b+="<form method='post' action='/auth/login'><label>Username / realm</label><input name='username' value='"+html.escape(user)+"' placeholder='admin@pve' maxlength='256' required autofocus>"
    b+="<label>Password</label><input type='password' name='password' maxlength='4096' required><button>Sign in</button></form></div>"
    return page("SharedLvmThin Login",b)

def tfa(pid,user,error=""):
    e="<div class='err'>"+html.escape(error)+"</div>" if error else ""
    b="<div class='card'><h1>Two-Factor Authentication</h1><div class='sub'>Additional PVE factor required for "+html.escape(user)+".</div>"+e
    b+="<form method='post' action='/auth/tfa'><input type='hidden' name='pending_id' value='"+html.escape(pid)+"'><label>Factor</label>"
    b+="<select name='factor'><option value='totp'>TOTP</option><option value='recovery'>Recovery key</option><option value='yubico'>YubiKey OTP</option></select>"
    b+="<label>Response</label><input name='response' maxlength='1024' required autofocus><button>Verify</button></form>"
    b+="<div class='note' style='margin-top:12px'>The response is verified by Proxmox VE. WebAuthn needs a browser-origin ceremony and is not emulated in this version; use another configured PVE factor.</div></div>"
    return page("Two-Factor Authentication",b)

class H(SimpleHTTPRequestHandler):
    server_version="SharedLvmThinHealth/0.2"
    def __init__(self,*a,**kw): super().__init__(*a,directory=WEBROOT,**kw)
    def log_message(self,fmt,*a): print(f"{self.client_address[0]} - {fmt%a}",flush=True)
    def end_headers(self):
        for k,v in [("X-Content-Type-Options","nosniff"),("X-Frame-Options","DENY"),("Referrer-Policy","no-referrer"),("Cache-Control","no-store"),("Content-Security-Policy","default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:")]: self.send_header(k,v)
        super().end_headers()
    def send_html(self,s,status=200):
        b=s.encode(); self.send_response(status); self.send_header("Content-Type","text/html; charset=utf-8"); self.send_header("Content-Length",str(len(b))); self.end_headers(); self.wfile.write(b)
    def send_json(self,d,status=200):
        b=json.dumps(d).encode(); self.send_response(status); self.send_header("Content-Type","application/json"); self.send_header("Content-Length",str(len(b))); self.end_headers(); self.wfile.write(b)
    def redirect(self,p,cookie=None):
        self.send_response(303); self.send_header("Location",p)
        if cookie: self.send_header("Set-Cookie",cookie)
        self.end_headers()
    def form(self):
        try: n=int(self.headers.get("Content-Length","0"))
        except: n=0
        if n<1 or n>MAX_BODY: return {}
        raw=self.rfile.read(n).decode("utf-8","replace")
        return {k:v[-1] for k,v in urllib.parse.parse_qs(raw,keep_blank_values=True).items()}
    def do_GET(self):
        p=urlparse(self.path).path
        if p=="/login":
            _,s=session_from(self.headers); return self.redirect("/") if s else self.send_html(login())
        if p=="/logout":
            tok,_=session_from(self.headers)
            if tok:
                with lock: sessions.pop(tok,None)
            return self.redirect("/login",f"{COOKIE}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Strict")
        if p=="/api/health":
            _,s=session_from(self.headers)
            if not s: return self.send_json({"error":"unauthorized"},401)
            return self.send_json(self.server.health_cache.snapshot())
        if p=="/api/version":
            _,s=session_from(self.headers)
            if not s: return self.send_json({"error":"unauthorized"},401)
            return self.send_json({
                "service":"SharedLvmThin Health",
                "api":2,
                "mode":"read-only",
                "user":s["user"],
                "authorization":s.get("auth","pve"),
            })
        if p=="/":
            _,s=session_from(self.headers)
            if not s: return self.redirect("/login")
        return super().do_GET()
    def do_POST(self):
        p=urlparse(self.path).path; ip=self.client_address[0]; cleanup()
        if p=="/auth/login":
            if len(attempts[ip])>=8: return self.send_html(login("Too many attempts. Try again shortly."),429)
            f=self.form(); user=f.get("username","").strip(); pw=f.get("password","")
            if not user or not pw: return self.send_html(login("Username and password required.",user),400)
            try:
                a=pve("/access/ticket",{"username":user,"password":pw})
                if not isinstance(a,dict) or not a.get("ticket"): raise RuntimeError()
                if a.get("NeedTFA") is not None:
                    pid=secrets.token_urlsafe(24)
                    with lock: pending[pid]={"user":a.get("username") or user,"challenge":a["ticket"],"expires":time.monotonic()+TFA_TTL,"attempts":0}
                    return self.send_html(tfa(pid,a.get("username") or user))
                user=a.get("username") or user; ok,why=authorized(user,a["ticket"])
                if not ok: return self.send_html(login("Authenticated, but PVE administrator privileges are required.",user),403)
                tok=secrets.token_urlsafe(32)
                with lock: sessions[tok]={"user":user,"auth":why,"seen":time.monotonic()}
                attempts.pop(ip,None)
                return self.redirect("/",session_cookie(tok))
            except Exception:
                attempts[ip].append(time.monotonic()); return self.send_html(login("Authentication failed.",user),401)
        if p=="/auth/tfa":
            f=self.form(); pid=f.get("pending_id",""); factor=f.get("factor",""); response=f.get("response","").strip()
            with lock: q=pending.get(pid)
            if not q: return self.send_html(login("Two-factor challenge expired. Please sign in again."),401)
            if q.get("attempts",0) >= TFA_MAX_ATTEMPTS:
                with lock: pending.pop(pid,None)
                return self.send_html(login("Too many two-factor attempts. Please sign in again."),429)
            if factor not in {"totp","recovery","yubico"} or not response: return self.send_html(tfa(pid,q["user"],"Invalid factor response."),400)
            try:
                a=pve("/access/ticket",{"username":q["user"],"password":f"{factor}:{response}","tfa-challenge":q["challenge"]})
                if not isinstance(a,dict) or not a.get("ticket") or a.get("NeedTFA") is not None: raise RuntimeError()
                user=a.get("username") or q["user"]; ok,why=authorized(user,a["ticket"])
                if not ok:
                    with lock: pending.pop(pid,None)
                    return self.send_html(login("Authenticated, but PVE administrator privileges are required.",user),403)
                tok=secrets.token_urlsafe(32)
                with lock:
                    pending.pop(pid,None); sessions[tok]={"user":user,"auth":why,"seen":time.monotonic()}
                attempts.pop(ip,None)
                return self.redirect("/",session_cookie(tok))
            except Exception:
                with lock:
                    if pid in pending: pending[pid]["attempts"]=pending[pid].get("attempts",0)+1
                return self.send_html(tfa(pid,q["user"],"Two-factor verification failed."),401)
        if p=="/auth/logout":
            tok,_=session_from(self.headers)
            if tok:
                with lock: sessions.pop(tok,None)
            return self.redirect("/login",f"{COOKIE}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Strict")
        return self.send_error(405,"Read-only service")
    def do_PUT(self): self.send_error(405,"Read-only service")
    def do_DELETE(self): self.send_error(405,"Read-only service")
    def do_PATCH(self): self.send_error(405,"Read-only service")

def main():
    health_cache=HealthCache(COLLECTOR,HEALTH_REFRESH,COLLECTOR_TIMEOUT)
    health_cache.start()
    srv=ThreadingHTTPServer((ADDR,PORT),H)
    srv.health_cache=health_cache
    ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.minimum_version=ssl.TLSVersion.TLSv1_2; ctx.load_cert_chain(CERT,KEY)
    srv.socket=ctx.wrap_socket(srv.socket,server_side=True)
    print(f"SharedLvmThin Health listening on https://{ADDR}:{PORT} (PVE auth enabled)",flush=True)
    try:
        srv.serve_forever()
    finally:
        health_cache.stop()

if __name__ == "__main__":
    main()
