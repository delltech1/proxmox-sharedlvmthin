#!/usr/bin/python3
import configparser, copy, datetime, html, json, os, secrets, ssl, subprocess, threading, time
import urllib.parse, urllib.request
from collections import defaultdict, deque
from http.cookies import SimpleCookie
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from urllib.parse import urlparse

CONFIG=os.environ.get("SHAREDLVMTHIN_WEB_CONFIG","/etc/pve-sharedlvmthin/web.conf"); WEBROOT="/usr/share/pve-sharedlvmthin/web"
COLLECTOR="/usr/libexec/pve-sharedlvmthin/sharedlvmthin-health-json"
PVE="https://127.0.0.1:8006/api2/json"; COOKIE="SLTSESSION"
DEFAULT_IDLE=1800; MIN_IDLE=60; MAX_IDLE=86400
DEFAULT_REFRESH=30; MIN_REFRESH=5; MAX_REFRESH=3600
DEFAULT_COLLECTOR_TIMEOUT=120; MIN_COLLECTOR_TIMEOUT=5; MAX_COLLECTOR_TIMEOUT=600
TFA_TTL=120; TFA_MAX_ATTEMPTS=8; MAX_BODY=32768
REQUIRED={"Sys.Audit","Sys.Modify","Datastore.Audit","Permissions.Modify"}

cfg=configparser.ConfigParser(); cfg.read(CONFIG)
ADDR=cfg["web"]["address"]; PORT=cfg["web"].getint("port")
CERT=cfg["tls"]["certificate"]; KEY=cfg["tls"]["private_key"]

ACCESS_MODE=cfg.get("auth","access_mode",fallback="administrator").strip()
ACCESS_GROUP=cfg.get("auth","group",fallback="").strip()

def bounded_int(section,key,default,minimum,maximum):
    try:
        value=cfg.getint(section,key,fallback=default)
    except ValueError as e:
        raise RuntimeError(f"{section}.{key} must be an integer") from e
    if value < minimum or value > maximum:
        raise RuntimeError(
            f"{section}.{key} must be between {minimum} and {maximum}"
        )
    return value

IDLE=bounded_int("auth","session_idle_seconds",DEFAULT_IDLE,MIN_IDLE,MAX_IDLE)
HEALTH_REFRESH=bounded_int("health","refresh_interval_seconds",DEFAULT_REFRESH,MIN_REFRESH,MAX_REFRESH)
COLLECTOR_TIMEOUT=bounded_int("health","collector_timeout_seconds",DEFAULT_COLLECTOR_TIMEOUT,MIN_COLLECTOR_TIMEOUT,MAX_COLLECTOR_TIMEOUT)

if ACCESS_MODE not in {"administrator","group"}:
    raise RuntimeError("invalid auth.access_mode")

if ACCESS_MODE == "group" and not ACCESS_GROUP:
    raise RuntimeError("auth.group is required for group access mode")

sessions={}; pending={}; attempts=defaultdict(deque); lock=threading.RLock()

def pve_ctx():
    ca="/etc/pve/pve-root-ca.pem"
    if os.path.exists(ca):
        c=ssl.create_default_context(cafile=ca); c.check_hostname=False; return c
    c=ssl.create_default_context(); c.check_hostname=False; c.verify_mode=ssl.CERT_NONE; return c
PVE_SSL=pve_ctx()

def pve(path,data=None,ticket=None):
    h={"Accept":"application/json"}; body=None; method="GET"
    if data is not None:
        body=urllib.parse.urlencode(data).encode(); h["Content-Type"]="application/x-www-form-urlencoded"; method="POST"
    if ticket: h["Cookie"]="PVEAuthCookie="+ticket
    req=urllib.request.Request(PVE+path,data=body,method=method,headers=h)
    with urllib.request.urlopen(req,context=PVE_SSL,timeout=10) as r:
        return json.loads(r.read()).get("data")

def authorized(user,ticket):
    if ACCESS_MODE == "administrator":
        if user == "root@pam":
            return True,"pve-superuser"

        d=pve(
            "/access/permissions?"
            + urllib.parse.urlencode({"path":"/"}),
            ticket=ticket,
        )

        if not isinstance(d,dict):
            return False,"permissions unavailable"

        perms=d.get("/") if isinstance(d.get("/"),dict) else d
        effective={k for k,v in perms.items() if v}

        ok=REQUIRED.issubset(effective)

        return ok,(
            "pve-rbac"
            if ok
            else "administrator privileges required"
        )

    if ACCESS_MODE == "group":
        groups=pve("/access/groups",ticket=ticket)

        if not isinstance(groups,list):
            return False,"unable to read PVE groups"

        for group in groups:
            if group.get("groupid") != ACCESS_GROUP:
                continue

            members=group.get("users") or ""

            if isinstance(members,str):
                users={
                    x.strip()
                    for x in members.split(",")
                    if x.strip()
                }
            elif isinstance(members,list):
                users=set(members)
            else:
                users=set()

            if user in users:
                return True,"pve-group:" + ACCESS_GROUP

            return False,"user is not member of allowed PVE group"

        return False,"configured PVE group not found"

    return False,"invalid access policy"

def cleanup():
    n=time.monotonic()
    with lock:
        for k in list(sessions):
            if n-sessions[k]["seen"]>IDLE: sessions.pop(k,None)
        for k in list(pending):
            if n>pending[k]["expires"]: pending.pop(k,None)
        for ip in list(attempts):
            while attempts[ip] and n-attempts[ip][0]>60: attempts[ip].popleft()
            if not attempts[ip]: attempts.pop(ip,None)

def session_from(headers):
    cleanup(); raw=headers.get("Cookie")
    if not raw: return None,None
    c=SimpleCookie()
    try: c.load(raw)
    except Exception: return None,None
    m=c.get(COOKIE)
    if not m: return None,None
    with lock:
        s=sessions.get(m.value)
        if not s: return None,None
        s["seen"]=time.monotonic(); return m.value,dict(s)

def session_cookie(token):
    # The server enforces a sliding idle timeout. A fixed browser Max-Age
    # would expire an actively used session exactly IDLE seconds after login.
    return f"{COOKIE}={token}; Path=/; Secure; HttpOnly; SameSite=Strict"

def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()

class HealthCache:
    def __init__(self,collector,interval,timeout,runner=subprocess.run):
        self.collector=collector
        self.interval=interval
        self.timeout=timeout
        self.runner=runner
        self.lock=threading.RLock()
        self.payload=None
        self.generated_monotonic=None
        self.generated_at=None
        self.last_success=None
        self.last_error=None
        self.refresh_running=False
        self.stop_event=threading.Event()
        self.thread=None

    def refresh(self):
        with self.lock:
            if self.refresh_running:
                return False
            self.refresh_running=True
        try:
            result=self.runner(
                [self.collector],capture_output=True,text=True,
                timeout=self.timeout,
            )
            if result.returncode:
                raise RuntimeError(
                    result.stderr.strip() or f"collector exit {result.returncode}"
                )
            payload=json.loads(result.stdout)
            if not isinstance(payload,dict):
                raise RuntimeError("collector did not return a JSON object")
            now=utc_now()
            with self.lock:
                self.payload=payload
                self.generated_monotonic=time.monotonic()
                self.generated_at=now
                self.last_success=now
                self.last_error=None
            return True
        except Exception as e:
            with self.lock:
                self.last_error=str(e)
            return False
        finally:
            with self.lock:
                self.refresh_running=False

    def snapshot(self):
        with self.lock:
            payload=(
                copy.deepcopy(self.payload)
                if self.payload is not None
                else {"result":"UNKNOWN","error":"health snapshot not ready"}
            )
            age=(
                max(0,int(time.monotonic()-self.generated_monotonic))
                if self.generated_monotonic is not None
                else None
            )
            payload["cache"]={
                "refresh_running":self.refresh_running,
                "generated_at":self.generated_at,
                "age_seconds":age,
                "last_success":self.last_success,
                "last_error":self.last_error,
            }
            return payload

    def _loop(self):
        while not self.stop_event.is_set():
            self.refresh()
            self.stop_event.wait(self.interval)

    def start(self):
        self.thread=threading.Thread(
            target=self._loop,name="sharedlvmthin-health-cache",daemon=True,
        )
        self.thread.start()

    def stop(self):
        self.stop_event.set()
        if self.thread:
            self.thread.join(timeout=min(self.timeout+1,10))

