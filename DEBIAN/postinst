#!/bin/sh
set -e

PLUGIN=/usr/share/perl5/PVE/Storage/Custom/SharedLvmThinPlugin.pm
MONITOR=/usr/libexec/pve-sharedlvmthin/pve-sharedlvmthin-monitor
MATERIALIZER=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-thick-materialize
THIN_GUARDD=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-guardd
HEALTH=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-health-json
PVE_INVENTORY=/usr/libexec/pve-sharedlvmthin/sharedlvmthin_pve_inventory.py
WEB=/usr/libexec/pve-sharedlvmthin/sharedlvmthin-web
CONF=/etc/pve-sharedlvmthin/web.conf
SERVICE=pve-sharedlvmthin-web.service
THIN_GUARD_SERVICE=pve-sharedlvmthin-thin-guard.service
PACKAGE_FLAVOR_FILE=/usr/share/pve-sharedlvmthin/package-flavor
PACKAGE_FLAVOR=$(sed -n '1p' "$PACKAGE_FLAVOR_FILE" 2>/dev/null || true)
[ "$PACKAGE_FLAVOR" = "dual" ] || [ "$PACKAGE_FLAVOR" = "thick-only" ] || {
    echo "ERROR: invalid or missing SharedLvmThin package flavor" >&2
    exit 1
}
POSTINST_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ "$PACKAGE_FLAVOR" = "dual" ]; then
    MAINTENANCE_CONTROL_PACKAGE=pve-sharedlvmthin
else
    MAINTENANCE_CONTROL_PACKAGE=pve-sharedlvmthin-thick
fi
if [ -n "${DPKG_MAINTSCRIPT_PACKAGE:-}" ] && \
   [ "$DPKG_MAINTSCRIPT_PACKAGE" != "$MAINTENANCE_CONTROL_PACKAGE" ]; then
    echo "ERROR: maintainer-script package identity differs from package flavor." >&2
    exit 1
fi
MAINTENANCE_CHECK="$POSTINST_DIR/$MAINTENANCE_CONTROL_PACKAGE.sharedlvmthin-package-maintenance-check"
PACKAGE_ARTIFACT_FILE=/usr/share/pve-sharedlvmthin/package-artifact-sha256
MAINTENANCE_CONFIGURE=0
PACKAGE_VERSION=
PACKAGE_ARTIFACT=
if [ ! -x "$MAINTENANCE_CHECK" ]; then
    echo "ERROR: candidate package maintenance probe is missing." >&2
    exit 1
fi
if "$MAINTENANCE_CHECK" --probe-hold; then
    MAINTENANCE_HOLD=1
else
    maintenance_probe_rc=$?
    if [ "$maintenance_probe_rc" -eq 3 ]; then
        MAINTENANCE_HOLD=0
    else
        echo "ERROR: package maintenance hold state is unsafe or unknown." >&2
        exit 1
    fi
fi

if [ "$MAINTENANCE_HOLD" -eq 1 ]; then
    [ "$PACKAGE_FLAVOR" = "dual" ] || {
        echo "ERROR: package maintenance transaction exists for a non-DUAL profile." >&2
        exit 1
    }
    PACKAGE_VERSION=$(dpkg-query -W -f='${Version}' "${DPKG_MAINTSCRIPT_PACKAGE:-pve-sharedlvmthin}")
    PACKAGE_ARTIFACT=$(sed -n '1p' "$PACKAGE_ARTIFACT_FILE" 2>/dev/null || true)
    if ! "$MAINTENANCE_CHECK" \
        --phase CONFIG_COMMITTED \
        --package "${DPKG_MAINTSCRIPT_PACKAGE:-pve-sharedlvmthin}" \
        --version "$PACKAGE_VERSION" \
        --flavor "$PACKAGE_FLAVOR" \
        --artifact-sha256 "$PACKAGE_ARTIFACT"; then
        echo "ERROR: package maintenance CONFIG_COMMITTED transaction was not verified." >&2
        exit 1
    fi
    MAINTENANCE_CONFIGURE=1
fi
LVMLOCAL=/etc/lvm/lvmlocal.conf
STATE_DIR=/var/lib/pve-sharedlvmthin
LVM_BEGIN='# BEGIN PVE-SHAREDLVMTHIN MANAGED AUTOGROW'
LVM_END='# END PVE-SHAREDLVMTHIN MANAGED AUTOGROW'

echo
echo "Configuring SharedLvmThin..."

perl -c "$PLUGIN"
perl -c "$MATERIALIZER"
if [ "$PACKAGE_FLAVOR" = "dual" ]; then
    perl -c "$MONITOR"
    perl -c "$THIN_GUARDD"
    python3 - "$MAINTENANCE_CHECK" <<'PY'
import pathlib
import sys
path = pathlib.Path(sys.argv[1])
compile(path.read_bytes(), str(path), "exec")
PY
fi
# Compile source in memory. py_compile would leave unowned __pycache__ files in
# the executable tree and make exact installed-payload attestation ambiguous.
python3 - "$HEALTH" "$PVE_INVENTORY" "$WEB" <<'PY'
import pathlib
import sys
for raw_path in sys.argv[1:]:
    path = pathlib.Path(raw_path)
    compile(path.read_bytes(), str(path), "exec")
PY

# Older package revisions used py_compile. Remove only its well-known cache
# artifacts; never erase an unknown file from the private runtime namespace.
PYTHON_CACHE=/usr/libexec/pve-sharedlvmthin/__pycache__
if [ -L "$PYTHON_CACHE" ]; then
    echo "ERROR: refusing symlinked legacy Python cache directory: $PYTHON_CACHE" >&2
    exit 1
fi
if [ -d "$PYTHON_CACHE" ]; then
    find "$PYTHON_CACHE" -maxdepth 1 -type f \
        \( -name 'sharedlvmthin-health-json*.pyc' \
        -o -name 'sharedlvmthin_pve_inventory*.pyc' \
        -o -name 'sharedlvmthin-web*.pyc' \) -delete
    rmdir "$PYTHON_CACHE" 2>/dev/null || true
fi

chmod 0755 "$MATERIALIZER" "$HEALTH" "$WEB" \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-compat-check \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-recovery-check \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-profile-replacement \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-upgrade-check \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-update-plan \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-snapshot-observe \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-migration-preflight \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-storage-move-preflight \
    /usr/libexec/pve-sharedlvmthin/sharedlvmthin-volume-operation-preflight \
    /usr/sbin/sharedlvmthin \
    /usr/sbin/sharedlvmthin-web-configure

if [ "$PACKAGE_FLAVOR" = "dual" ]; then
    chmod 0755 "$MONITOR" "$THIN_GUARDD" \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-topology \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-metadata-check \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-qmp-path-check
fi

# Install the tested dmeventd policy only when the administrator has not
# already selected any of these settings.  Never overwrite a vendor or local
# SAN policy.  The marked fragment is removable independently during purge.
if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
    echo "Maintenance configure: lvmlocal.conf changes are deferred and must already be prepared."
else
    mkdir -p "$STATE_DIR"
if [ "$PACKAGE_FLAVOR" = "thick-only" ]; then
    if grep -Fq "$LVM_BEGIN" "$LVMLOCAL" 2>/dev/null || \
       grep -Fq "$LVM_END" "$LVMLOCAL" 2>/dev/null; then
        # The dual package owns only this explicitly delimited fragment.
        # Thick-only removes it because its thin_command target is deliberately
        # absent. Require one complete, non-nested block before editing; a
        # damaged marker must preserve the file and fail package configuration.
        if ! awk -v begin="$LVM_BEGIN" -v end="$LVM_END" '
            $0 == begin { if (open || seen) exit 2; open=1; seen=1; next }
            $0 == end { if (!open) exit 2; open=0; closed=1; next }
            END { if (!seen || open || !closed) exit 2 }
        ' "$LVMLOCAL"; then
            echo "ERROR: malformed SharedLvmThin-managed LVM policy markers;" >&2
            echo "preserving $LVMLOCAL unchanged for manual inspection." >&2
            exit 1
        fi
        cp -a "$LVMLOCAL" "$STATE_DIR/lvmlocal.conf.before-thick-only"
        sed -i "/^$LVM_BEGIN$/,/^$LVM_END$/d" "$LVMLOCAL"
        echo "Removed obsolete SharedLvmThin-managed Thin autogrow policy."
    else
        echo "Thick-only package: no SharedLvmThin-managed Thin autogrow policy is present."
        echo "Administrator-owned LVM settings were not modified."
    fi
elif grep -Eq '^[[:space:]]*(thin_command|thin_pool_autoextend_threshold|thin_pool_autoextend_percent)[[:space:]]*=' "$LVMLOCAL" 2>/dev/null; then
    if grep -Fq "$LVM_BEGIN" "$LVMLOCAL" 2>/dev/null; then
        echo "Existing SharedLvmThin managed LVM autogrow configuration preserved."
    else
        echo "WARNING: Existing local LVM autogrow policy detected."
        echo "SharedLvmThin did not overwrite administrator-owned LVM settings."
    fi
else
    [ -e "$LVMLOCAL" ] && cp -a "$LVMLOCAL" "$STATE_DIR/lvmlocal.conf.before-autogrow"
    cat >>"$LVMLOCAL" <<EOF

$LVM_BEGIN
activation {
    thin_pool_autoextend_threshold = 50
    thin_pool_autoextend_percent = 10
}
dmeventd {
    thin_command = "$MONITOR"
}
$LVM_END
EOF
    echo "Installed fail-closed SharedLvmThin dmeventd autogrow policy."
fi
fi

if [ "$MAINTENANCE_CONFIGURE" -eq 0 ]; then
    systemctl daemon-reload
else
    echo "Maintenance configure: systemd daemon-reload deferred."
fi

if [ "$PACKAGE_FLAVOR" = "thick-only" ]; then
    for FORBIDDEN_THIN_PATH in \
        /lib/systemd/system/pve-sharedlvmthin-thin-guard.service \
        /usr/libexec/pve-sharedlvmthin/pve-sharedlvmthin-monitor \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-guardd \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-guard-inventory \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-metadata-check \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-remote-thin-evidence \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-thin-import \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-package-maintenance-check \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-admission \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-plan \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-bridge-topology \
        /usr/libexec/pve-sharedlvmthin/sharedlvmthin-qmp-path-check \
        /usr/share/perl5/PVE/SharedLvmThinGuard.pm \
        /usr/share/perl5/PVE/SharedLvmThinGuardClient.pm \
        /usr/share/perl5/PVE/SharedLvmThinGuardEngine.pm \
        /usr/share/perl5/PVE/SharedLvmThinGuardInventory.pm \
        /usr/share/perl5/PVE/SharedLvmThinGuardProtocol.pm \
        /usr/share/perl5/PVE/SharedLvmThinGuardState.pm \
        /usr/share/perl5/PVE/SharedLvmThinMobility.pm \
        /usr/share/perl5/PVE/SharedLvmThinPeerAudit.pm \
        /usr/share/perl5/PVE/SharedLvmThinRelay.pm \
        /usr/share/perl5/PVE/SharedLvmThinWatchdog.pm \
        /usr/sbin/sharedlvmthin-migrate-bridge
    do
        if [ -e "$FORBIDDEN_THIN_PATH" ] || [ -L "$FORBIDDEN_THIN_PATH" ]; then
            echo "ERROR: Thick-only configuration refused: stale Thin component remains:" >&2
            echo "  $FORBIDDEN_THIN_PATH" >&2
            echo "Do not use this node until package ownership and profile replacement are repaired." >&2
            exit 1
        fi
    done
    if ! THIN_GUARD_STATE=$(systemctl show --property ActiveState --value \
        "$THIN_GUARD_SERVICE" 2>/dev/null); then
        echo "ERROR: Thick-only configuration refused: ThinGuard runtime state is unavailable." >&2
        exit 1
    fi
    case "$THIN_GUARD_STATE" in
        inactive|failed) ;;
        *)
            echo "ERROR: Thick-only configuration refused: ThinGuard remains '$THIN_GUARD_STATE'." >&2
            exit 1
            ;;
    esac
    if systemctl is-enabled --quiet "$THIN_GUARD_SERVICE"; then
        echo "ERROR: Thick-only configuration refused: ThinGuard remains enabled." >&2
        exit 1
    fi
fi

# Never restart an armed runtime guardian during a package transaction. Its
# in-memory epoch/watchdog bindings remain authoritative until every protected
# mapper has completed normal PVE teardown.
if [ "$MAINTENANCE_CONFIGURE" -eq 0 ] && [ "$PACKAGE_FLAVOR" = "dual" ] && \
   systemctl is-active --quiet "$THIN_GUARD_SERVICE"; then
    echo "Active ThinGuard preserved without restart during package upgrade."
    echo "Drain protected VMs, verify the guardian is IDLE, then restart $THIN_GUARD_SERVICE."
fi

# Long-running PVE workers cache the storage-plugin registry. Installing or
# upgrading the module on disk is not sufficient: an already-running HA LRM
# can otherwise reject the storage type during recovery even though CLI
# processes load it successfully. Refresh only consumers that are already
# active; never start a disabled service and never touch corosync/VMs.
PVE_REFRESH_OK=1
if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
    echo "Maintenance configure: PVE consumer refresh deferred."
else
for PVE_SERVICE in \
    pvedaemon.service \
    pvestatd.service \
    pveproxy.service \
    pve-ha-lrm.service
do
    if systemctl is-active --quiet "$PVE_SERVICE"; then
        if systemctl try-restart "$PVE_SERVICE"; then
            echo "Refreshed active PVE storage consumer: $PVE_SERVICE"
        else
            PVE_REFRESH_OK=0
            echo "WARNING: failed to refresh active PVE storage consumer: $PVE_SERVICE"
        fi
    fi
done
fi

# Existing web configuration is persistent and must never be overwritten.
if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
    echo "Maintenance configure: dashboard enable/start/configuration deferred."
elif [ -f "$CONF" ]; then
    echo "Existing web configuration detected."
    echo "Preserving $CONF"

    systemctl enable "$SERVICE" >/dev/null 2>&1 || true

    if systemctl restart "$SERVICE"; then
        echo "SharedLvmThin web dashboard started."
    else
        echo "WARNING: web dashboard failed to start."
        echo "Run: systemctl status $SERVICE"
    fi
else
    echo
    echo "SharedLvmThin Web Dashboard is not configured."

    #
    # Fresh interactive installation:
    # offer the configuration wizard automatically.
    #
    # Non-interactive package management must never block waiting
    # for user input. In that case only print the configure command.
    #
    if [ -t 0 ] && [ -t 1 ]; then
        echo
        printf "Configure Web Dashboard now? [Y/n]: "
        read -r ANSWER
        ANSWER="${ANSWER:-Y}"

        case "$ANSWER" in
            y|Y|yes|YES)
                echo
                /usr/sbin/sharedlvmthin-web-configure
                ;;
            *)
                echo
                echo "Web Dashboard configuration skipped."
                echo
                echo "Configure later with:"
                echo "  sharedlvmthin-web-configure"
                ;;
        esac
    else
        echo
        echo "Non-interactive installation detected."
        echo
        echo "The storage plugin files are installed. Operational status is"
        echo "determined by the compatibility health check below."
        echo "The optional Web Dashboard can be configured later with:"
        echo
        echo "  sharedlvmthin-web-configure"
    fi
fi

echo
echo "Running bounded SharedLvmThin installation preflight..."

# Debian's stock lvm2 initramfs hook recursively copies /etc/lvm. Large-scale
# lifecycle tests can leave thousands of host recovery archives there. They
# are useful on the running host but must never be embedded in an initramfs:
# decompression can otherwise exhaust early-boot memory before the real root
# filesystem is mounted. The packaged follow-up hook removes only staging
# copies. Rebuild existing initramfs images now so upgrading this package also
# protects the next reboot; a failed rebuild makes package configuration fail.
if command -v update-initramfs >/dev/null 2>&1 && command -v lsinitramfs >/dev/null 2>&1; then
    INITRAMFS_REBUILD=0
    for INITRD in /boot/initrd.img-*; do
        [ -f "$INITRD" ] || continue
        if lsinitramfs "$INITRD" 2>/dev/null \
            | grep -qE '^etc/lvm/(archive|backup)/'; then
            INITRAMFS_REBUILD=1
            break
        fi
    done

    if [ "$INITRAMFS_REBUILD" -eq 1 ]; then
        if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
            echo "ERROR: maintenance configure found host-only LVM recovery archives in initramfs." >&2
            echo "Prepare clean initramfs images before starting the package transaction." >&2
            exit 1
        else
            echo "Rebuilding initramfs images without host-only LVM recovery archives..."
            update-initramfs -u -k all
        fi
    else
        echo "Initramfs images contain no host-only LVM recovery archives; rebuild skipped."
    fi
fi

HEALTH_OK=0
if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
    echo "SharedLvmThin installation preflight: DEFERRED while operation hold is active."
    echo "This is not a PASS; finalize must run fresh Doctor and recovery checks."
else
set +e
timeout --foreground --kill-after=10 60 /usr/sbin/sharedlvmthin doctor --quick
DOCTOR_RC=$?
set -e
if [ "$DOCTOR_RC" -eq 0 ]; then
    HEALTH_OK=1
    echo "SharedLvmThin installation preflight passed."
elif [ "$DOCTOR_RC" -eq 1 ]; then
    HEALTH_OK=1
    echo "SharedLvmThin installation preflight passed with diagnostic warnings."
else
    echo "WARNING: SharedLvmThin installation preflight reported a problem."
    echo "SharedLvmThin is installed but must NOT be treated as operational."
    echo "Review the output above. The full Doctor was not run automatically."
fi
fi

echo
echo "SharedLvmThin installation complete."
if [ "$PACKAGE_FLAVOR" = "thick-only" ]; then
    echo "WARNING: THICK GENERATIONS IS EXPERIMENTAL."
else
    echo "WARNING: BOTH THIN AND THICK GENERATIONS ARE EXPERIMENTAL."
fi
echo "Use only disposable lab hosts, storage and guest data; no support or warranty is offered."
if [ "$HEALTH_OK" -eq 1 ] && [ "$PVE_REFRESH_OK" -eq 1 ]; then
    echo "Installation status: BOUNDED PREFLIGHT PASSED"
    echo "Run 'sharedlvmthin doctor' for the full per-volume and Thick anchor audit."
else
    echo "Operational status: NOT READY (installation preflight or PVE service refresh failed)"
fi

if [ "$MAINTENANCE_CONFIGURE" -eq 1 ]; then
    if ! "$MAINTENANCE_CHECK" \
        --phase CONFIG_COMMITTED \
        --package "${DPKG_MAINTSCRIPT_PACKAGE:-pve-sharedlvmthin}" \
        --version "$PACKAGE_VERSION" \
        --flavor "$PACKAGE_FLAVOR" \
        --artifact-sha256 "$PACKAGE_ARTIFACT" \
        --record-phase PACKAGE_CONFIGURED_DEFERRED; then
        echo "ERROR: deferred package configuration receipt was not recorded." >&2
        exit 1
    fi
    echo "OPERATIONAL_READY=NO"
    echo "PACKAGE_MAINTENANCE_HOLD=ACTIVE"
fi
echo
echo "CLI:"
echo "  sharedlvmthin doctor"
echo
echo "Update protection requires an explicit administrator choice before the"
echo "next watched PVE/storage-stack change. Unrelated package updates are not blocked."
echo "Recommended for shared SAN clusters:"
echo "  sharedlvmthin update-policy select freeze"
echo "Other explicit modes: qualified-auto or warn. Inspect with:"
echo "  sharedlvmthin update-policy status"
echo
echo "Web configuration:"
echo "  sharedlvmthin-web-configure"

if [ -f "$CONF" ]; then
    ADDRESS="$(sed -n 's/^address=//p' "$CONF" | head -1)"
    PORT="$(sed -n 's/^port=//p' "$CONF" | head -1)"

    if [ -n "$ADDRESS" ] && [ -n "$PORT" ]; then
        echo
        echo "Dashboard:"
        echo "  https://$ADDRESS:$PORT"
    fi
fi

exit 0
